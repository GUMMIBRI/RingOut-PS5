+                                     *verts[i][1]) for i in order))
+    recs = []
+    for k, m in enumerate(meshes):
+        if m['skin']:
+            recs.append(struct.pack('<10I', 4 | 0x10000, m['n'], node_at, mat_at + k * 0x50, idx[k], cbase, 0, 0, 0, 0))
