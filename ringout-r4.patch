+void emit_add_gated_pc_group(u32 pc, u32 group) {
+    if (pc != 0 && group < EMIT_GATE_GROUPS && s_gated_pc_count < 32) {
+        s_gated_groups[s_gated_pc_count] = group;
+        s_gated_pcs[s_gated_pc_count++] = pc;
