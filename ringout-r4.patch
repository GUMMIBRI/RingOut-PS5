+           pathlib.Path('C:/Users/gumbreezy/.codex/skills/ps5-build-package/scripts/brand_channel.py'),
+           llvm/'llvm-readelf.exe',llvm/'llvm-nm.exe',llvm/'llvm-objdump.exe',llvm/'llvm-ar.exe',
