+            vb = bytearray()
+            for v in m['vb']:
+                c = _c8(v['col']); vb += struct.pack('<6fI2f', *v['pos'], *v['nrm'], 0xff000000 | c << 16 | c << 8 | c, *v['uv']) + bytes(4)
