+      {
+        band[r * 4] = kHisWeaponScale * fore[r * 4];
+        band[r * 4 + 1] = kHisWeaponScale * (flip * fore[r * 4 + 1]);
+        band[r * 4 + 2] = kHisWeaponScale * (flip * fore[r * 4 + 2]);
+        band[r * 4 + 3] = std::fma(kBandAcross, fore[r * 4 + 1], std::fma(kBandAlong, fore[r * 4], fore[r * 4 + 3]));
+      }
