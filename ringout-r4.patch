+                                       if os.path.isfile(os.path.join(US_FILES, n))), DOL, release=self.rel)
+            self.assertEqual((m['sha1'], m['guests_sha1']), (self.man['sha1'], self.man['guests_sha1']))
+        finally:
+            for f in os.listdir(out): os.remove(os.path.join(out, f))
+            os.rmdir(out)
