+    return;
+  }
+  if (!open || DetectionInProgress())
+    return;
+  if (event.back)
+  {
+    OnEscape();
+    return;
+  }
+  constexpr std::array keys = {Key::Up, Key::Down, Key::Left, Key::Right, Key::Activate};
+  for (std::size_t i = 0; i < keys.size(); ++i)
+    if (event.navigation & (1u << i)) OnKey(keys[i]);
