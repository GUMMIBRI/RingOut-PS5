index 00000000..68cbfa78
--- /dev/null
+++ b/ModernGekko/ps5/check-copy-dispatch.py
@@ -0,0 +1,90 @@
+"""Check the linked RADV providers used by Mesa's legacy copy wrappers.
+
+This only inspects linked symbols and dispatch-table relocations. It does not
+call Vulkan, inspect a PS5 device, or establish that a game has booted.
+"""
+import argparse
+import hashlib
+import json
+import re
+import subprocess
+from pathlib import Path
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--elf', required=True, type=Path)
+parser.add_argument('--nm', required=True)
+parser.add_argument('--readelf', required=True)
+parser.add_argument('--ar', required=True)
+parser.add_argument('--archive', required=True, type=Path)
+parser.add_argument('--output', required=True, type=Path)
+args = parser.parse_args()
+
+functions = ('CmdCopyBuffer2', 'CmdCopyImage2', 'CmdCopyBufferToImage2',
+             'CmdCopyImageToBuffer2', 'CmdBlitImage2', 'CmdResolveImage2')
+# Extract the entrypoint-table object from the exact linked RADV archive.
+# Its named relocations give each provider's actual table slot, so a provider
+# merely appearing somewhere else in the table cannot satisfy the check.
+member = 'meson-generated_.._radv_entrypoints.c.o'
+names = subprocess.check_output([args.ar, 't', str(args.archive)], text=True).splitlines()
+if names.count(member) != 1:
+    raise SystemExit('expected exactly one RADV entrypoint-table member')
+raw_object = subprocess.check_output([args.ar, 'p', str(args.archive), member])
+object_path = args.output.with_suffix('.radv-entrypoints.o')
+with object_path.open('xb') as stream:
+    stream.write(raw_object)
+object_symbols = subprocess.check_output([args.nm, '-S', '--defined-only', str(object_path)], text=True)
+table_rows = [line.split() for line in object_symbols.splitlines()
+              if line.split()[-1:] == ['radv_device_entrypoints']]
+if len(table_rows) != 1 or int(table_rows[0][0], 16) != 0:
+    raise SystemExit('unexpected source RADV entrypoint table layout')
+object_relocations = subprocess.check_output([args.readelf, '-r', str(object_path)], text=True)
+section = ''
+source_offsets = {}
+for line in object_relocations.splitlines():
+    if line.startswith('Relocation section'):
+        section = line
+    if "'.rela.data.rel.ro.radv_device_entrypoints'" not in section:
+        continue
+    match = re.match(r'^\s*([0-9a-fA-F]+)\s+\S+\s+R_X86_64_64\s+\S+\s+(radv_\w+)\s+\+\s+0\s*$', line)
+    if match:
+        source_offsets[match.group(2)] = int(match.group(1), 16)
+symbols = {}
+raw = subprocess.check_output([args.nm, '-S', '--defined-only', str(args.elf)], text=True)
+for line in raw.splitlines():
+    fields = line.split()
+    if len(fields) >= 4 and fields[-2] not in ('U', 'u', 'w', 'v'):
+        symbols[fields[-1]] = (int(fields[0], 16), int(fields[1], 16))
+table = symbols.get('radv_device_entrypoints')
+if not table:
+    raise SystemExit('missing radv_device_entrypoints symbol')
+relocations = []
+raw = subprocess.check_output([args.readelf, '-r', str(args.elf)], text=True)
+for line in raw.splitlines():
+    match = re.match(r'^\s*([0-9a-fA-F]+)\s+\S+\s+R_X86_64_RELATIVE\s+([0-9a-fA-F]+)\s*$', line)
+    if match:
+        relocations.append((int(match.group(1), 16), int(match.group(2), 16)))
+rows = []
+for function in functions:
+    provider = 'radv_' + function
+    target = symbols.get(provider)
+    relative_offset = source_offsets.get(provider)
+    if relative_offset is None or relative_offset >= table[1]:
+        raise SystemExit('source entrypoint-table offset missing or outside table: ' + provider)
+    expected_offset = table[0] + relative_offset
+    offsets = [] if target is None else [hex(offset) for offset, addend in relocations
+        if offset == expected_offset and addend == target[0]]
+    rows.append({'function': function, 'provider': provider, 'defined': target is not None,
+                 'source_table_offset': hex(relative_offset), 'table_relocations': offsets})
+missing = [row['provider'] for row in rows if not row['defined'] or not row['table_relocations']]
+with args.elf.open('rb') as stream:
+    digest = hashlib.file_digest(stream, 'sha256').hexdigest()
+with args.archive.open('rb') as stream:
+    archive_sha256 = hashlib.file_digest(stream, 'sha256').hexdigest()
+result = {'status': 'FAIL' if missing else 'PASS', 'elf_sha256': digest,
+          'archive_sha256': archive_sha256, 'entrypoint_member': member,
+          'entrypoint_member_sha256': hashlib.sha256(raw_object).hexdigest(),
+          'missing': missing, 'functions': rows,
+          'scope': 'Exact static RADV entrypoint-table slots from archive relocations; not runtime dispatch or GPU proof.'}
+args.output.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+print(json.dumps({'status': result['status'], 'missing': missing}))
+raise SystemExit(bool(missing))
diff --git a/ModernGekko/ps5/check-guest-roster.py b/ModernGekko/ps5/check-guest-roster.py
