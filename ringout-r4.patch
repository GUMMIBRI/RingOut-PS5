+"""Pinned local native recipe. Reuses the recorded GRSEAF/Dolphin archives.
+
+Does not transfer, launch, or claim a hardware-tested build. Source revisions,
+commands, tool hashes, inputs and ELF/SELF pairing are retained with each run.
+"""
+import argparse
+import ctypes
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--stage', required=True)
+parser.add_argument('--build-id', required=True)
+parser.add_argument('--host-build', help='fresh source-matched CMake host build, with BUILD-ATTESTATION.json')
+parser.add_argument('--guest-host-build', help='take the guest game module from a compatible attested host')
+parser.add_argument('--include-ps5-menu', action='store_true',
+                    help='rebuild the PS5 host loop with the menu lifecycle integration')
+parser.add_argument('--trace-boot', action='store_true', help='rebuild Dolphin boot phase tracers')
+parser.add_argument('--trace-vulkan', action='store_true', help='record Vulkan device setup failures')
+parser.add_argument('--managed-worker-stack', action='store_true',
+                    help='rebuild the PS5 Vulkan shader worker with a platform-managed stack')
+parser.add_argument('--use-title-heap', action='store_true', help='use PS5 platform direct-memory title heap')
+args = parser.parse_args()
+if args.guest_host_build and not args.host_build:
+    parser.error('--guest-host-build requires --host-build')
+if args.managed_worker_stack and (not args.host_build or not args.trace_vulkan or not args.trace_boot):
+    parser.error('--managed-worker-stack requires the attested host build, --trace-vulkan and --trace-boot')
+if not args.build_id or any(c not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._' for c in args.build_id):
+    parser.error('--build-id must contain only letters, digits, dash, dot or underscore')
+workspace = Path(__file__).resolve().parents[3]
+source = Path(__file__).resolve().parent
+source_root = source.parents[1]
+revision = subprocess.run(['git', '-C', str(source_root), 'rev-parse', 'HEAD'],
+                          capture_output=True, text=True)
+if revision.returncode:
+    parser.error('cannot identify source revision')
+work = workspace / 'aot-work/ps5-aot-grseaf-r1'
+host_build = Path(args.host_build).resolve() if args.host_build else work / 'host-build-sdk'
+game_module = work / 'build/gGRSEAF_recomp.a'
+external_game_module = False
+guest_attestation_path = None
+if args.host_build:
+    attestation_path = host_build / 'BUILD-ATTESTATION.json'
+    if not attestation_path.is_file():
+        parser.error('fresh host build requires BUILD-ATTESTATION.json')
+    attestation = json.loads(attestation_path.read_text())
+    external_game_module = attestation.get('external_game_module') is True
+    base_revision = attestation.get('source_revision', '')
+    if (attestation.get('status') != 'success' or
+        Path(attestation.get('source_root', '')).resolve() != source_root.resolve() or
+        hashlib.sha256((host_build / 'build.ninja').read_bytes()).hexdigest() != attestation.get('build_ninja_sha256')):
+        parser.error('host build attestation does not match source and CMake build')
+    if base_revision != revision.stdout.strip():
+        # Stage replacements for the listed sources. The two new headers are
+        # consumed only by freshly compiled objects. Shared host headers stay pinned.
+        ancestry = subprocess.run(['git', '-C', str(source_root), 'merge-base', '--is-ancestor',
+                                   base_revision, revision.stdout.strip()])
+        diff = subprocess.run(['git', '-C', str(source_root), 'diff', '--name-only',
+                               base_revision, revision.stdout.strip()], capture_output=True, text=True)
+        # This target definition is mirrored below for the retained host.
+        # A different CMake change requires freshly built host archives.
+        cmake_path = 'ModernGekko/CMakeLists.txt'
+        if cmake_path in diff.stdout.splitlines():
+            base_cmake = subprocess.check_output(
+                ['git', '-C', source_root, 'show', f'{base_revision}:{cmake_path}'], text=True)
+            current_cmake = (source_root / cmake_path).read_text()
+            menu_definition = '        target_compile_definitions(videocommon PRIVATE RINGOUT_PS5_MENU=1)\n'
+            if current_cmake.count(menu_definition) != 1 or current_cmake.replace(menu_definition, '') != base_cmake:
+                parser.error('host CMake change requires rebuilding the host archives')
+            args.include_ps5_menu = True
+        allowed = {'ModernGekko/ps5/build-native.py', 'ModernGekko/ps5/build-package.py',
+                   cmake_path,
+                   'ModernGekko/ps5/main.cpp', 'ModernGekko/ps5/gamepad_profile.h',
+                   'ModernGekko/ps5/check-guest-roster.py', 'ModernGekko/ps5/guest_package.py',
+                   'ModernGekko/ps5/test_guest_package.py',
+                   'ModernGekko/ps5/qualify-native-package.py',
+                   'ModernGekko/ps5/test_build_package_plan.py',
+                   'ModernGekko/ps5/check-vulkan-dispatch.py',
+                   'ModernGekko/ps5/check-copy-dispatch.py',
+                   'ModernGekko/src/runtime/dolphin_runtime.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/Common/MemoryUtil.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/InputCommon/ControllerInterface/SDL/SDL.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/Core/Core.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/Core/HW/GCPad.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/Core/HW/GCPadConfigEvent.h',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/Present.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompMenu.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompMenu.h',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompMods.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompPS5MenuInput.h',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/HiresTextures.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/Assets/CustomAssetCache.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/TextureCacheBase.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/AsyncShaderCompiler.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoBackends/Vulkan/VKMain.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoBackends/Vulkan/ShaderCompiler.cpp',
+                   'ModernGekko/vendor/dolphin/Source/Core/VideoBackends/Vulkan/VulkanLoader.cpp'}
+        if not args.trace_vulkan or ancestry.returncode or diff.returncode or not set(diff.stdout.splitlines()) <= allowed:
+            parser.error('host archives do not match source; rebuild them before producing a candidate')
+        if ('ModernGekko/vendor/dolphin/Source/Core/VideoCommon/AsyncShaderCompiler.cpp' in diff.stdout.splitlines()
+                and not args.managed_worker_stack):
+            parser.error('changed shader worker requires --managed-worker-stack')
+        if ('ModernGekko/vendor/dolphin/Source/Core/Core/Core.cpp' in diff.stdout.splitlines()
+                and not args.trace_boot):
+            parser.error('changed Core.cpp requires --trace-boot')
+        staged_video_units = {'Present.cpp', 'HiresTextures.cpp', 'TextureCacheBase.cpp',
+                              'Assets/CustomAssetCache.cpp'}
+        if not args.managed_worker_stack and any(
+                f'ModernGekko/vendor/dolphin/Source/Core/VideoCommon/{unit}' in diff.stdout.splitlines()
+                for unit in staged_video_units):
+            parser.error('changed VideoCommon sources require the staged VideoCommon archive')
+    dirty = subprocess.run(['git', '-C', str(source_root), 'status', '--porcelain', '--untracked-files=no'],
+                           capture_output=True, text=True)
+    if dirty.returncode or dirty.stdout.strip():
+        parser.error('fresh host build requires a clean tracked source checkout')
+    if external_game_module and (args.guest_host_build or attestation.get('game_module') is not None):
+        parser.error('external-module host must not link any game archive')
+    module_attestation = attestation
+    if args.guest_host_build:
+        guest_host = Path(args.guest_host_build).resolve()
+        guest_attestation_path = guest_host / 'BUILD-ATTESTATION.json'
+        module_attestation = json.loads(guest_attestation_path.read_text())
+        if (module_attestation.get('status') != 'success' or
+                Path(module_attestation.get('source_root', '')).resolve() != source_root.resolve() or
+                hashlib.sha256((guest_host / 'build.ninja').read_bytes()).hexdigest()
+                != module_attestation.get('build_ninja_sha256')):
+            parser.error('guest module attestation does not match its CMake host')
+        # The game module needs this host ABI and its guest hooks. Keep the
+        # active host's renderer, input and platform libraries in the final link.
+        for key in ('libmoderngekko.a', 'vendor/dolphin/Source/Core/Core/libcore.a'):
+            expected = attestation.get('archives', {}).get(key)
+            if not expected or module_attestation.get('archives', {}).get(key) != expected:
+                parser.error('guest module host differs from the active runtime or core: ' + key)
+    if external_game_module:
+        game_module = None
+    else:
+        module_record = module_attestation.get('game_module') or {}
+        game_module = Path(module_record.get('path', '')).resolve()
+        if not game_module.is_file():
+            parser.error('attested game module is missing')
+        with game_module.open('rb') as stream:
+            if hashlib.file_digest(stream, 'sha256').hexdigest() != module_record.get('sha256'):
+                parser.error('attested game module hash differs')
+    archives = attestation.get('archives', {})
+    if not archives:
+        parser.error('fresh host build attestation has no archive hashes')
+    for relative, expected in archives.items():
+        path = (host_build / relative).resolve()
+        if not path.is_relative_to(host_build) or not path.is_file():
+            parser.error('fresh host build archive mismatch: ' + relative)
+        with path.open('rb') as stream:
+            if hashlib.file_digest(stream, 'sha256').hexdigest() != expected:
+                parser.error('fresh host build archive mismatch: ' + relative)
+else:
+    if source != (workspace / 'source/ModernGekko/ps5').resolve():
+        parser.error('this pinned recipe uses a different source checkout and old host archives; configure and rebuild for this checkout first')
+    if revision.stdout.strip() != '9339899231d9cf90282c7b4c17eb1cf0c3c4e14c':
+        parser.error('host archives are pinned to the older source revision; rebuild them before producing a candidate')
+# Preserve a mapped drive: the pinned converter cannot write UNC output paths.
+stage = Path(args.stage).absolute()
+if str(stage).startswith('\\\\'):
+    parser.error('use a local or mapped-drive stage path, not UNC')
+if stage.exists() and any(stage.iterdir()):
+    parser.error('--stage must be new or empty; finalized candidates are immutable')
+stage.mkdir(parents=True, exist_ok=True)
+platform = Path('C:/.pe/ps5-native/gpu-platform-20261030')
+sdk = platform / 'deps/ps5-payload-sdk'
+llvm = platform / 'deps/llvm/bin'
+converter = platform / 'native-candidates/tool/ps5-native-tool.exe'
+commands = []
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+def record(path):
+    return {'path': str(path), 'sha256': sha(path), 'bytes': Path(path).stat().st_size}
+def run(argv, cwd=stage):
+    argv = [str(x) for x in argv]
+    result = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
+    commands.append({'argv': argv, 'cwd': str(cwd), 'exit_code': result.returncode,
+                     'stdout': result.stdout, 'stderr': result.stderr})
+    (stage / 'commands.json').write_text(json.dumps(commands, indent=2))
+    if result.returncode:
+        raise RuntimeError(result.stderr or result.stdout)
+    return result.stdout
+
+common = ['--target=x86_64-unknown-freebsd12', '-isysroot', sdk,
+          '-isystem', sdk / 'target/include', '-isystem', sdk / 'target/include_common',
+          '-fPIC', '-O2', '-femulated-tls', '-fno-stack-protector', '-Wall', '-Wextra', '-Werror',
+          '-DRINGOUT_BUILD_ID="' + args.build_id + '"']
+cpp = ['-nostdinc++', '-isystem', sdk / 'target/include/c++/v1', '-std=gnu++23',
+       '-fexperimental-library', '-I', source.parent / 'include']
+inputs = []
+for name in ['app_crt.cpp', 'main.cpp', 'native_startup_log.c', 'posix_filesystem.c']:
+    item = source / name
+    inputs.append(record(item))
+    flags = cpp + common if item.suffix == '.cpp' else common
+    if name == 'native_startup_log.c': flags = flags + ['-fno-builtin']
+    if name == 'main.cpp' and external_game_module:
+        flags = flags + ['-DRINGOUT_PS5_EXTERNAL_MODULE=1']
+    run([llvm / ('clang++.exe' if item.suffix == '.cpp' else 'clang.exe'),
+         *flags, '-c', item, '-o', stage / (name + '.o')])
+for name in ['native_startup.h', 'startup_log.h', 'gamepad_profile.h', 'build-native.py']:
+    inputs.append(record(source / name))
+inputs.append(record(source.parent / 'vendor/dolphin/Source/Core/Core/HW/GCPadConfigEvent.h'))
+
+# Rebuild the changed runtime members with their exact existing CMake recipe.
+# Work on a staged archive so frozen candidates and the original host build
+# remain reproducible. Recompiling only ps5/main.cpp misses game.cpp fixes.
+ninja = sdk / 'win/ninja.exe'
+def windows_argv(command):
+    shell32 = ctypes.WinDLL('shell32', use_last_error=True)
+    split = shell32.CommandLineToArgvW
+    split.argtypes = [ctypes.c_wchar_p, ctypes.POINTER(ctypes.c_int)]
+    split.restype = ctypes.POINTER(ctypes.c_wchar_p)
+    count = ctypes.c_int()
+    result = split(command, ctypes.byref(count))
+    if not result:
+        raise ctypes.WinError(ctypes.get_last_error())
+    try:
