+  if (open && Core::GetState(Core::System::GetInstance()) == Core::State::Paused)
+    g_controller_interface.UpdateInput();
+  std::array<bool, 9> down{};
+  for (std::size_t i = 0; i < inputs.size(); ++i)
+    down[i] = inputs[i] && inputs[i]->GetState() > 0.5;
+  const auto event = edges.Sample(down);
+  if (close_when_released)
+  {
+    if (std::ranges::none_of(down, [](bool value) { return value; }))
+    {
+      close_when_released = false;
+      if (IsOpen()) Toggle();
+    }
+    return;
+  }
+  if (event.chord && !DetectionInProgress())
+  {
+    if (open)
+      close_when_released = true;
+    else
