+            build_spawn.build('unused', src, out, 'unused', 'unused', check_gc=False, block_fn=boom,
+                              tables_fn=lambda: {}, scenes_fn=lambda: {})
+        self.assertEqual(os.listdir(out), [])
+
+    def test_wrong_gc_disc_refused(self):
