+"""GuestData: what a disc's pipeline hands the builder for one guest character."""
+from dataclasses import dataclass, field
+from typing import Callable
+
+
+@dataclass
+class GuestData:
+    id: int                          # the character ID on GC: 29 Spawn, 28 Heihachi
+    cell: int                        # his select cell
+    name: str                        # for messages
+    block: dict                      # slot in his 39-record block -> GC entry
+    scenes: dict                     # group 4 record -> GC entry (his home-stage scene)
+    ending_art: bytes                # group 2 record 57 + id
+    faces: list                      # items as ui.append_textures takes them, one per costume
+    silhouettes: list                # the same
+    camera: Callable[[bytes], bytes]  # GC profile-camera entry -> the entry with his slots filled
+    tables: dict                     # his manifest rows; the builder fills the cell's faces and silhouettes
+    pool_lists: list = field(default_factory=list)  # the other disc's ID lists, which place him beside Link
+    sources: dict = field(default_factory=dict)     # release and source hashes, for "already built"
diff --git a/tools/guests/olk.py b/tools/guests/olk.py
new file mode 100644
index 00000000..81696206
--- /dev/null
+++ b/tools/guests/olk.py
@@ -0,0 +1,28 @@
+import struct
+import os
+# Xbox and GC root.olk, from the environment (never committed: they are the user's discs).
+X = os.environ.get("RINGOUT_SPAWN_XBOX", "")
+G = os.environ.get("RINGOUT_SPAWN_GC", "")
+class Olk:
+    def __init__(s,src):
+        """`src`: a path, or an xiso.FileView into a disc image."""
+        s.f=open(src,'rb') if isinstance(src,(str,bytes,os.PathLike)) else src.open(); s.top=s._dir(0)
+    def _dir(s,at):
+        s.f.seek(at); h=s.f.read(0x20); cnt,mag=struct.unpack('<I4s',h[:8]); hs=struct.unpack('<I',h[0x10:0x14])[0]
+        assert mag==b'olnk'
+        ents=[struct.unpack('<IIII',s.f.read(16)) for _ in range(cnt)]
+        return at+hs,ents
+    def group(s,g):
+        base,ents=s.top; o,sz,_,_=ents[g]; return s._dir(base+o)
+    def entry(s,g,i):
+        base,ents=s.group(g); o,sz,_,_=ents[i]
+        if not sz: return b''
+        s.f.seek(base+o); return s.f.read(sz)
+def pack(b,be):
+    """numbered pack: u32 count, u32 offsets[count+1]"""
+    e='>' if be else '<'
+    n=struct.unpack(e+'I',b[:4])[0]
+    if n==0 or n>4096 or 4+4*(n+1)>len(b): return None
+    offs=struct.unpack(e+'%dI'%(n+1),b[4:8+4*n])
+    if any(offs[i]>offs[i+1] for i in range(n)) or offs[-1]>len(b): return None
+    return [b[offs[i]:offs[i+1]] for i in range(n)]
