+
 NEED_GLIBC=2.36
 host_glibc="$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | tail -1)"
 LOADER="$HERE/libc-fallback/ld-linux-x86-64.so.2"
@@ -316,8 +353,10 @@ if [ -n "$host_glibc" ] && [ -x "$LOADER" ] && \
     # $LIB_PATH, not $HERE/lib: on this path the bundled glibc genuinely has to
     # win, but the rest of the bundle should still defer to the host for
     # anything the host already has, for the Mesa reason above.
-    exec "$LOADER" --library-path "$HERE/libc-fallback:$LIB_PATH:$LD_LIBRARY_PATH:/usr/lib:/usr/lib64:/lib:/lib64" \
+    run_with_layer_retry "$LOADER" --library-path "$HERE/libc-fallback:$LIB_PATH:$LD_LIBRARY_PATH:/usr/lib:/usr/lib64:/lib:/lib64" \
         "$HERE/bin/moderngekko-run" --user-dir "$USER_DIR" "${GAME_ARGS[@]}" "$@"
+    exit $?
 fi
 
-exec "$HERE/bin/moderngekko-run" --user-dir "$USER_DIR" "${GAME_ARGS[@]}" "$@"
+run_with_layer_retry "$HERE/bin/moderngekko-run" --user-dir "$USER_DIR" "${GAME_ARGS[@]}" "$@"
