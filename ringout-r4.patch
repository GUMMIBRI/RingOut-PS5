--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/VideoCommon/RecompPS5MenuInput.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+namespace RecompMenu {
+// Samples must all belong to one resolved device. No SDL ownership or pumping.
+struct PS5MenuEdges {
+  std::array<bool, 9> previous{};
+  bool initialized = false;
+  void Reset() { initialized = false; }
+  struct Result { bool chord = false; unsigned navigation = 0; bool back = false; };
+  Result Sample(const std::array<bool, 9>& now) {
+    Result result;
+    if (initialized) {
+      result.chord = now[0] && now[1] && !(previous[0] && previous[1]);
+      for (std::size_t i = 2; i < 7; ++i)
+        if (now[i] && !previous[i]) result.navigation |= 1u << (i - 2);
+      // Circle acts on release, so its closing press cannot leak into guest B.
+      result.back = !now[7] && previous[7];
+    }
+    previous = now;
+    initialized = true;
+    return result;
+  }
+};
+}
