+inline Installed InstalledFrom(const RecompGuestCore::Manifest& m)
+{
+  Installed in;
+  for (const auto& t : m.guests)
+    (t.id == kSpawnId ? in.spawn : in.heihachi) = true;
+  return in;
+}
