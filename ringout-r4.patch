+        self.assertAlmostEqual(rec[1], -0.1711, places=3)
+        self.assertAlmostEqual(rec[6], 0.1604, places=3)
+        self.assertEqual(self.g.read(tables.PREVIEW_HOME, 28), bytes(28))   # empty row 7
