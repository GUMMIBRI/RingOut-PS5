diff --git a/.github/scripts/spawn-id-scan.py b/.github/scripts/spawn-id-scan.py
new file mode 100644
index 00000000..33dd09ec
--- /dev/null
+++ b/.github/scripts/spawn-id-scan.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""List per-character code sites in a GameCube DOL: places that compare a character ID against Link's
+(27) or the empty IDs (28, 29), and jump tables bounded at 27..35 entries, near a load of a
+character-ID field. These are the decisions a new character 29 can fall through (tools/spawn/MAP.md,
+"Per-character code sites").
+
+    spawn-id-scan.py <main.dol> [--all]      ->  lines "pc kind value anchor"
+
+An anchor is the nearest load, at most WINDOW instructions earlier, of a halfword/byte/word at one of
+the ID fields (player struct +0x58/+0x5A/+0x5C, select default +0x90, descriptor model IDs
++0x82/+0x86/+0x88). --all also lists compares with no anchor (IDs often arrive in a register)."""
+import struct, sys
+from collections import namedtuple
+
+ID_VALUES = (27, 28, 29)
+ID_FIELDS = (0x58, 0x5A, 0x5C, 0x82, 0x86, 0x88, 0x90)
+LOAD_OPS = (32, 34, 40, 42)          # lwz, lbz, lhz, lha
+WINDOW = 32
+BCTR = 0x4E800420
+
+Site = namedtuple('Site', 'pc kind value anchor')
+
+
+def text_words(path):
+    with open(path, 'rb') as f: d = f.read()
+    off, addr, size = (struct.unpack_from('>7I', d, o) for o in (0x00, 0x48, 0x90))
+    for o, a, s in zip(off, addr, size):
+        if s:
+            yield a, struct.unpack_from('>%dI' % (s // 4), d, o)
+
+
+def scan(path, all_sites=False):
+    sites = []
+    for base, w in text_words(path):
+        for i, x in enumerate(w):
+            op, imm = x >> 26, x & 0xffff
+            if op not in (10, 11):                      # cmplwi, cmpwi
+                continue
+            ra = (x >> 16) & 31
+            kind = None
+            if op == 10 and 26 <= imm <= 34 and BCTR in w[i + 1:i + 13]:
+                kind, value = 'switch', imm + 1
+            elif imm in ID_VALUES:
+                kind, value = 'cmp', imm
+            if kind is None:
+                continue
+            anchor = None
+            for j in range(i - 1, max(-1, i - 1 - WINDOW), -1):
+                y = w[j]
+                if y >> 26 in LOAD_OPS and (y >> 21) & 31 == ra and (y & 0xffff) in ID_FIELDS:
+                    anchor = base + 4 * j; break
+            if anchor is not None or all_sites:
+                sites.append(Site(base + 4 * i, kind, value, anchor))
+    return sites
+
+
+if __name__ == '__main__':
+    if len(sys.argv) < 2:
+        sys.exit(__doc__)
+    for s in scan(sys.argv[1], '--all' in sys.argv[2:]):
+        print('%08X %s %d %s' % (s.pc, s.kind, s.value, '%08X' % s.anchor if s.anchor else '-'))
diff --git a/.github/scripts/spawn-route.sh b/.github/scripts/spawn-route.sh
new file mode 100755
index 00000000..b1916d51
--- /dev/null
+++ b/.github/scripts/spawn-route.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+# Frame-keyed routes that pick Spawn (ID 29) from his own select cell, the free end of Link's row
+# (tools/spawn/MAP.md, "Select grid"). Built on vs-stage-route.py's VS route (stage 1), which puts the
+# cursors on Talim (1P) and Raphael (2P) and confirms at 1P frame 4000 and 2P frame 4400.
+#
+#     spawn-route.sh select [p1|p2|both]   VS route; the named side(s) move onto his cell and confirm him
+#     spawn-route.sh arcade                arcade-final.txt with the stick held neutral from the first fight
+#                                          (frame 4500): his moves under the cycle's steps ring him out. Run
+#                                          it as Spawn (RINGOUT_SPAWN_FORCE_ID=29) with the route's two cheat
+#                                          codes plus P2's health held at 0 (AR "0436FACC 00000000", the
+#                                          float at P2 object 0x8036E560 + 0x156C; MAP.md) so every first hit
+#                                          is a KO: the run then reaches the ending
+#     spawn-route.sh nav                   both cursors tour his cell and stop on the select screen:
+#                                          1P Talim -> Mitsurugi -> Spawn -> Taki -> Spawn -> Mitsurugi -> Spawn,
+#                                          2P Raphael -> Taki -> Spawn -> Mitsurugi -> Spawn -> Taki -> Spawn,
+#                                          then DOWN and UP (no cell above or below his: stays on him)
+#
+# Moves: from Talim, UP reaches Mitsurugi and LEFT wraps onto his cell; from Raphael, UP reaches Taki and
+# RIGHT reaches his cell. The route is printed to stdout. Needs the per-port input runtime ("P2" lines).
+set -eu
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+mode="${1:-}"; side="${2:-both}"
+case "$side" in p1|p2|both) ;; *) echo "spawn-route.sh: side is p1, p2 or both" >&2; exit 2;; esac
+
+vs() { python3 "$HERE/vs-stage-route.py" 1 | grep -v '^#'; }
+press() { echo "$1 $2 $3"; echo "$1 $(( $2 + 6 )) -"; }   # port frame button: press for 6 frames
+
+case "$mode" in
+  select)
+    echo "# spawn-route.sh select $side: VS stage 1, Spawn picked from his cell by: $side"
+    {
+      vs
+      case "$side" in p1|both) press P1 3500 UP; press P1 3620 LEFT;; esac
+      case "$side" in p2|both) press P2 3500 UP; press P2 3620 RIGHT;; esac
+    } | sort -s -k2,2n
+    ;;
+  arcade)
+    echo "# spawn-route.sh arcade: arcade-final.txt, stick neutral from frame 4500 (needs AR 0436FACC 00000000)"
+    grep -v '^#' "$HERE/../input-scripts/arcade-final.txt" | awk 'NF >= 4 && $1 >= 4500 { $3 = 128; $4 = 128 } { print }'
+    ;;
+  nav)
+    echo "# spawn-route.sh nav: both cursors tour Spawn's cell (frames 3500-3980), then stay on the select screen"
+    {
+      vs | awk '$2 < 4000'
+      f=3500
+      for k in 0 1 2 3 4 5 6 7; do
+        p1=(UP LEFT LEFT RIGHT RIGHT LEFT DOWN UP); p2=(UP RIGHT RIGHT LEFT LEFT RIGHT DOWN UP)
+        press P1 $f ${p1[$k]}; press P2 $f ${p2[$k]}; f=$(( f + 60 ))
+      done
+    } | sort -s -k2,2n
+    ;;
+  *) sed -n '2,19p' "$0" >&2; exit 2;;
+esac
diff --git a/.github/scripts/tests/test_privacy_spawn.sh b/.github/scripts/tests/test_privacy_spawn.sh
new file mode 100644
index 00000000..46576abc
--- /dev/null
+++ b/.github/scripts/tests/test_privacy_spawn.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# The privacy scan refuses Spawn's converted data wherever it lands in a stage, and passes the converter
+# that ships (tools/spawn and tools/guests, *.py and dspenc.c, without tests).
+#
+#   bash .github/scripts/tests/test_privacy_spawn.sh
+set -u
+REPO="$(cd "$(dirname "$0")/../../.." && pwd)"
+SCAN="$REPO/.github/scripts/privacy-scan.sh"
+fail=0
+check() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1: want '$2', got '$3'"; fail=1; fi; }
+T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
+stage() { rm -rf "$T/s"; mkdir -p "$T/s/tools/spawn" "$T/s/tools/guests" "$T/s/tools/heihachi"; cp "$REPO"/tools/spawn/*.py "$T/s/tools/spawn/"; cp "$REPO"/tools/heihachi/*.py "$T/s/tools/heihachi/"; cp "$REPO"/tools/guests/*.py "$REPO"/tools/guests/dspenc.c "$T/s/tools/guests/"; }
+
+stage; bash "$SCAN" "$T/s" >/dev/null 2>&1; check "the shipped converter passes" 0 $?
+stage; : > "$T/s/root-spawn.olk"; bash "$SCAN" "$T/s" >/dev/null 2>&1; check "root-spawn.olk refused" 1 $?
+stage; : > "$T/s/tools/root-spawn.json"; bash "$SCAN" "$T/s" >/dev/null 2>&1; check "root-spawn.json refused" 1 $?
+stage; mkdir -p "$T/s/x/spawn.new"; bash "$SCAN" "$T/s" >/dev/null 2>&1; check "a half-built spawn.new refused" 1 $?
+stage; : > "$T/s/root-guests.olk"; bash "$SCAN" "$T/s" >/dev/null 2>&1; check "root-guests.olk refused" 1 $?
+stage; : > "$T/s/tools/guests.json"; bash "$SCAN" "$T/s" >/dev/null 2>&1; check "guests.json refused" 1 $?
+stage; mkdir -p "$T/s/x/guests.new"; bash "$SCAN" "$T/s" >/dev/null 2>&1; check "a half-built guests.new refused" 1 $?
+exit $fail
