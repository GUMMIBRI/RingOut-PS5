index 00000000..a133f741
--- /dev/null
+++ b/tools/guests/olkw.py
@@ -0,0 +1,60 @@
+"""Rewrite a root.olk with some entries of one group replaced and/or appended (streams to disk)."""
+import os, struct
+from olk import Olk
+def write(src_path, out_path, group, repl, append=()):
+    """Write `out_path`: `src_path` with group `group`'s entries `repl` (index -> bytes) replaced and
+    `append` added after its last record. A group header without room for the appended records grows to
+    the next 0x800 boundary, as the discs round theirs; a header with room stays as it is. Written to a
+    temporary file and renamed, so a failed write never leaves a partial archive at `out_path`."""
+    src = Olk(src_path); base, tops = src.top
+    f = src.f
+    tmp = out_path + '.tmp'
+    try:
+        _write(src, tmp, group, repl, list(append))
+        os.replace(tmp, out_path)
+    except BaseException:
+        if os.path.exists(tmp): os.remove(tmp)
+        raise
+
+
+def _write(src, out_path, group, repl, append):
+    base, tops = src.top
+    f = src.f
+    def read_raw(at, n): f.seek(at); return f.read(n)
+    with open(out_path, 'wb') as out:
+        # top directory: same header, entries rewritten
+        f.seek(0); hdr = bytearray(f.read(0x20)); hs = struct.unpack_from('<I', hdr, 0x10)[0]
+        out.write(bytes(hs))  # placeholder
+        new_tops = []; cur = 0  # offsets relative to data base (hs)
+        for gi, (o, sz, t, z) in enumerate(tops):
+            if gi != group or not sz:
+                out.seek(hs + cur)
+                # copy group bytes as they are
+                rem = sz; at = base + o
+                while rem:
+                    n = min(rem, 1 << 24); out.write(read_raw(at, n)); at += n; rem -= n
+                new_tops.append((cur, sz, t, z)); cur += sz; tlast = cur; cur += (-cur) % 0x800; continue
+            gbase, ents = src._dir(base + o)
+            f.seek(base + o); ghdr = bytearray(f.read(0x20)); ghs = struct.unpack_from('<I', ghdr, 0x10)[0]
+            ghs = max(ghs, (0x20 + 16 * (len(ents) + len(append)) + 0x7ff) & ~0x7ff)
+            struct.pack_into('<I', ghdr, 0x10, ghs)
+            gstart = hs + cur; gcur = 0; last = 0; new_ents = []
+            appended = [(None, None, 0, 0)] * len(append)
+            for i, (eo, es, et, ez) in enumerate(ents + appended):
+                if i >= len(ents): data = append[i - len(ents)]
+                else: data = repl[i] if i in repl else (read_raw(gbase + eo, es) if es else b'')
+                if not data and i not in repl and i < len(ents):
+                    new_ents.append((gcur if es == 0 else gcur, 0, et, ez)); continue
+                out.seek(gstart + ghs + gcur); out.write(data)
+                new_ents.append((gcur, len(data), et, ez)); gcur += len(data); last = gcur; gcur += (-gcur) % 0x800
+            gsize = ghs + gcur
+            struct.pack_into('<I', ghdr, 0, len(new_ents))
+            struct.pack_into('<I', ghdr, 0x14, gcur if struct.unpack_from('<I', ghdr, 0x14)[0] else 0)
+            out.seek(gstart); out.write(bytes(ghdr))
+            for e in new_ents: out.write(struct.pack('<4I', *e))
+            new_tops.append((cur, gsize, t, z)); cur += gsize; tlast = cur; cur += (-cur) % 0x800
+        total = hs + cur
+        out.seek(total - 1); out.write(b'\0') if out.tell() < total else None
+        if struct.unpack_from('<I', hdr, 0x14)[0]: struct.pack_into('<I', hdr, 0x14, tlast)
+        out.seek(0); out.write(bytes(hdr))
+        for e in new_tops: out.write(struct.pack('<4I', *e))
diff --git a/tools/guests/setup_guests.py b/tools/guests/setup_guests.py
new file mode 100644
index 00000000..5ad728de
--- /dev/null
+++ b/tools/guests/setup_guests.py
@@ -0,0 +1,219 @@
+"""Build the guests into a GameCube install from the player's own disc images: the step setup.sh runs.
+
+    python3 setup_guests.py [--spawn <xbox image>] [--heihachi <ps2 image>] --game <install>/game --log <file> [--check-image]
+
+Every check runs before any conversion, and each refusal is one plain sentence. The new archive is built beside the
+old one (game/guests.new) and swapped in only when complete, so a failure or an interruption leaves the install
+exactly as it was. A guest already installed whose image is not given is refused, so nobody loses one by accident.
+Exit status: 0 built (or already built, or with --check-image the images are usable), 1 the build failed, 3 refused.
+"""
+import argparse, contextlib, hashlib, json, os, shutil, struct, sys, traceback
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+for d in ('.', '../spawn', '../heihachi'): sys.path.insert(0, os.path.join(_HERE, d))
+import build_guests, build_heihachi, build_spawn, ps2iso, releases, xiso
+
+BUILT, FAILED, REFUSED = 0, 1, 3
+HEADROOM = 64 << 20
+SPAWN_ID, HEIHACHI_ID = 29, 28
+# Each guest disc's own opening movie (the cut with that guest in it), beside the archive: the runtime's movie
+# player shows them in turn with the GameCube's.
+INTRO_SPAWN, INTRO_HEIHACHI = 'intro-spawn.sfd', 'intro-heihachi.sfd'
+
+
+class _Refused(Exception):
+    pass
+
+
+def _sha1(path):
+    h = hashlib.sha1()
+    with open(path, 'rb') as f:
+        for c in iter(lambda: f.read(1 << 24), b''): h.update(c)
+    return h.hexdigest()
+
+
+def _repair(game):
+    """Finish a swap that was cut short: guests.old without guests is the previous build; put it back."""
+    cur, old, new = (os.path.join(game, n) for n in ('guests', 'guests.old', 'guests.new'))
+    if os.path.isdir(old):
+        if os.path.isdir(cur): shutil.rmtree(old)
+        else: os.rename(old, cur)
+    if os.path.isdir(new): shutil.rmtree(new)
+
+
+def _manifest(game):
+    try:
+        with open(os.path.join(game, 'guests', 'guests.json')) as f: return json.load(f)
+    except (OSError, ValueError):
+        return None
+
+
+def _installed(game):
+    """IDs of the guests the install holds now. A format 1 install is Spawn."""
+    m = _manifest(game)
+    ids = {g.get('id') for g in m.get('guests', ())} if m else set()
+    if os.path.isdir(os.path.join(game, 'spawn')): ids.add(SPAWN_ID)
+    return ids
+
+
+def _sources(spawn, heihachi):
+    """guest ID -> what its manifest row's `source` must say."""
+    out = {}
+    if spawn:
+        rel, _, xbe = spawn
+        out[SPAWN_ID] = {'release': rel.name, 'root_sha1': rel.root_sha1, 'xbe_sha1': releases.sha1_view(xbe)}
+    if heihachi:
+        rel, _, _ = heihachi
+        out[HEIHACHI_ID] = {'release': rel.name, 'root_sha1': rel.root_sha1, 'elf_sha1': rel.elf_sha1}
+    return out
+
+
+def _already_built(game, want, gc_sha1):
+    m = _manifest(game)
+    try:
+        return (m is not None and m.get('format') == 2 and m.get('gc_root_sha1') == gc_sha1
+                and m.get('converter') == build_guests._converter_version()
+                and {g.get('id'): g.get('source') for g in m.get('guests', ())} == want
+                and os.path.getsize(os.path.join(game, 'guests', build_guests.ARCHIVE)) == m.get('size'))
+    except OSError:
+        return False
+
+
+def _identify(spawn_image, heihachi_image, spawn_table, heihachi_table):
+    spawn = heihachi = None
+    if spawn_image:
+        try:
+            spawn = releases.identify(xiso.open_source(spawn_image), table=spawn_table)
+        except (xiso.ImageError, releases.Refusal) as e:
+            raise _Refused(str(e))
+        except OSError as e:
+            raise _Refused('cannot read the Xbox disc image (%s)' % (e.strerror or e))
+    if heihachi_image:
+        try:
+            heihachi = ps2iso.identify_release(ps2iso.open_image(heihachi_image), table=heihachi_table)
+        except ps2iso.Refusal as e:
+            raise _Refused(str(e))
+        except OSError as e:
+            raise _Refused('cannot read the PS2 disc image (%s)' % (e.strerror or e))
+    return spawn, heihachi
+
+
+def _check_install(game, spawn, heihachi, gc_sha1):
+    gc_root = os.path.join(game, 'files', 'root.olk')
+    if not os.path.isfile(gc_root):
+        raise _Refused('no GameCube install found in %s' % game)
+    with open(os.path.join(game, 'sys', 'boot.bin'), 'rb') as f: disc = f.read(6).decode('latin-1')
+    if disc != 'GRSEAF':
+        raise _Refused('the guests need the US GameCube disc (this install is %s)' % disc)
+    if _sha1(gc_root) != gc_sha1:
+        raise _Refused('the game data is modified (mods applied): remove the mods or rerun setup first')
+    have = _installed(game)
+    if SPAWN_ID in have and not spawn:
+        raise _Refused('Spawn is installed and would be lost: give his image too with --spawn')
+    if HEIHACHI_ID in have and not heihachi:
+        raise _Refused('Heihachi is installed and would be lost: give his image too with --heihachi')
+    # The build holds a staging archive and the final one at the same time.
+    need = 2 * os.path.getsize(gc_root) + HEADROOM
+    if shutil.disk_usage(game).free < need:
+        raise _Refused('not enough free space: the guests need %.1f GB' % (need / 1e9))
+
+
+def build(out_dir, game, spawn, heihachi):
+    gc, dol = os.path.join(game, 'files', 'root.olk'), os.path.join(game, 'sys', 'main.dol')
+    guests = []
+    if spawn:
+        rel, root, xbe = spawn
+        guests.append(build_spawn.spawn_guest(root, gc, xbe, dol, release=rel))
+    if heihachi:
+        rel, root, elf = heihachi
+        guests.append(build_heihachi.heihachi_guest(root, elf, gc, dol, release=rel))
+    return build_guests.build(guests, gc, out_dir, dol)
+
+
+def copy_intros(out_dir, spawn_image, heihachi_image):
+    """Copy each disc's opening movie (entry 0 of its movie.afs, a Sofdec stream) into out_dir, verbatim.
+
+    An extra, never a reason to fail: a disc without the movie, or a copy that cannot be written, leaves the
+    guests exactly as built and that intro out of the rotation. A movie already there at the right size is kept."""
+    for image, opener, name in ((spawn_image, xiso.open_source, INTRO_SPAWN),
+                                (heihachi_image, ps2iso.open_image, INTRO_HEIHACHI)):
+        if not image: continue
+        dst = os.path.join(out_dir, name)
+        try:
+            v = xiso.find(opener(image), 'movie.afs')
+            if v is None or v.size < 16: continue
+            magic, n, off, size = struct.unpack('<4sIII', v.read(0, 16))
+            if magic != b'AFS\0' or not n or size < 4 or off + size > v.size or v.read(off, 4) != b'\x00\x00\x01\xba':
+                print('%s: no opening movie on this disc' % name); continue
+            if os.path.isfile(dst) and os.path.getsize(dst) == size: continue
+            with open(dst + '.tmp', 'wb') as f:
+                for p in range(0, size, 1 << 24): f.write(v.read(off + p, min(1 << 24, size - p)))
+            os.replace(dst + '.tmp', dst)
+            print('%s: opening movie copied (%d bytes)' % (name, size))
+        except Exception as e:  # not BaseException: an interrupt still stops the build
+            print('%s: opening movie not copied (%s)' % (name, e))
+            with contextlib.suppress(OSError): os.remove(dst + '.tmp')
+
+
+def _names(spawn, heihachi):
+    return ' and '.join(n for n, on in (('Spawn', spawn), ('Heihachi', heihachi)) if on)
+
+
+def run(spawn_image, heihachi_image, game, log, check_only=False, build=build, spawn_table=releases.RELEASES,
+        heihachi_table=ps2iso.RELEASES, gc_sha1=build_guests.GRSEAF_ROOT_SHA1):
+    """The whole step; prints one line for the player and returns the exit status."""
+    if not spawn_image and not heihachi_image:
+        print('nothing to build: give --spawn or --heihachi'); return REFUSED
+    try:
+        spawn, heihachi = _identify(spawn_image, heihachi_image, spawn_table, heihachi_table)
+        if check_only:
+            if spawn: print('Spawn: %s Xbox disc recognised' % spawn[0].name)
+            if heihachi: print('Heihachi: %s PS2 disc recognised' % heihachi[0].name)
+            return BUILT
+        _repair(game)
+        _check_install(game, spawn, heihachi, gc_sha1)
+    except _Refused as e:
+        print(e); return REFUSED
+    names = _names(spawn, heihachi)
+    if _already_built(game, _sources(spawn, heihachi), gc_sha1):
+        # An install from before the intros gains them here; nothing else is touched.
+        with open(os.devnull, 'w') as null, contextlib.redirect_stdout(null):
+            copy_intros(os.path.join(game, 'guests'), spawn_image, heihachi_image)
+        print('%s already built' % names); return BUILT
+    os.makedirs(os.path.dirname(os.path.abspath(log)), exist_ok=True)
+    new, cur, old, old_format = (os.path.join(game, n) for n in ('guests.new', 'guests', 'guests.old', 'spawn'))
+    # utf-8: the log names the images, and a Windows code page cannot write every path.
+    with open(log, 'w', encoding='utf-8') as lf:
+        operation = 'build'
+        try:
+            os.makedirs(new)
+            with contextlib.redirect_stdout(lf):
+                print('%s: %s %s' % (names, spawn_image or '', heihachi_image or ''), flush=True)
+                build(new, game, spawn, heihachi)
+                copy_intros(new, spawn_image, heihachi_image)
+            operation = 'move previous archive'
+            if os.path.isdir(cur): os.rename(cur, old)
+            operation = 'install replacement'
+            os.rename(new, cur)
+            if os.path.isdir(old): shutil.rmtree(old)
+        except BaseException as error:
+            traceback.print_exc(file=lf)
+            shutil.rmtree(new, ignore_errors=True)
+            if os.path.isdir(old) and not os.path.isdir(cur): os.rename(old, cur)
+            if os.name == 'nt' and operation == 'move previous archive' and isinstance(error, PermissionError):
+                print('%s could not be installed: close any program using the guest archive, then retry (details: %s)' % (names, log))
+                return FAILED
+            print('%s could not be built (details: %s)' % (names, log)); return FAILED
+    # The old install goes only now, with the new archive in place. The runtime ignores it if this is cut short.
+    if os.path.isdir(old_format): shutil.rmtree(old_format)
+    print('%s built' % names)
+    return BUILT
+
+
+if __name__ == '__main__':
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    ap.add_argument('--spawn', help='Xbox image or extracted Xbox disc folder'); ap.add_argument('--heihachi')
+    ap.add_argument('--game', required=True); ap.add_argument('--log', required=True)
+    ap.add_argument('--check-image', action='store_true')
+    a = ap.parse_args()
+    sys.exit(run(a.spawn, a.heihachi, a.game, a.log, a.check_image))
diff --git a/tools/guests/sndconv.py b/tools/guests/sndconv.py
new file mode 100644
index 00000000..fa3299e8
--- /dev/null
+++ b/tools/guests/sndconv.py
@@ -0,0 +1,159 @@
+"""Xbox mmx (Xbox/IMA ADPCM) -> GameCube mmg (DSP-ADPCM) sound containers."""
+import os, struct
+STEPS=[7,8,9,10,11,12,13,14,16,17,19,21,23,25,28,31,34,37,41,45,50,55,60,66,73,80,88,97,107,118,130,143,157,173,190,209,230,253,279,307,337,371,408,449,494,544,598,658,724,796,876,963,1060,1166,1282,1411,1552,1707,1878,2066,2272,2499,2749,3024,3327,3660,4026,4428,4871,5358,5894,6484,7132,7845,8630,9493,10442,11487,12635,13899,15289,16818,18500,20350,22385,24623,27086,29794,32767]
+IDX=[-1,-1,-1,-1,2,4,6,8]
+def ima_decode(data, samples):
+    out=[]
+    for at in range(0, len(data)-35, 36):
+        pred, idx = struct.unpack_from('<hB', data, at); out.append(pred)
+        for byte in data[at+4:at+36]:
+            for nib in (byte & 15, byte >> 4):
+                st=STEPS[idx]; d=st>>3
+                if nib&4: d+=st
+                if nib&2: d+=st>>1
+                if nib&1: d+=st>>2
+                pred = pred-d if nib&8 else pred+d
+                pred = -32768 if pred < -32768 else 32767 if pred > 32767 else pred
+                idx += IDX[nib&7]; idx = 0 if idx < 0 else 88 if idx > 88 else idx
+                out.append(pred)
+    return out[:samples]
+
+def lpc2(x):
+    """Order-2 predictor in DSP fixed point (coef/2048) by least squares, solved exactly in integers.
+    Same answer as numpy.linalg.lstsq (including its minimum-norm answer when the fit is degenerate)."""
+    if len(x)<4: return (0,0)
+    from fractions import Fraction
+    a=x[1:-1]; b=x[:-2]; y=x[2:]
+    saa=sum(v*v for v in a); sbb=sum(v*v for v in b); sab=sum(p*q for p,q in zip(a,b))
+    sya=sum(p*q for p,q in zip(y,a)); syb=sum(p*q for p,q in zip(y,b))
+    det=saa*sbb-sab*sab
+    if det:
+        c=(Fraction(sya*sbb-syb*sab,det), Fraction(syb*saa-sya*sab,det))
+    elif saa+sbb:
+        # rank 1: the pseudo-inverse of a rank-1 matrix is its transpose over its squared norm
+        c=(Fraction(sya,saa+sbb), Fraction(syb,saa+sbb))
+    else:
+        return (0,0)
+    return tuple(max(-32768,min(32767,round(v*2048))) for v in c)
+
+def coefs_for(x):
+    """8 coefficient pairs: whole-signal fit, segment fits, and fixed fallbacks."""
+    pairs=[(0,0),(2048,0),(4096,-2048)]
+    pairs.append(lpc2(x))
+    n=len(x)
+    for k in range(4):
+        seg=x[k*n//4:(k+1)*n//4]
+        if len(seg)>16: pairs.append(lpc2(seg))
+    while len(pairs)<8: pairs.append((1024,0))
+    return pairs[:8]
+
+class DspEncoder:
+    """The DSP-ADPCM search, in C (dspenc.c): compiled once with the system C compiler, then fed every
+    clip over a pipe. `cc`: compiler to use; else $CC, else cc, else clang."""
+
+    def __init__(self, cc=None):
+        import shutil, subprocess, tempfile
+        cands = [cc] if cc else [c for c in (os.environ.get('CC'), 'cc', 'clang', 'gcc') if c]
+        comps = list(dict.fromkeys(p for p in map(shutil.which, cands) if p))
+        if not comps:
+            raise ValueError('no C compiler found to build the sound encoder')
+        self.dir = tempfile.mkdtemp(prefix='dspenc-')
+        exe = os.path.join(self.dir, 'dspenc.exe' if os.name == 'nt' else 'dspenc')
+        src = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'dspenc.c')
+        # Each in turn: SteamOS's `cc` can be a clang with no C headers while gcc beside it works.
+        errors = []
+        for comp in comps:
+            # Zig is a C compiler driver with an explicit `cc` subcommand.
+            driver = [comp, 'cc'] if os.path.basename(comp).lower() in ('zig', 'zig.exe') else [comp]
+            r = subprocess.run([*driver, '-O2', '-std=c99', '-o', exe, src, '-lm'], capture_output=True, text=True)
+            if not r.returncode:
+                break
+            errors.append(comp + ': ' + r.stderr.strip()[-300:])
+        else:
+            raise ValueError('the sound encoder did not compile:\n' + '\n'.join(errors))
+        self.p = subprocess.Popen([exe], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+
+    def encode(self, x, coefs):
+        """-> (8-byte frames, frame count), as the numpy encoder returned them."""
+        req = struct.pack('<I16h', len(x), *[v for c in coefs for v in c]) + struct.pack('<%dh' % len(x), *x)
+        self.p.stdin.write(req); self.p.stdin.flush()
+        frames, = struct.unpack('<I', self.p.stdout.read(4))
+        out = self.p.stdout.read(frames * 8)
+        if len(out) != frames * 8:
+            raise ValueError('the sound encoder stopped')
+        return out, frames
+
+    def close(self):
+        import shutil
+        if self.p.poll() is None:
+            self.p.stdin.write(struct.pack('<I', 0)); self.p.stdin.close(); self.p.wait()
+        self.p.stdout.close()
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+
+_ENC = None
+
+
+def dsp_encode(x, coefs):
+    """Encode one clip with this process's encoder (built on first use)."""
+    global _ENC
+    if _ENC is None:
+        import atexit
+        _ENC = DspEncoder(); atexit.register(_ENC.close)
+    return _ENC.encode(x, coefs)
+
+def gc_record(a, b, offset, data_size_unused, samples, nibbles, rate, coefs, ps):
+    r=bytearray(0xb0)
+    struct.pack_into('>I', r, 0, offset)
+    pitch=struct.unpack_from('<i', a, 0x1c)[0]; struct.pack_into('>h', r, 4, max(-32768,min(32767,pitch)))
+    r[6]=a[2]; r[7]=0x40; r[8]=0x40; r[9]=a[5]
+    r[0x14]=0x42; r[0x1e]=0x7c; r[0x1f]=0x06
+    r[0x20:0x22]=b'\x3f\x80'
+    r[0x2a]=a[0x0b]; r[0x2b]=a[0x0c]; r[0x2c]=1; r[0x2d]=a[0x0e]; r[0x2e]=0x64; r[0x2f]=0x64
+    r[0x30:0x32]=b'\x3f\x80'; r[0x34:0x36]=b'\x3f\x80'; r[0x39]=0x7f
+    # 0x3c is 0 in every GC character sound record whose bank matches the Xbox's (21 of the 23 shared
+    # fighters; Charade and Lizardman are a later GC revision). The Xbox's a[0x0a] (10 in the costume
+    # name-call banks) is not it: copying it made his VS-screen name call play at the DSP's maximum rate.
+    r[0x3c]=0; r[0x3f]=a[0x34]
+    struct.pack_into('>IIIHHIII', r, 0x50, samples, nibbles, rate, 0, 0, 2, nibbles-1, 2)
+    struct.pack_into('>16h', r, 0x6c, *[v for c in coefs for v in c])
+    struct.pack_into('>HH', r, 0x8c, 0, ps)
+    return bytes(r)
+
+def convert_bank(xh, xdata):
+    _,_,flags,count,hsz,dsz,oa,sa,ob,sb=struct.unpack_from('<BBHHHIIIII',xh,4)
+    recs=[]; data=bytearray(); placed={}
+    for i in range(count):
+        a=xh[oa+0x58*i:oa+0x58*(i+1)]; b=xh[ob+0x114*i:ob+0x114*(i+1)]
+        fmt,ch,rate=struct.unpack_from('<HHI',b,0); off,size=struct.unpack_from('<II',b,0x14)
+        key=(off,size)
+        if key not in placed:
+            samples=size//36*64
+            pcm=ima_decode(xdata[off:off+size], samples) if fmt==0x69 else [0]*max(14,samples)
+            if not pcm: pcm=[0]*14
+            co=coefs_for(pcm); enc,frames=dsp_encode(pcm,co)
+            placed[key]=(len(data),len(pcm),2+frames*16-((frames*14-len(pcm)) and 0) ,rate,co,enc[0])
+            nib = frames*16  # nibbles incl. headers
+            placed[key]=(len(data),len(pcm),len(pcm)+ (len(pcm)+13)//14*2 ,rate,co,enc[0])
+            data+=enc; data+=bytes(-len(data)%32)
+        o,smp,nib,rt,co,ps=placed[key]
+        recs.append(gc_record(a,b,o,0,smp,nib,rate,co,ps))
+    hdr=b'CHDp'+struct.pack('>BBHHHI',1,0x10,flags,count,count*0xa0+0x10,len(data))
+    return hdr+b''.join(recs), bytes(data)
+
+def convert_container(x):
+    assert x[:4]==b'mmx\0'
+    nb=struct.unpack_from('<I',x,0x14)[0]
+    at=(0x18+16*nb+0x1f)&~0x1f; table=[]; parts=[]
+    for k in range(nb):
+        ho,hs,do,ds=struct.unpack_from('<4I',x,0x18+16*k)
+        if hs==0: h,d=b'',x[do:do+ds]
+        else: h,d=convert_bank(x[ho:ho+hs],x[do:do+ds])
+        ha=at; at=(at+len(h)+0x1f)&~0x1f; da=at; at=(at+len(d)+0x1f)&~0x1f
+        table.append((ha,len(h),da,len(d))); parts.append((ha,h,da,d))
+    out=bytearray(at); out[0:4]=b'mmg\0'; struct.pack_into('>I',out,4,at)
+    out[8:10]=x[8:10]; out[10:12]=x[10:12][::-1]; out[12:16]=x[12:16]
+    struct.pack_into('>II',out,0x10,0x100,nb)
+    for k,row in enumerate(table): struct.pack_into('>4I',out,0x18+16*k,*row)
+    for ha,h,da,d in parts: out[ha:ha+len(h)]=h; out[da:da+len(d)]=d
+    return bytes(out)
