+inline std::vector<std::uint8_t> PreviewRow(std::uint32_t count, std::uint32_t home)
+{
+  std::vector<std::uint8_t> v = Be32(count), p = Be32(home);
+  v.insert(v.end(), p.begin(), p.end());
+  return v;
+}
