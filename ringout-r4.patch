+        RecompMenu::OnKey(RecompMenu::Key::Activate);
+      break;
+    case kVK_ForwardDelete:
+    case kVK_Delete:  // the Mac's "delete" key is backspace; a laptop has no forward delete
+      if (![event isARepeat])
