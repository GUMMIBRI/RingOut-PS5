+  const auto table = ReadAOTRamWord(ram, size, context.sp, 40);
+  const auto entry_offset = ReadAOTRamWord(ram, size, context.sp, 52);
+  if (!table || !entry_offset)
+    return {};
+  const auto index_base = ReadAOTRamWord(ram, size, *table, 0);
+  const auto record_base = ReadAOTRamWord(ram, size, *table, 4);
+  if (!index_base || !record_base)
+    return {};
+
+  const u64 index_address = static_cast<u64>(*index_base) + *entry_offset + 28;
+  if (index_address >= (1ull << 32) || (index_address & 1) != 0)
+    return {};
+  const auto index_word = ReadAOTRamWord(ram, size, static_cast<u32>(index_address & ~3ull), 0);
+  if (!index_word)
+    return {};
+  const u32 half = (*index_word >> ((index_address & 2) ? 0 : 16)) & 0xffff;
+  const s32 index = half < 0x8000 ? static_cast<s32>(half) : static_cast<s32>(half) - 0x10000;
+  const s64 source = static_cast<s64>(*record_base) + static_cast<s64>(index) * 32 + 18;
+  if (source < 0 || source >= (1ll << 32))
