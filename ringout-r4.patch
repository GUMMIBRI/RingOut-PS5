+  std::shared_ptr<ciface::Core::Device> device;
+  {
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    auto* const pad = GetMenuPad();
+    if (pad)
+      device = g_controller_interface.FindDevice(pad->GetDefaultDevice());
+  }
+  if (!device)
+  {
+    previous_device.reset();
+    edges.Reset();
+    close_when_released = false;
+    return;
+  }
+  if (previous_device.lock() != device)
+  {
+    constexpr std::array names = {"Thumb L", "Thumb R", "Pad N", "Pad S", "Pad W",
+                                  "Pad E", "Button A", "Button B", "Button X"};
+    for (std::size_t i = 0; i < inputs.size(); ++i)
+      inputs[i] = device->FindInput(names[i]);
+    previous_device = device;
+    edges.Reset();
+    close_when_released = false;
+  }
+  const bool open = IsOpen();
