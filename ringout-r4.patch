@@ -0,0 +1,9 @@
+# Read-only roster inventory
+
+Run `python inventory.py PATH_TO_ROOT_OLK --platform gamecube` or use `--platform xbox` and redirect JSON to a private file. The chosen platform determines numbered-pack byte order and the expected stock guest; it does not establish disc identity. OLNK headers are little-endian on both platforms. JSON records complete 39-slot character blocks starting at `/4/46`, known guest fighter IDs separately from `/2` UI indices, and size, prefix and SHA-256 per slot and heuristically recognized numbered-pack part. Empty entries are holes. No asset payload is exported. The hashes and prefixes describe private game data; keep the output private.
+
+The parser rejects tables or nonempty entries outside their immediate container, including nested containers. Numbered-pack identification is heuristic, and a malformed or non-pack entry is simply not labeled as a pack. Other fighter-to-block mappings are not established here. This is an inventory, not a converter or proof of runtime compatibility.
+
+Tests: `python -m unittest -v test_inventory` from this directory.
+
+The format and guest indices were informed by `C:/SC2/tools/guests/olnk.py` and `roster.py`, SPDX GPL-3.0-or-later. This tool is GPL-3.0-or-later; see LICENSE-GPL-3.0 in this directory.
diff --git a/tools/roster/inventory.py b/tools/roster/inventory.py
new file mode 100644
index 00000000..c1c152cf
--- /dev/null
+++ b/tools/roster/inventory.py
@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Read-only SC2 archive inventory. Format informed by tools/guests/olnk.py and
+roster.py in the local Xbox project (GPL-3.0-or-later). No assets are extracted.
+"""
+import argparse
+import hashlib
+import json
+import mmap
+import struct
+from pathlib import Path
+
+
+class FormatError(ValueError):
+    pass
+
+
+class Olnk:
+    """A bounded view into an mmap or bytes object; nested views share storage."""
+    def __init__(self, data, base=0, size=None):
+        self.data = data
+        self.base = base
+        self.size = len(data) - base if size is None else size
+        if base < 0 or self.size < 0 or base > len(data) or self.size > len(data) - base:
+            raise FormatError('container outside backing data')
+        if self.size < 32 or data[base + 4:base + 8] != b'olnk':
+            raise FormatError('truncated or invalid OLNK header')
+        self.count = struct.unpack_from('<I', data, base)[0]
+        self.alignment = struct.unpack_from('<I', data, base + 8)[0]
+        self.header_size, self.data_size = struct.unpack_from('<II', data, base + 16)
+        if self.count > (self.size - 32) // 16:
+            raise FormatError('OLNK table exceeds container')
+        if self.header_size < 32 + self.count * 16 or self.header_size > self.size:
+            raise FormatError('invalid OLNK header size')
+        if self.data_size and self.data_size > self.size - self.header_size:
+            raise FormatError('OLNK data size exceeds container')
+        limit = self.data_size or (self.size - self.header_size)
+        for i in range(self.count):
+            offset, length, _, _ = struct.unpack_from('<IIII', data, base + 32 + i * 16)
+            # Zero-sized entries are holes; their unused offsets need not be meaningful.
+            if length and (offset > limit or length > limit - offset):
+                raise FormatError('OLNK entry %d exceeds parent data' % i)
+
+    def entry(self, index):
+        if not 0 <= index < self.count:
+            raise IndexError(index)
+        offset, length, timestamp, _ = struct.unpack_from('<IIII', self.data, self.base + 32 + index * 16)
+        return self.base + self.header_size + offset, length, timestamp
+
+    def child(self, index):
+        at, length, _ = self.entry(index)
+        if not length:
+            raise FormatError('hole cannot be a container')
+        return Olnk(self.data, at, length)
+
+
+def pack_parts(data, base, size, byte_order):
+    """Return bounded (absolute offset, size) parts, or None for non-packs."""
+    if byte_order not in ('big', 'little'):
+        raise ValueError('byte_order must be big or little')
+    if base < 0 or size < 0 or base > len(data) or size > len(data) - base:
+        raise FormatError('pack outside backing data')
+    if size < 8:
+        return None
+    order = '>' if byte_order == 'big' else '<'
+    count = struct.unpack_from(order + 'I', data, base)[0]
+    if count == 0 or count > 4096 or count > (size - 8) // 4:
+        return None
+    table_end = 8 + count * 4
+    offsets = struct.unpack_from(order + str(count + 1) + 'I', data, base + 4)
+    if offsets[0] < table_end or offsets[-1] > size or any(a > b for a, b in zip(offsets, offsets[1:])):
+        return None
+    return [(base + a, b - a) for a, b in zip(offsets, offsets[1:])]
+
+
+def describe(data, at, size, byte_order):
+    if not size:
+        return {'size': 0, 'hole': True}
+    view = memoryview(data)[at:at + size]
+    try:
+        result = {'size': size, 'magic_hex': bytes(view[:16]).hex(), 'sha256': hashlib.sha256(view).hexdigest()}
+    finally:
+        view.release()
+    parts = pack_parts(data, at, size, byte_order)
+    if parts is not None:
+        result['possible_numbered_pack'] = [describe_part(data, pos, length) for pos, length in parts]
+    return result
+
+
+def describe_part(data, at, size):
+    view = memoryview(data)[at:at + size]
+    try:
+        return {'size': size, 'magic_hex': bytes(view[:16]).hex(), 'sha256': hashlib.sha256(view).hexdigest()}
+    finally:
+        view.release()
+
+
+def inventory(data, platform):
+    if platform not in ('gamecube', 'xbox'):
+        raise ValueError('unknown platform')
+    order = 'big' if platform == 'gamecube' else 'little'
+    root = Olnk(data)
+    fighters, ui = root.child(4), root.child(2)
+    blocks = []
+    for block in range(max(0, (fighters.count - 46) // 39)):
+        start = 46 + 39 * block
+        slots = []
+        for slot in range(39):
+            at, size, _ = fighters.entry(start + slot)
+            slots.append({'slot': slot, 'index': start + slot, **describe(data, at, size, order)})
+        blocks.append({'block': block, 'start': start, 'slots': slots})
+    # Source-derived resource indices are UI indices, not runtime fighter IDs.
+    ui_indices = [5, 9, 10, 84, 85, 86, 146, 147, 148, 178, 179, 180,
+                  284, 285, 286, 422, 423, 424, 470, 471, 472, 473, 474, 475, 476, 477]
+    resources = {}
+    for index in ui_indices:
+        if index < ui.count:
+            at, size, _ = ui.entry(index)
+            resources[str(index)] = describe(data, at, size, order)
+    return {'platform_choice': platform, 'child_pack_byte_order': order,
+            'note': 'Platform is supplied by caller, not verified by archive. Pack recognition is heuristic; other block-to-fighter mappings are unknown.',
+            'known_fighter_ids': {'Link': 27, 'Heihachi': 28, 'Spawn': 29},
+            'stock_guest': {'block': 23, 'fighter': 'Link' if platform == 'gamecube' else 'Spawn',
+                            'fighter_id': 27 if platform == 'gamecube' else 29,
+                            'qualification': 'expected for stock platform archive; not verified by archive identity'},
+            'ui_resource_indices_are_not_fighter_ids': True,
+            'root_entry_count': root.count, 'character_entry_count': fighters.count,
+            'complete_blocks': blocks, 'trailing_character_entries': max(0, (fighters.count - 46) % 39),
+            'select_resources': resources}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('archive', type=Path)
+    parser.add_argument('--platform', required=True, choices=('gamecube', 'xbox'))
+    args = parser.parse_args()
+    try:
+        with args.archive.open('rb') as f:
+            with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as data:
+                json.dump(inventory(data, args.platform), __import__('sys').stdout, indent=2)
+                print()
+    except (OSError, ValueError) as exc:
+        parser.exit(2, 'inventory: %s\n' % exc)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/roster/test_inventory.py b/tools/roster/test_inventory.py
new file mode 100644
index 00000000..09a27e73
--- /dev/null
+++ b/tools/roster/test_inventory.py
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+import struct
+import unittest
+
+from inventory import FormatError, Olnk, pack_parts
+
+
+def olnk(entries):
+    header = 32 + 16 * len(entries)
+    out = bytearray(header)
+    struct.pack_into('<I4sII', out, 0, len(entries), b'olnk', 16, 0)
+    struct.pack_into('<I', out, 16, header)
+    for i, value in enumerate(entries):
+        if value is not None:
+            struct.pack_into('<II', out, 32 + 16 * i, len(out) - header, len(value))
+            out.extend(value)
+    struct.pack_into('<I', out, 20, len(out) - header)
+    return out
+
+
+def pack(order):
+    return struct.pack(order + '4I', 2, 16, 19, 19) + b'abc'
+
+
+class Tests(unittest.TestCase):
+    def test_nested_and_hole(self):
+        data = olnk([None, olnk([b'abc'])])
+        root = Olnk(data)
+        self.assertEqual(root.entry(0)[1], 0)
+        with self.assertRaises(FormatError): root.child(0)
+        node = root.child(1)
+        at, size, _ = node.entry(0)
+        self.assertEqual(data[at:at + size], b'abc')
+
+    def test_truncation_and_count(self):
+        for data in (b'olnk', olnk([b'x'])[:35]):
+            with self.assertRaises(FormatError): Olnk(data)
+        data = olnk([])
+        struct.pack_into('<I', data, 0, 0xffffffff)
+        with self.assertRaises(FormatError): Olnk(data)
+
+    def test_header_and_offsets(self):
+        data = olnk([b'x'])
+        struct.pack_into('<I', data, 16, 33)
+        with self.assertRaises(FormatError): Olnk(data)
+        data = olnk([b'x'])
+        struct.pack_into('<I', data, 32, 0xffffffff)
+        with self.assertRaises(FormatError): Olnk(data)
+
+    def test_child_cannot_escape_parent_even_if_backing_has_bytes(self):
+        child = olnk([b'abc'])
+        parent = olnk([child])
+        at, size, _ = Olnk(parent).entry(0)
+        struct.pack_into('<I', parent, at + 36, size)
+        parent.extend(b'X' * size)
+        with self.assertRaises(FormatError): Olnk(parent).child(0)
+
+    def test_pack_endian_and_empty_part(self):
+        for byte_order, prefix, wrong in [('big', '>', 'little'), ('little', '<', 'big')]:
+            data = pack(prefix)
+            self.assertEqual(pack_parts(data, 0, len(data), byte_order), [(16, 3), (19, 0)])
+            self.assertIsNone(pack_parts(data, 0, len(data), wrong))
+
+    def test_pack_bad_count_offsets_and_truncation(self):
+        for data in (struct.pack('>I', 0xffffffff) + b'\0' * 12,
+                     struct.pack('>4I', 2, 16, 15, 19) + b'abc',
+                     struct.pack('>4I', 2, 12, 16, 19) + b'abc',
+                     pack('>')[:-1]):
+            self.assertIsNone(pack_parts(data, 0, len(data), 'big'))
+        with self.assertRaises(FormatError): pack_parts(b'1234', 2, 3, 'big')
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tools/spawn/MAP.md b/tools/spawn/MAP.md
new file mode 100644
index 00000000..4175e9e5
--- /dev/null
+++ b/tools/spawn/MAP.md
@@ -0,0 +1,342 @@
+# Spawn data map (US disc GRSEAF unless stated)
+
+Every location here was confirmed by a measurement, named next to it. Tools used:
+a local `readmap.py` helper, not in this repo (maps a logged read to group/entry/frame), and an
+`LD_PRELOAD` shim logging `pread` on `root.olk`, `movie.afs` and `bgm.afs`.
+
+## Harness trap that hid the ending
+
+Action Replay codes do nothing unless the user dir's `Config/Dolphin.ini` has `[Core] EnableCheats =
+True` (default false; only the in-game menu sets it). Without it the arcade-final route loses on stage 3
+(ring-out vs Astaroth). Check: a held AR write must change the RAM-hash column versus a run without it.
+
+## `root.olk` groups
+
+| group | records | content |
+|---|---|---|
+| 1 | 33 | small per-stage items, one read before each fight |
+| 2 | 516 (Xbox 585) | UI: textures (`VGT.` GC / `VXT.` Xbox) and `mmg`/`mmx` containers, each item stored once per platform at neighbouring indices |
+| 3 | 410 (Xbox 404) | per-stage pairs (~2–6 MB + 16 KB), Xbox and GC versions interleaved |
+| 4 | 982 | 0–45 stages (GC 16/32 = Link's stage, Xbox 17/33 = Spawn's); 46+ character blocks of 39 (block b = 46 + 39 b) |
+
+Character blocks seen in the cheats-on arcade trace: Talim 14; opponents 15, 10, 11, 8, 12, 0, 17, 18 (+
+Inferno borrowing 5 and 2). Link is block 23 on GC; Spawn is block 23 on Xbox.
+
+Spawn's block is complete: every slot Talim uses (0, 1, 8, 9 costumes; 16–27 weapons; 28–29 motion;
+30–36 `mmx` containers) has an Xbox Spawn entry, and the spike converts all of them.
+
+## Ending (found: cheats-on trace, frames 78,657–86,000, screenshots + reads)
+
+- Inferno falls ~78,657; in-engine scene in a stained-glass room ~80,465 (stage group 4 entry 41, read
+  78,322, shared); illustrated pages with scrolling text from ~82,273; music `bgm.afs` entry 10.
+- **Illustrations: group 2, entry 57 + character ID** (Talim 22 → 79 read at 81,225; GC Link 27 → 84;
+  Xbox Spawn 29 → 86). **GC record 86 exists and is empty → Spawn's art is a replacement, not an append.**
+  Formats and the GC palette layout: `ui.py` docstring. Converter oracle (Talim Xbox → GC): PSNR 26.6 /
+  27.6 dB on the two pages (GC requantised its own palette).
+- **Text: group 2 entry 87**, read with the art; byte-identical on both discs and **already contains
+  Spawn's (and Link's) ending text**. Nothing to convert.
