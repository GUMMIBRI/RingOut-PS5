+++ b/tools/guests/texconv.py
@@ -0,0 +1,203 @@
+"""Xbox VXT texture bank -> GameCube VGT (DXT1 -> CMPR; DXT3 -> CMPR + I4 alpha; DXT5 -> CMPR + CMPR alpha)."""
+import struct
+CMPR, I4 = 0xe, 0x0
+D3D_DXT1, D3D_DXT3, D3D_DXT5 = 0x0c, 0x0e, 0x0f
+
+def rev_pairs(b): return ((b & 3) << 6) | ((b & 0xc) << 2) | ((b & 0x30) >> 2) | ((b & 0xc0) >> 6)
+
+def fix4(c0, c1, rows):
+    """A DXT3/5 colour block always decodes 4-colour; CMPR uses 3-colour+transparent when c0 <= c1."""
+    if c0 > c1: return c0, c1, rows
+    if c0 == c1: return c0, c1, bytes(4) if c0 else (c0 | 0, c1, bytes(4))[2]
+    # swap endpoints: index 0<->1, 2<->3
+    m = {0: 1, 1: 0, 2: 3, 3: 2}
+    out = bytes(sum(m[(r >> (2*k)) & 3] << (2*k) for k in range(4)) for r in rows)
+    return c1, c0, out
+
+def cmpr_from_blocks(blocks, bw, bh):
+    """blocks[by][bx] = (c0, c1, rows DXT order) -> CMPR bytes (8x8 tiles of 2x2 blocks)."""
+    out = bytearray()
+    for ty in range(0, max(bh, 2), 2):
+        for tx in range(0, max(bw, 2), 2):
+            for sub in range(4):
+                bx, by = tx + (sub & 1), ty + (sub >> 1)
+                if bx < bw and by < bh:
+                    c0, c1, rows = blocks[by][bx]
+                    out += struct.pack('>HH', c0, c1) + bytes(rev_pairs(r) for r in rows)
+                else:
+                    out += bytes(8)
+    return bytes(out)
+
+def grey_block(vals):
+    lo, hi = min(vals), max(vals)
+    def c565(v): r = v >> 3; g = v >> 2; return (r << 11) | (g << 5) | r
+    def dec(c): r = (c >> 11) & 31; return (r << 3) | (r >> 2)
+    c0, c1 = c565(hi), c565(lo)
+    if c0 == c1:
+        return (c0, c1, bytes(4)) if c0 else (0x0020, 0, bytes([0x55] * 4))  # c0>c1 needed; all index 1 = black
+    a, b = dec(c0), dec(c1); pal = [a, b, (2*a + b)//3, (a + 2*b)//3]
+    rows = []
+    for y in range(4):
+        r = 0
+        for xx in range(4):
+            v = vals[4*y + xx]; k = min(range(4), key=lambda i: abs(pal[i] - v)); r |= k << (2*xx)
+        rows.append(r)
+    return c0, c1, bytes(rows)
+
+def dxt5_alpha(blk):
+    a0, a1 = blk[0], blk[1]; bits = int.from_bytes(blk[2:8], 'little')
+    if a0 > a1: pal = [a0, a1] + [((6 - i) * a0 + (1 + i) * a1) // 7 for i in range(6)]
+    else: pal = [a0, a1] + [((4 - i) * a0 + (1 + i) * a1) // 5 for i in range(4)] + [0, 255]
+    return [pal[(bits >> (3*i)) & 7] for i in range(16)]
+
+def level_dims(w, h, l): return max(1, w >> l), max(1, h >> l)
+
+def convert_level(data, at, w, h, fmt):
+    bw, bh = max(1, (w + 3)//4), max(1, (h + 3)//4)
+    bs = 8 if fmt == D3D_DXT1 else 16
+    col = [[None]*bw for _ in range(bh)]; alpha = [[None]*bw for _ in range(bh)]
+    for by in range(bh):
+        for bx in range(bw):
+            blk = data[at + (by*bw + bx)*bs: at + (by*bw + bx + 1)*bs]
+            cb = blk[-8:]; c0, c1 = struct.unpack_from('<HH', cb, 0); rows = cb[4:8]
+            if fmt != D3D_DXT1: c0, c1, rows = fix4(c0, c1, rows)
+            col[by][bx] = (c0, c1, rows)
+            if fmt == D3D_DXT3:
+                alpha[by][bx] = [((blk[i//2] >> (4*(i & 1))) & 15) for i in range(16)]
+            elif fmt == D3D_DXT5:
+                alpha[by][bx] = dxt5_alpha(blk[:8])
+    colour = cmpr_from_blocks(col, bw, bh)
+    a = b''
+    if fmt == D3D_DXT5:
+        a = cmpr_from_blocks([[grey_block(alpha[by][bx]) for bx in range(bw)] for by in range(bh)], bw, bh)
+    elif fmt == D3D_DXT3:
+        # I4: 8x8 tiles, rows of 4 bytes, high nibble first
+        out = bytearray()
+        tw, th = (w + 7)//8, (h + 7)//8
+        def texel(xx, yy):
+            if xx >= w or yy >= h: return 0
+            return alpha[yy//4][xx//4][(yy % 4)*4 + xx % 4]
+        for ty in range(th):
+            for tx in range(tw):
+                for yy in range(8):
+                    for xx in range(0, 8, 2):
+                        X, Y = tx*8 + xx, ty*8 + yy
+                        out.append((texel(X, Y) << 4) | texel(X + 1, Y))
+        a = bytes(out)
+    return colour, a, bw*bh*bs
+
+def vxt_to_vgt(v, drop_top=frozenset()):
+    """Xbox VXT -> GC VGT. Textures whose index is in `drop_top` lose their top mip level: the next level,
+    already in the file, becomes the base (half the size, no re-encoding; see build_spawn.GC_MODEL_MAX)."""
+    assert v[:4] == b'VXT.', v[:4]
+    n = struct.unpack_from('<I', v, 8)[0]
+    ents = []
+    for k in range(n):
+        e = v[0x14 + 0x24*k: 0x14 + 0x24*(k+1)]
+        wh = struct.unpack_from('<I', e, 0x0c)[0]; w, h = wh & 0xffff, wh >> 16
+        off, fmt = struct.unpack_from('<II', e, 0x10); mips = struct.unpack_from('<I', e, 0x1c)[0] or 1
+        ents.append((w, h, off, fmt, mips, struct.unpack_from('<I', e, 0)[0]))
+    table_end = 0x18 + 0x44*n
+    data = bytearray(); recs = []
+    base = (table_end + 0x1f) & ~0x1f
+    for k, (w, h, off, fmt, mips, palhdr) in enumerate(ents):
+        if fmt not in (D3D_DXT1, D3D_DXT3, D3D_DXT5, 0x0b):
+            raise ValueError('texture format %#x not handled' % fmt)
+        cols = []; alps = []; at = off
+        if k in drop_top:
+            if mips < 2:
+                raise ValueError('texture %d has one mip level: nothing to drop' % k)
+            bw, bh = max(1, (w + 3)//4), max(1, (h + 3)//4)
+            at += w*h if fmt == 0x0b else bw*bh*(8 if fmt == D3D_DXT1 else 16)
+            w, h, mips = max(1, w // 2), max(1, h // 2), mips - 1
+        if fmt == 0x0b:
+            # P8 (swizzled, D3D palette object at palhdr: u32 data offset, u32 entries) -> CMPR (+ CMPR alpha)
+            pal_off = struct.unpack_from('<I', v, palhdr)[0]
+            imgs = []
+            for l in range(mips):
+                lw, lh = level_dims(w, h, l); imgs.append((p8_rgba(v, at, pal_off, lw, lh), lw, lh)); at += lw*lh
+            has_alpha = any(p[3] < 250 for img, _, _ in imgs for row in img for p in row)
+            for img, lw, lh in imgs:
+                cols.append(rgba_to_cmpr(img, lw, lh))
+                if has_alpha: alps.append(rgba_to_cmpr(img, lw, lh, alpha=True))
+            fmt = D3D_DXT5 if has_alpha else D3D_DXT1
+        else:
+          for l in range(mips):
+            lw, lh = level_dims(w, h, l)
+            c, a, used = convert_level(v, at, lw, lh, fmt); at += used; cols.append(c); alps.append(a)
+        data += bytes(-len(data) % 32); coff = base + len(data); data += b''.join(cols)
+        aoff = 0
+        if fmt != D3D_DXT1:
+            data += bytes(-len(data) % 32); aoff = base + len(data); data += b''.join(alps)
+        mode0 = 0x190 if mips == 1 else 0x1d0
+        mode1 = ((mips - 1) * 16) << 8
+        img = lambda f: (f << 20) | ((h - 1) << 10) | (w - 1)
+        size = ((w*h)//64 << 16) | (mips + 1)
+        if fmt == D3D_DXT1:
+            words = [0, mode0, mode1, img(CMPR), coff, 0x0e, 0x0e, 0, size, 0, 0, 0, 0, (w << 16) | h, 0, 0, 0]
+        elif fmt == D3D_DXT5:
+            words = [0, mode0, mode1, img(CMPR), coff, 0x0002000c, 0x0e, 0, size, mode0, mode1, img(CMPR), aoff, 0, 0x0e, 0, size]
+        else:
+            words = [0, mode0, mode1, img(CMPR), coff, 0x0022000d, 0x0e, 0, size, mode0, mode1, img(I4), aoff, 0, 0, 0, size | 0x100]
+        recs.append(struct.pack('>17I', *words))
+    hdr = b'VGT.' + bytes((4, 0, 0, 0)) + struct.pack('>IIII', n, 0, 0x18, table_end)
+    out = bytearray(hdr + b''.join(recs)); out += bytes(base - len(out)); out += data
+    return bytes(out), None
+
+def unswizzle_index(x, y, w, h):
+    """Xbox (Morton) swizzle: interleave x and y bits while both have bits left."""
+    off = 0; bit = 0; mw, mh = w - 1, h - 1; sx = sy = 1
+    i = 0
+    while mw or mh:
+        if mw: off |= (x & 1) << i; i += 1; x >>= 1; mw >>= 1
+        if mh: off |= (y & 1) << i; i += 1; y >>= 1; mh >>= 1
+    return off
+
+def p8_rgba(v, off, pal_off, w, h):
+    pal = [struct.unpack_from('<I', v, pal_off + 4*i)[0] for i in range(256)]
+    out = []
+    for y in range(h):
+        row = []
+        for xx in range(w):
+            c = pal[v[off + unswizzle_index(xx, y, w, h)]]
+            row.append(((c >> 16) & 255, (c >> 8) & 255, c & 255, c >> 24))
+        out.append(row)
+    return out
+
+def enc565(r, g, b): return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
+def dec565(c):
+    r, g, b = (c >> 11) & 31, (c >> 5) & 63, c & 31
+    return ((r << 3) | (r >> 2), (g << 2) | (g >> 4), (b << 3) | (b >> 2))
+
+def colour_block(px):
+    """DXT1 4-colour block from 16 RGB tuples: endpoints along the luminance extremes."""
+    lum = [p[0]*3 + p[1]*6 + p[2] for p in px]
+    hi = px[max(range(16), key=lambda i: lum[i])]; lo = px[min(range(16), key=lambda i: lum[i])]
+    c0, c1 = enc565(*hi[:3]), enc565(*lo[:3])
+    if c0 == c1:
+        if c0 == 0: return 1, 0, bytes([0x55]*4)  # all colour 1 (black), 4-colour mode
+        return c0, c1, bytes(4)
+    if c0 < c1: c0, c1 = c1, c0
+    a, b = dec565(c0), dec565(c1)
+    pal = [a, b, tuple((2*x + y)//3 for x, y in zip(a, b)), tuple((x + 2*y)//3 for x, y in zip(a, b))]
+    rows = []
+    for yy in range(4):
+        r = 0
+        for xx in range(4):
+            p = px[4*yy + xx]
+            k = min(range(4), key=lambda i: sum((p[j] - pal[i][j])**2 for j in range(3)))
+            r |= k << (2*xx)
+        rows.append(r)
+    return c0, c1, bytes(rows)
+
+def rgba_to_cmpr(img, w, h, alpha=False):
+    bw, bh = max(1, (w + 3)//4), max(1, (h + 3)//4)
+    blocks = []
+    for by in range(bh):
+        row = []
+        for bx in range(bw):
+            px = [img[min(h-1, by*4 + yy)][min(w-1, bx*4 + xx)] for yy in range(4) for xx in range(4)]
+            if alpha: row.append(grey_block([p[3] for p in px]))
+            else: row.append(colour_block(px))
+        blocks.append(row)
+    return cmpr_from_blocks(blocks, bw, bh)
diff --git a/tools/guests/ui.py b/tools/guests/ui.py
new file mode 100644
index 00000000..5c479916
--- /dev/null
+++ b/tools/guests/ui.py
@@ -0,0 +1,374 @@
+"""Character data outside the 39-entry character block (see MAP.md for how each was found).
+
+Ending illustrations: group 2, entry 57 + character ID, on both discs (Talim 22 -> 79, Link 27 -> 84 on
+GC, Spawn 29 -> 86 on Xbox; GC's record 86 exists and is empty). A two-part pack: part 0 a texture file
+with the two ending pages, part 1 a 2 KB block that is byte-identical across platforms.
+  Xbox: VXT, 2 x 512x512 P8, Morton-swizzled, D3D palette (u32 ARGB, little-endian).
+  GC:   VGT, 2 x 640x448 C8 in 8x4 tiles; per page two 256-entry palette halves of u8 pairs, (G, R) then
+        (A, B), page k's halves at 0xe0 + 0x400*k and 0x2e0 + 0x400*k.
+The ending TEXT (group 2 entry 87) is identical on both discs and already holds Spawn's ending.
+"""
+import struct
+from olk import pack
+import texconv
+
+ENDING_ART_BASE = 57
+ENDING_TEXT = (2, 87)
+GC_W, GC_H = 640, 448
+XB_W, XB_H = 512, 512
+_PIXELS = (0x8e0, 0x468e0)       # page offsets inside the GC texture file (template layout, asserted)
+
+
+def locate(gc):
+    """Where each per-character item lives on the GC disc."""
+    return {'ending_art': lambda char_id: (2, ENDING_ART_BASE + char_id), 'ending_text': ENDING_TEXT}
+
+
+def _parts(entry, be):
+    n = struct.unpack_from('>I' if be else '<I', entry, 0)[0]
+    offs = struct.unpack_from(('>' if be else '<') + '%dI' % (n + 1), entry, 4)
+    return [(offs[i], offs[i + 1]) for i in range(n)]
+
+
+def _template_layout(tex):
+    """Check the GC template is the layout this converter writes (both pages C8 640x448)."""
+    n = struct.unpack_from('>I', tex, 8)[0]
+    assert n == 2, n
+    for k in range(2):
+        w = struct.unpack_from('>17I', tex, 0x18 + 0x44 * k)
+        assert w[3] >> 20 == 9 and (w[3] & 0x3ff) + 1 == GC_W and ((w[3] >> 10) & 0x3ff) + 1 == GC_H, w
+        assert w[4] == _PIXELS[k], hex(w[4])
+
+
+# Images below are flat row-major lists of palette indices; palettes are lists of (r, g, b, a).
+
+def _xbox_page(vxt, k):
+    """(indices, palette) of Xbox page k (XB_W x XB_H)."""
+    return _xbox_p8(vxt, k, XB_W, XB_H)
+
+
+def _tiles8(img, w, h):
+    """w x h C8 indices -> GX 8x4 tile order."""
+    return bytes(img[(ty * 4 + r) * w + tx * 8 + c]
+                 for ty in range(h // 4) for tx in range(w // 8) for r in range(4) for c in range(8))
+
+
+def _untile8(raw, w, h):
+    """GX 8x4 C8 tiles -> flat row-major indices."""
+    img = [0] * (w * h); i = 0
+    for ty in range(h // 4):
+        for tx in range(w // 8):
+            for r in range(4):
+                for c in range(8):
+                    img[(ty * 4 + r) * w + tx * 8 + c] = raw[i]; i += 1
+    return img
+
+
+def _gr_ab(pal):
+    """GC palette halves: (G, R) pairs and (A, B) pairs."""
+    return bytes(v for p in pal for v in (p[1], p[0])), bytes(v for p in pal for v in (p[3], p[2]))
+
+
+def _gc_rgb(gr, ab, c):
+    """The first c colours of a GC split palette as (r, g, b)."""
+    return [(gr[2 * i + 1], gr[2 * i], ab[2 * i + 1]) for i in range(c)]
+
+
+def _rows(img, w, pix):
+    """Flat index image -> rows of pix[index]."""
+    return [[pix[v] for v in img[y * w:(y + 1) * w]] for y in range(len(img) // w)]
+
+
+def ending_art(xbox_entry, gc_template):
+    """Convert an Xbox ending-art entry into GC form, reusing `gc_template` (any GC ending-art entry)
+    for every header byte. Index images are resampled nearest-neighbour, so the palette stays exact."""
+    xp, gp = _parts(xbox_entry, False), _parts(gc_template, True)
+    assert len(xp) == len(gp) == 2
+    out = bytearray(gc_template)
+    t0 = gp[0][0]
+    _template_layout(out[t0:gp[0][1]])
+    vxt = xbox_entry[xp[0][0]:xp[0][1]]
+    for k in range(2):
+        idx, pal = _xbox_page(vxt, k)
+        img = [idx[(y * XB_H // GC_H) * XB_W + x * XB_W // GC_W] for y in range(GC_H) for x in range(GC_W)]
+        at = t0 + _PIXELS[k]; out[at:at + GC_W * GC_H] = _tiles8(img, GC_W, GC_H)
+        gr, ab = _gr_ab(pal)
+        p = t0 + 0xe0 + 0x400 * k; out[p:p + 512] = gr; out[p + 0x200:p + 0x400] = ab
+    text = xbox_entry[xp[1][0]:xp[1][1]]
+    assert len(text) == gp[1][1] - gp[1][0]
+    out[gp[1][0]:gp[1][1]] = text
+    return bytes(out)
+
+
+def decode_ending(gc_entry, page):
+    """GC ending-art page -> rows of (r, g, b) (for tests and checks)."""
+    t0 = _parts(gc_entry, True)[0][0]
+    at = t0 + _PIXELS[page]
+    idx = _untile8(gc_entry[at:at + GC_W * GC_H], GC_W, GC_H)
+    p = t0 + 0xe0 + 0x400 * page
+    return _rows(idx, GC_W, _gc_rgb(gc_entry[p:p + 512], gc_entry[p + 0x200:p + 0x400], 256))
+
+
+# Select-screen face portraits (MAP.md, Task 8): group 2 entry 5 is a pack (big-endian on GC); part 2 is the
+# face bank, one 64x64 texture per index, and a select cell's "A" bytes are indices into it. GC: VGT of C8
+# textures, each with a 24-byte TLUT descriptor (u32 0, u32 offset, u16 count, u16 0) x2 pointing at the
+# (G, R) and (A, B) palette halves, the same split as the ending art. Xbox: VXT of 64x64 P8.
+FACE_ENTRY = (2, 5)
+FACE_PART = 2
+FACE_W = 64
+XB_SPAWN_FACES = (51, 52)          # his record on Xbox: A = 51, 52 (one per costume)
+_REC, _DESC = 0x44, 0x18
+
+
+def _xbox_p8(vxt, k, w, h):
+    """(indices, palette) of Xbox P8 texture k: w*h row-major indices, 256 (r, g, b, a)."""
+    e = struct.unpack_from('<9I', vxt, 0x14 + 0x24 * k)
+    palhdr, off, fmt = e[0], e[4], e[5]
+    assert fmt == 0x0b and e[3] == (h << 16) | w, (hex(fmt), hex(e[3]))
+    pal_off = struct.unpack_from('<I', vxt, palhdr)[0]
+    pal = [((v >> 16) & 255, (v >> 8) & 255, v & 255, v >> 24) for v in struct.unpack_from('<256I', vxt, pal_off)]
+    raw = vxt[off:off + w * h]
+    assert len(raw) == w * h
+    return [raw[texconv.unswizzle_index(x, y, w, h)] for y in range(h) for x in range(w)], pal
+
+
+def xbox_face(vxt, k):
+    """Xbox face k -> rows of (r, g, b)."""
+    idx, pal = _xbox_p8(vxt, k, FACE_W, FACE_W)
+    return _rows(idx, FACE_W, [p[:3] for p in pal])
+
+
+def _face_rec(vgt, k):
+    w = struct.unpack_from('>17I', vgt, struct.unpack_from('>I', vgt, 0x10)[0] + _REC * k)
+    assert w[3] >> 20 == 9 and (w[3] & 0x3ff) + 1 == FACE_W and ((w[3] >> 10) & 0x3ff) + 1 == FACE_W, hex(w[3])
+    d = struct.unpack_from('>6I', vgt, w[0])
+    assert 0 < d[2] >> 16 <= 256 and d[5] >> 16 == d[2] >> 16, (hex(d[2]), hex(d[5]))
+    return w, d
+
+
+def decode_face(gc_entry, k):
+    """GC face k (in entry 5's face bank) -> rows of (r, g, b) (for tests and checks)."""
+    vgt = olk_pack(gc_entry)[FACE_PART]
+    w, d = _face_rec(vgt, k)
+    idx = _untile8(vgt[w[4]:w[4] + FACE_W * FACE_W], FACE_W, FACE_W)
+    c = d[2] >> 16
+    return _rows(idx, FACE_W, _gc_rgb(vgt[d[1]:d[1] + 2 * c], vgt[d[4]:d[4] + 2 * c], c))
+
+
+def olk_pack(entry):
+    return pack(entry, True)
+
+
+def face_items(xbox_entry, gc_entry, faces=XB_SPAWN_FACES):
+    """Xbox faces `faces` as items for append_textures on the GC face bank."""
+    xvgt = pack(xbox_entry, False)[FACE_PART]
+    gvgt = olk_pack(gc_entry)[FACE_PART]
+    items = []
+    for xk in faces:
+        idx, pal = _xbox_p8(xvgt, xk, FACE_W, FACE_W)
+        items.append((_face_rec(gvgt, 0)[0], _tiles8(idx, FACE_W, FACE_W)) + _gr_ab(pal) + (256,))
+    return items
+
+
+def face_bank(xbox_entry, gc_entry, faces=XB_SPAWN_FACES):
+    """Append Xbox faces `faces` to the GC face bank. Returns (new GC entry 5, index of the first new face)."""
+    out, n = append_textures(gc_entry, FACE_PART, face_items(xbox_entry, gc_entry, faces))
+    _face_rec(olk_pack(out)[FACE_PART], 0)
+    return out, n
+
+
+# The game carves 0xA0000 bytes for this common menu and mission pack before the
+# next arena. Its DVD loader rounds the read to a 0x800-byte sector.
+_COMMON_PACK_CAPACITY = 0xA0000
+_DVD_SECTOR_SIZE = 0x800
+
+
+def guest_face_bank(gc_entry, guest_faces):
+    """Return the shared face pack and the portrait index for every guest costume."""
+    if any(not faces for faces in guest_faces):
+        raise ValueError('every guest needs at least one portrait')
+
+    def build(primary_only):
+        items, indices = [], []
+        for faces in guest_faces:
+            index = len(items)
+            if primary_only:
+                items.append(faces[0])
+                indices.append([index] * len(faces))
+            else:
+                items.extend(faces)
+                indices.append(range(index, len(items)))
+        # The stock common pack aligns its inner parts to 0x80. The outer OLK
+        # writer supplies the separate DVD sector alignment.
+        entry, first = append_textures(gc_entry, FACE_PART, items, part_alignment=0x80)
+        return entry, [[first + index for index in row] for row in indices]
+
+    def fits(entry):
+        rounded = len(entry) + (-len(entry) % _DVD_SECTOR_SIZE)
+        return rounded <= _COMMON_PACK_CAPACITY - _DVD_SECTOR_SIZE
+
+    entry, indices = build(primary_only=False)
+    if not fits(entry):
+        entry, indices = build(primary_only=True)
+        if not fits(entry):
+            raise ValueError('guest portraits exceed the common game-data buffer')
+    return entry, indices
+
+
+def append_textures(gc_entry, part, items, *, part_alignment=0x800):
+    """Append textures to the VGT bank in pack part `part` of a GC entry. Each item is (template record
+    words, pixel bytes, GR palette half, AB palette half, palette entries); the template gives format and
+    size. Returns (new entry, index of the first new texture).
+    The loader reads records from 0x18 whatever the header's table offset says, and walks the TLUT
+    descriptors as one array straight after the table (one per record, ending at header +0x14); it
+    converts both in place, and converts only palettes in the block before the first pixel data. So the
+    new records, descriptors and palettes each go after the old ones, and every offset behind each
+    insertion moves (palettes and pixels by a multiple of 32). The new pixels go at the end."""
+    gparts = olk_pack(gc_entry)
+    old = bytes(gparts[part])
+    assert old[:4] == b'VGT.', old[:4]
+    n, table, tail = struct.unpack_from('>I', old, 8)[0], struct.unpack_from('>I', old, 0x10)[0], struct.unpack_from('>I', old, 0x14)[0]
+    k_new = len(items)
+    end = table + _REC * n
+    assert table == 0x18 and tail == end + _DESC * n, (hex(table), hex(tail))
+    s_rec = _REC * k_new
+    s_all = s_rec + _DESC * k_new; s_all += -s_all % 32
+    pix0 = min(struct.unpack_from('>I', old, table + _REC * k + 16)[0] for k in range(n))
+    s_pal = sum(len(gr) + len(ab) for _, _, gr, ab, _ in items)   # the new palettes join the block before the pixels
+    assert all(len(gr) % 32 == 0 and len(gr) == len(ab) == 2 * c for _, _, gr, ab, c in items)
+    def mv(o):
+        if o >= pix0: return o + s_all + s_pal
+        if o >= tail: return o + s_all
+        return o + s_rec if o >= end else o
+    recs = []
+    for k in range(n):
+        w = list(struct.unpack_from('>17I', old, table + _REC * k))
+        for i in (0, 4, 12):
+            if w[i]: w[i] = mv(w[i])
+        recs.append(w)
+    descs = []
+    for k in range(n):
+        d = list(struct.unpack_from('>6I', old, end + _DESC * k))
+        for i in (1, 4):
+            if d[i]: d[i] = mv(d[i])
+        descs.append(d)
+    vgt = bytearray(old[:table]) + bytes(s_all + tail - table) + old[tail:pix0] + bytes(s_pal) + old[pix0:]
+    at = s_all + pix0
+    def put(b):
+        vgt.extend(bytes(-len(vgt) % 32)); o = len(vgt); vgt.extend(b); return o
+    for template, pixels, gr, ab, c in items:
+        vgt[at:at + len(gr)] = gr; vgt[at + len(gr):at + 2 * len(gr)] = ab
+        descs.append([0, at, c << 16, 0, at + len(gr), c << 16]); at += 2 * len(gr)
+        w = list(template); w[4] = put(pixels); recs.append(w)
+    new_end = table + _REC * len(recs)
+    for k, w in enumerate(recs): w[0] = new_end + _DESC * k
+    for k, d in enumerate(descs): struct.pack_into('>6I', vgt, new_end + _DESC * k, *d)
+    for k, w in enumerate(recs): struct.pack_into('>17I', vgt, table + _REC * k, *w)
+    struct.pack_into('>I', vgt, 8, len(recs)); struct.pack_into('>I', vgt, 0x14, new_end + _DESC * len(recs))
+    vgt.extend(bytes(-len(vgt) % 32))
+    # Preserve the packed header and pad the growth to the required inner-part alignment.
+    offs = struct.unpack_from('>%dI' % (len(gparts) + 1), gc_entry, 4)
+    if part_alignment != 0x800 and any(offset % part_alignment for offset in offs):
+        raise ValueError('unexpected inner-part alignment in the source pack')
+    grow = len(vgt) - len(old); grow += -grow % part_alignment
+    vgt.extend(bytes(grow - (len(vgt) - len(old))))
+    new_offs = [o + (grow if i > part else 0) for i, o in enumerate(offs)]
+    out = bytearray(gc_entry[:offs[0]])
+    struct.pack_into('>%dI' % len(new_offs), out, 4, *new_offs)
+    for i, p in enumerate(gparts):
+        out.extend(bytes(new_offs[i] - len(out)))
+        out.extend(vgt if i == part else p)
+    out.extend(bytes(new_offs[-1] - len(out)))
+    out.extend(gc_entry[offs[-1]:])
+    return bytes(out), n
+
+
+# ---- Select-screen silhouettes: group 2 entry 10 part 0, a VGT bank of 128x256 C4 figures, one per
+# costume, shown while a fighter's model loads. A cell's bytes +16..+23 index it (GC Link 100-103; the
+# Xbox bank has 6 more early textures, so Mitsurugi is 0x32 on GC and 0x38 on Xbox). His cell was Link's,
+# so he showed Link's figure. His Xbox figures are P8 using palette entries 0-15 only: exact as C4.
+SILHOUETTE_ENTRY = (2, 10)
+SILHOUETTE_PART = 0
+SIL_W, SIL_H = 128, 256
+XB_SPAWN_SILHOUETTES = (106, 107)  # his Xbox cell's +16 bytes (one per costume)
+GC_SIL_TEMPLATE = 100              # Link's first figure: a 128x256 C4 record
+
+
+def silhouette_template(gc_entry):
+    """The record words of a GC figure, a 128x256 C4 texture."""
+    gvgt = olk_pack(gc_entry)[SILHOUETTE_PART]
+    tw = struct.unpack_from('>17I', gvgt, 0x18 + _REC * GC_SIL_TEMPLATE)
+    assert tw[3] >> 20 == 8 and (tw[3] & 0x3ff) + 1 == SIL_W and ((tw[3] >> 10) & 0x3ff) + 1 == SIL_H, hex(tw[3])
+    return tw
+
+
+def tiles4(idx, w, h):
+    """w x h C4 indices -> GX 8x8 tile order, two to a byte."""
+    t = [idx[(ty * 8 + r) * w + tx * 8 + c] for ty in range(h // 8) for tx in range(w // 8) for r in range(8) for c in range(8)]
+    return bytes(t[i] << 4 | t[i + 1] for i in range(0, len(t), 2))
+
+
+def silhouette_items(xbox_entry, gc_entry, sils=XB_SPAWN_SILHOUETTES):
+    """Xbox silhouettes `sils` as items for append_textures on the GC bank."""
+    xvgt = pack(xbox_entry, False)[SILHOUETTE_PART]
+    tw = silhouette_template(gc_entry)
+    items = []
+    for xk in sils:
+        idx, pal = _xbox_p8(xvgt, xk, SIL_W, SIL_H)
+        if max(idx) > 15:
+            raise ValueError('Xbox silhouette %d uses more than 16 colours' % xk)
+        items.append((tw, tiles4(idx, SIL_W, SIL_H)) + _gr_ab(pal[:16]) + (16,))
+    return items
+
+
+def silhouette_bank(xbox_entry, gc_entry, sils=XB_SPAWN_SILHOUETTES):
+    """Append Xbox silhouettes `sils` to the GC bank. Returns (new GC entry 10, index of the first new one)."""
+    return append_textures(gc_entry, SILHOUETTE_PART, silhouette_items(xbox_entry, gc_entry, sils))
+
+
+def decode_silhouette(gc_entry, k):
+    """GC silhouette k -> flat row-major palette indices, SIL_W x SIL_H (for tests and checks)."""
+    vgt = olk_pack(gc_entry)[SILHOUETTE_PART]
+    w = struct.unpack_from('>17I', vgt, 0x18 + _REC * k)
+    px = [v for b in vgt[w[4]:w[4] + SIL_W * SIL_H // 2] for v in (b >> 4, b & 15)]
+    img = [0] * (SIL_W * SIL_H); i = 0
+    for ty in range(SIL_H // 8):
+        for tx in range(SIL_W // 8):
+            for r in range(8):
+                for c in range(8):
+                    img[(ty * 8 + r) * SIL_W + tx * 8 + c] = px[i]; i += 1
+    return img
+
+
+# ---- Character Profile camera: GC group 2 entry 503, Xbox 516 (517-520 are the same for Spawn).
+# A 96-part pack, three 32-slot sections indexed by character ID (slot 29 + 32k is Spawn; the GC has
+# Link in 27 + 32k and nothing in 29 + 32k, so the profile camera's goal stays zero and it aims at his
+# feet). Section 0 (parts 1-31) is f32 data, plain u32 swap; sections 1 and 2 are a u32 count followed
+# by u16 data. Both rules reproduce every fighter the discs share, except two whose content differs.
+PROFILE_CAMERA = (2, 503)
+XB_PROFILE_CAMERA = (2, 516)
+PROFILE_SLOTS = 32
+
+
+def _profile_part(x, section):
+    out = bytearray(len(x))
+    if section == 0:
+        for o in range(0, len(x) // 4 * 4, 4): out[o:o + 4] = x[o:o + 4][::-1]
+        return bytes(out)
+    struct.pack_into('>I', out, 0, struct.unpack_from('<I', x, 0)[0])
+    for o in range(4, len(x) // 2 * 2, 2): out[o:o + 2] = x[o:o + 2][::-1]
+    return bytes(out)
+
+
+def profile_camera(xbox_entry, gc_entry, char_id=29):
+    """The GC entry with the Xbox's camera parts for char_id converted into its three empty slots."""
+    import xb2gc
+    g = pack(gc_entry, True); x = pack(xbox_entry, False)
+    assert len(g) == len(x) == 3 * PROFILE_SLOTS, (len(g), len(x))
+    out = list(g)
+    for s in range(3):
+        k = char_id + PROFILE_SLOTS * s
+        if g[k]: raise ValueError('profile camera slot %d is not empty on this disc' % k)
+        if not x[k]: raise ValueError('the Xbox has no profile camera slot %d' % k)
+        out[k] = _profile_part(x[k], s)
+    return xb2gc.build_pack(out)
diff --git a/tools/guests/xb2gc.py b/tools/guests/xb2gc.py
new file mode 100644
index 00000000..9d5bbfcf
--- /dev/null
+++ b/tools/guests/xb2gc.py
@@ -0,0 +1,138 @@
+"""Xbox -> GameCube converters for Soulcalibur II character data (throwaway spike)."""
+import struct
+
+def sw16(b, at, n):
+    for i in range(at, at + 2*n, 2): b[i], b[i+1] = b[i+1], b[i]
+def sw32(b, at, n):
+    for i in range(at, at + 4*n, 4): b[i:i+4] = b[i:i+4][::-1]
+
+def build_pack(parts, be=True, align=0x80):
+    e = '>' if be else '<'
+    n = len(parts); hdr = 4 + 4*(n+1)
+    at = (hdr + align - 1) // align * align
+    offs = []; body = bytearray()
+    for p in parts:
+        offs.append(at + len(body)); body += p; body += bytes(-len(body) % align)
+    offs.append(at + len(body))
+    out = bytearray(struct.pack(e+'I', n) + struct.pack(e+'%dI' % (n+1), *offs))
+    out += bytes(at - len(out)); out += body
+    return bytes(out)
+
+# ---- records (costume part 1, weapon part 2): u16 kind, u16 index, u32s; kind 0: 32 B, 1: 40 B
+REC = {0: 32, 1: 40}
+def records(x):
+    out = bytearray(x); at = 0; size = 32
+    while at + 4 <= len(x):
+        kind = struct.unpack_from('<H', x, at)[0]
+        size = REC.get(kind, size)
+        if at + size > len(x): size = len(x) - at
+        sw16(out, at, 2); sw32(out, at+4, (size-4)//4); at += size
+    return bytes(out)
+
+# ---- pre-fight lines (costume part 6): u32 columns, u32 lines, u32 offsets, NUL-terminated strings.
+# Little-endian on both. The Xbox has 6 strings per line (column 0 and 1 English, then German, French,
+# Spanish, Italian) under 0x10; the US GC has column 0 alone under 1.
+def dialogue(x, columns=6):
+    """Pre-fight lines -> the GC layout (u32 1, u32 n, n string offsets, strings). The PAL disc keeps six
+    columns under 0x10 (column 0 is English); the US disc already has the GC layout, zero-padded."""
+    cols, n = struct.unpack_from('<II', x, 0)
+    if columns == 1:
+        if cols != 1:
+            raise ValueError('dialogue header %#x, expected 1' % cols)
+        base = 8 + 4 * n
+        offs = struct.unpack_from('<%dI' % n, x, 8) if n else ()
+        end = base
+        for o in offs:
+            z = x.find(b'\0', base + o)
+            if base + o >= len(x) or z < 0:
+                raise ValueError('dialogue string offset %#x is past the end' % o)
+            end = max(end, z + 1)
+        if any(x[end:]):
+            raise ValueError('dialogue has data after its last string')
+        return x[:end]
+    if columns != 6:
+        raise ValueError('dialogue with %d columns is not supported' % columns)
+    if cols != 0x10:
+        raise ValueError('dialogue header %#x, expected 0x10' % cols)
+    offs = struct.unpack_from('<%dI' % (6 * n), x, 8)
+    base = 8 + 24 * n
+    strs = [x[base + o:x.index(b'\0', base + o) + 1] for o in offs[::6]]
+    at = [sum(len(t) for t in strs[:i]) for i in range(n)]
+    return struct.pack('<II', 1, n) + struct.pack('<%dI' % n, *at) + b''.join(strs)
+
+# ---- home-stage scene records (group 4, records 8-45): part 0 a motion bank, part 1 below, part 2 a
+# u32 table whose bytes 0x48-0x4F are four u16s, parts 7/8 sound containers.
+def scene_names(x):
+    """part 1: u32 sum, u32 table offset T, 8 bytes; 16-byte records (u16 x2, u32 x3; the last u32 is a
+    name offset) up to the first name; at T a u32 offset table whose first value / 4 is its length."""
+    out = bytearray(x); _, t = struct.unpack_from('<II', x, 0); sw32(out, 0, 2)
+    r, end = 0x10, t
+    while r + 16 <= end:
+        end = min(end, struct.unpack_from('<I', x, r + 12)[0])
+        sw16(out, r, 2); sw32(out, r + 4, 3); r += 16
+    sw32(out, t, struct.unpack_from('<I', x, t)[0] // 4)
+    return bytes(out)
+def scene_table(x):
+    out = bytearray(x); sw32(out, 0, 0x48 // 4); sw16(out, 0x48, 4); sw32(out, 0x50, (len(x) - 0x50) // 4)
+    return bytes(out)
+def scene(parts, sound, magic=b'mmx\0'):
+    """A whole record from its other-disc parts; `sound` converts a container with this `magic`."""
+    out = list(parts)
+    out[0] = bank(parts[0]); out[1] = scene_names(parts[1]); out[2] = scene_table(parts[2])
+    for k in range(3, len(out)):
+        if out[k]:
+            if out[k][:4] != magic:
+                raise ValueError('scene part %d is not a sound container' % k)
+            out[k] = sound(out[k])
+    return out
+
+# ---- motion bank
+def blocks_of(frames, flags):
+    if flags & 8: frames = (frames + 3)//4
+    elif flags & 4: frames = (frames + 1)//2
+    return (frames + 7)//8
+def motion(x):
+    out = bytearray(x)
+    if len(x) < 0x1c: return bytes(out)
+    frames, cb, flags = struct.unpack_from('<HHI', x, 0)
+    sw16(out, 0, 2); sw32(out, 4, 1); out[8:16] = x[8:16][::-1]; sw16(out, 0x10, 1)
+    nb = blocks_of(frames, flags)
+    sw16(out, 0x1c, nb)
+    pos = 0x1c
+    for step in struct.unpack_from('<%dh' % nb, x, 0x1c):
+        pos += step; sw16(out, pos, cb//2)
+    return bytes(out)
+def bank(x, pose=False):
+    if len(x) < 8: return bytes(x)
+    n = struct.unpack_from('<I', x, 0)[0]
+    offs = list(struct.unpack_from('<%dI' % n, x, 8)) + [len(x)]
+    out = bytearray(x)
+    if pose:  # Xbox keeps +0x18 (LE u16 on both) 0x20 higher
+        for o in offs[:-1]:
+            if o + 0x1a <= len(x):
+                v = struct.unpack_from('<H', x, o+0x18)[0]; struct.pack_into('<H', out, o+0x18, (v-0x20) & 0xffff)
+    src = bytes(out); out = bytearray(src)
+    sw32(out, 0, 2+n)
+    for i in range(n):
+        a, b = offs[i], offs[i+1]
+        if b > a: out[a:b] = motion(src[a:b])
+    return bytes(out)
+def moveset_tables(x):
+    n = struct.unpack_from('<I', x, 0)[0]
+    offs = struct.unpack_from('<%dI' % (n+1), x, 4)
+    out = bytearray(x); sw32(out, 0, n+2)
+    for p in range(n):
+        a, b = offs[p], offs[p+1]
+        if p == 0:
+            for r in range(a, b-59, 60): sw16(out, r+48, 6)
+        elif p == 1:
+            sw16(out, a, 2); sw32(out, a+4, 1)
+            for r in range(a+8, b-39, 40): sw16(out, r+16, 12)
+        else:
+            sw16(out, a, 4); sw32(out, a+8, (b-a-8)//4)
+    return bytes(out)
+def moveset(parts):
+    out = list(parts)
+    if out[1]: out[1] = bank(out[1])
+    if out[2]: out[2] = moveset_tables(out[2])
+    return out
