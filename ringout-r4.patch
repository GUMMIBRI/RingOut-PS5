+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace Core
+{
+class System;
+}
+
+// Guest characters on the US disc (see RecompGuestCore.h for what the archive is and why it lives in
+// <game>/guests/). This unit decides, once per boot, whether guests are on, and while they are, serves
+// their archive wherever the disc reads root.olk. Off -- the default whenever the data is missing or
+// stale -- nothing here touches the disc or guest RAM.
+namespace RecompGuestTables
+{
+struct Installed;
+}
+
+namespace RecompGuest
+{
+// Reads <game_root>/guests/guests.json and checks it against `root_sha1` (RecompGameData's hash
+// of the installed root.olk). Logs why when the data cannot be used. Call before any boot.
+void Initialize(const std::string& game_root, const std::string& root_sha1);
+
+bool IsAvailable();
+// The manifest's guests_sha1, or empty when unavailable: what two netplay peers compare.
+const std::string& GuestsHash();
+// Which guests the archive holds; none when unavailable.
+const RecompGuestTables::Installed& InstalledGuests();
+// The reason guests are unavailable, for the menu and the log.
+const std::string& Unavailable();
+
+// The installed guests' own opening movies (each disc's cut of the intro, copied by setup beside the
+// archive), Spawn's first: host paths of those present. Empty when guests are unavailable. The movie
+// player shows them in turn with the game's own; nothing else reads them.
+std::vector<std::string> IntroMovies();
+
+// Decided once, before boot. Ignored (stays off) when guests are not available.
+void SetSession(bool on);
+
+// The guests' code sites are gate groups 1 (both guests) and 2 (Heihachi's six), compiled into the
+// module only by setup.sh --spawn or --heihachi (a module without them costs every other US player
+// nothing). The module says which groups it has in its staticrecomp_gate_groups export. Guests stay
+// off without group 1, and without group 2 when Heihachi is installed (a module built for Spawn alone,
+// before Heihachi): their tables in RAM with no site ever firing hang or mis-select them.
+// Set before SetSession; nothing until set.
+inline constexpr std::uint32_t kSitesGateGroups = 1u << 1;
+inline constexpr std::uint32_t kHeihachiGateGroups = 1u << 2;
+void SetModuleGateGroups(std::uint32_t groups);
+// Whether a module with these gate groups has every code site the installed guests need.
+bool ModuleRunsGuests(std::uint32_t groups);
+bool ModuleHasSites();
+bool IsOn();
+
+// CPU thread, once per frame: writes the table rows once the DOL is in RAM (RecompGuestTables.h).
+// Nothing while off. RINGOUT_SPAWN_FORCE_ID=<id> (testing) also holds P1's default character.
+void OnFrame(Core::System& system);
+
+// True while guests are on AND their table rows are in RAM: only then does a decision at a code
+// site (RecompGuestTables.h kUsSites) need the hook. The run loop arms gate group 1 from this.
+bool SitesArmed();
+}  // namespace RecompGuest
diff --git a/ModernGekko/vendor/dolphin/Source/Core/Core/RecompGuestCore.h b/ModernGekko/vendor/dolphin/Source/Core/Core/RecompGuestCore.h
new file mode 100644
index 00000000..6cafc0ae
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/Core/RecompGuestCore.h
@@ -0,0 +1,238 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+// Guest characters -- the parts with no Dolphin dependency, so tests can reach them.
+//
+// Guests come from the player's own discs: Spawn (29) from the Xbox disc, Heihachi (28) from the PS2
+// disc. Their data is a second archive, built by tools/guests/build_guests.py: the GC US root.olk plus
+// each guest's block appended to group 4 and its ending art in record 2/(57 + ID). It lives OUTSIDE the
+// disc tree, in <game>/guests/, because every file under <game>/files/ becomes a file on the virtual
+// disc -- with it there, the disc's file table would change even with guests off.
+//
+// The manifest beside it is written last by the builder and is the only thing trusted: an archive
+// is used only when its manifest says it was built from THIS root.olk (SHA-1 as RecompGameData
+// computes it) for this disc, and its size matches. Anything else turns guests off and says why.
+
+#include <cstdint>
+#include <filesystem>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include <picojson.h>
+
+namespace RecompGuestCore
+{
+constexpr std::uint64_t kNoFile = std::numeric_limits<std::uint64_t>::max();
+
+// One guest's rows of the executable's per-character tables, converted from the player's own disc by
+// the builder. Where they go, and the check before writing: RecompGuestTables.h.
+struct GuestTables
+{
+  std::uint8_t id = 0;
+  std::uint16_t block = 0;  // first group-4 record of the block in root-guests.olk
+  std::uint8_t roster = 0;
+  std::uint8_t voice = 0;  // 1 = English voice slots (34-36)
+  std::vector<std::uint8_t> costume;     // 6 bytes
+  std::vector<std::uint8_t> descriptor;  // 0xF8 bytes, GC byte order, pointers into the string area
+  std::vector<std::uint8_t> strings;     // 1..the guest's room
+  std::vector<std::uint8_t> cell;        // 36-byte select-grid cell record; starts with the ID
+  // The ending row (illustration entry, pages, text index) and the bytes the DOL ships there (-1s).
+  std::vector<std::uint8_t> ending, ending_old;  // 8 bytes each
+  // A kerned name string padded to 36 bytes. Empty when the DOL already holds the guest's string.
+  std::vector<std::uint8_t> name;
+  // The weapon-select preview pose: 28-byte bone records (u32 parent, xyz, rotation), GC byte order.
+  std::vector<std::uint8_t> preview;
+};
+
+struct Manifest
+{
+  std::string disc;
+  std::string gc_root_sha1;
+  std::string sha1;
+  std::string guests_sha1;  // what netplay peers compare
+  std::uint64_t size = 0;
+  // Character pools (opponent lists) repacked with every guest, the pointer table that reaches them,
+  // and the shipped bytes of both from the player's DOL (what the runtime checks before writing).
+  std::vector<std::uint8_t> pool_block, pool_table, pool_block_old, pool_table_old;  // 0xF8, 0xAC
+  std::vector<GuestTables> guests;
+};
+
+inline bool ParseHex(const std::string& text, std::vector<std::uint8_t>* out)
+{
+  if (text.size() % 2)
+    return false;
+  auto nib = [](char c) {
+    return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+  };
+  out->clear();
+  for (std::size_t i = 0; i < text.size(); i += 2)
+  {
+    const int hi = nib(text[i]), lo = nib(text[i + 1]);
+    if (hi < 0 || lo < 0)
+      return false;
+    out->push_back(static_cast<std::uint8_t>(hi * 16 + lo));
+  }
+  return true;
+}
+
+// Hex field `k` of object `o`, between `lo` and `hi` bytes.
+inline bool ParseHexField(const picojson::object& o, const char* k, std::size_t lo, std::size_t hi,
+                          std::vector<std::uint8_t>* out)
+{
+  auto it = o.find(k);
+  return it != o.end() && it->second.is<std::string>() && ParseHex(it->second.get<std::string>(), out) &&
+         out->size() >= lo && out->size() <= hi;
+}
+
+constexpr std::size_t kMaxStrings = 0x80, kPreviewRecord = 28, kMaxPreview = 2 * kPreviewRecord;
+
+inline bool ParseGuest(const picojson::value& v, GuestTables* t)
+{
+  if (!v.is<picojson::object>())
+    return false;
+  const picojson::object& o = v.get<picojson::object>();
+  auto num = [&](const char* k, double lo, double hi, double* d) {
+    auto it = o.find(k);
+    if (it == o.end() || !it->second.is<double>())
+      return false;
+    *d = it->second.get<double>();
+    return *d >= lo && *d <= hi && *d == static_cast<double>(static_cast<long long>(*d));
+  };
+  auto hex = [&](const char* k, std::size_t lo, std::size_t hi, std::vector<std::uint8_t>* out) {
+    return ParseHexField(o, k, lo, hi, out);
+  };
+  double id = 0, block = 0, roster = 0, voice = 0;
+  if (!num("id", 28, 29, &id) || !num("block", 1, 65535, &block) || !num("roster", 0, 255, &roster) ||
+      !num("voice", 0, 1, &voice) || !hex("costume", 6, 6, &t->costume) ||
+      !hex("descriptor", 0xF8, 0xF8, &t->descriptor) || !hex("strings", 1, id == 29 ? 0x38 : kMaxStrings, &t->strings) ||
+      !hex("cell", 36, 36, &t->cell) || t->cell[0] != 0 || t->cell[1] != id ||
+      !hex("ending", 8, 8, &t->ending) || !hex("ending_old", 8, 8, &t->ending_old) ||
+      !hex("preview", kPreviewRecord, kMaxPreview, &t->preview) || t->preview.size() % kPreviewRecord != 0)
+    return false;
+  if (id == 29 && !hex("name", 36, 36, &t->name))  // only Spawn: the DOL still holds Heihachi's string
+    return false;
+  t->id = static_cast<std::uint8_t>(id);
+  t->block = static_cast<std::uint16_t>(block);
+  t->roster = static_cast<std::uint8_t>(roster);
+  t->voice = static_cast<std::uint8_t>(voice);
+  return true;
+}
+
+enum class Check
+{
+  Ok,
+  BadManifest,   // missing, unreadable or an unknown format
+  OldFormat,     // a Spawn-only build from before the guest list
+  WrongDisc,     // built for another region
+  BaseMismatch,  // built from a different root.olk (e.g. one with skins installed since)
+  NoArchive,
+  SizeMismatch,  // archive cut short or replaced
+};
+
+inline const char* Describe(Check c)
+{
+  switch (c)
+  {
+  case Check::Ok: return "ok";
+  case Check::BadManifest: return "no readable guests/guests.json";
+  case Check::OldFormat: return "this Spawn install is from an older version (rebuild guests: rerun setup)";
+  case Check::WrongDisc: return "guest data was built for a different disc";
+  case Check::BaseMismatch: return "root.olk changed since the guests were built (rebuild guests)";
+  case Check::NoArchive: return "guests/root-guests.olk is missing";
+  case Check::SizeMismatch: return "guests/root-guests.olk is incomplete";
+  }
+  return "?";
+}
+
+inline std::string ManifestPath(const std::string& game_root) { return game_root + "/guests/guests.json"; }
+inline std::string ArchivePath(const std::string& game_root) { return game_root + "/guests/root-guests.olk"; }
+// Where a Spawn-only install from before the guest list keeps its manifest.
+inline std::string OldManifestPath(const std::string& game_root) { return game_root + "/spawn/root-spawn.json"; }
+inline std::string RootOlkPath(const std::string& game_root) { return game_root + "/files/root.olk"; }
+
+// `root_sha1`: RecompGameData's hash of the installed root.olk. `archive_size`: the archive's size,
+// or kNoFile when it does not exist.
+inline Check Validate(const std::string& manifest_text, const std::string& root_sha1,
+                      std::uint64_t archive_size, Manifest* out)
+{
+  picojson::value v;
+  if (manifest_text.empty() || !picojson::parse(v, manifest_text).empty() || !v.is<picojson::object>())
+    return Check::BadManifest;
+  const picojson::object& o = v.get<picojson::object>();
+  auto str = [&](const char* k) -> const std::string* {
+    auto it = o.find(k);
+    return it != o.end() && it->second.is<std::string>() ? &it->second.get<std::string>() : nullptr;
+  };
+  auto num = [&](const char* k, double* d) {
+    auto it = o.find(k);
+    if (it == o.end() || !it->second.is<double>())
+      return false;
+    *d = it->second.get<double>();
+    return true;
+  };
+  double format = 0, size = 0;
+  const std::string *disc = str("disc"), *base = str("gc_root_sha1"), *sha1 = str("sha1"),
+                    *hash = str("guests_sha1");
+  if (num("format", &format) && format == 1)
+    return Check::OldFormat;
+  if (format != 2 || !num("size", &size) || !disc || !base || !sha1 || !hash)
+    return Check::BadManifest;
+  Manifest m;
+  if (!ParseHexField(o, "pool_block", 0xF8, 0xF8, &m.pool_block) ||
+      !ParseHexField(o, "pool_table", 0xAC, 0xAC, &m.pool_table) ||
+      !ParseHexField(o, "pool_block_old", 0xF8, 0xF8, &m.pool_block_old) ||
+      !ParseHexField(o, "pool_table_old", 0xAC, 0xAC, &m.pool_table_old))
+    return Check::BadManifest;
+  auto g = o.find("guests");
+  if (g == o.end() || !g->second.is<picojson::array>() || g->second.get<picojson::array>().empty())
+    return Check::BadManifest;
+  for (const picojson::value& entry : g->second.get<picojson::array>())
+  {
+    GuestTables t;
+    if (!ParseGuest(entry, &t))
+      return Check::BadManifest;
+    for (const GuestTables& seen : m.guests)
+      if (seen.id == t.id)
+        return Check::BadManifest;
+    m.guests.push_back(std::move(t));
+  }
+  if (*disc != "GRSEAF")
+    return Check::WrongDisc;
+  if (*base != root_sha1)
+    return Check::BaseMismatch;
+  if (archive_size == kNoFile)
+    return Check::NoArchive;
+  if (static_cast<std::uint64_t>(size) != archive_size)
+    return Check::SizeMismatch;
+  m.disc = *disc;
+  m.gc_root_sha1 = *base;
+  m.sha1 = *sha1;
+  m.guests_sha1 = *hash;
+  m.size = archive_size;
+  *out = std::move(m);
+  return Check::Ok;
+}
+
+// The host file that backs a disc file: the archive in place of <game_root>/files/root.olk while
+// guests are on, the file itself otherwise. Paths compare after lexical normalisation, so "//" and "./"
+// in either do not matter, and only the game's OWN top-level root.olk ever switches.
+inline std::string Resolve(const std::string& host_path, bool on, const std::string& game_root)
+{
+  if (!on)
+    return host_path;
+  // Compare absolute paths: `--game game-sp9` is relative while the disc may open an absolute path
+  // (or the reverse). A miss serves the stock archive under the guests' tables, and the select screen hangs.
+  std::error_code ec;
+  const auto abs = [&ec](const std::string& p) {
+    const std::filesystem::path a = std::filesystem::absolute(p, ec);
+    return (ec ? std::filesystem::path(p) : a).lexically_normal();
+  };
+  const std::filesystem::path root = abs(game_root);
+  if (abs(host_path) != (root / "files" / "root.olk").lexically_normal())
+    return host_path;
+  return (root / "guests" / "root-guests.olk").lexically_normal().string();
+}
+}  // namespace RecompGuestCore
diff --git a/ModernGekko/vendor/dolphin/Source/Core/Core/RecompGuestTables.h b/ModernGekko/vendor/dolphin/Source/Core/Core/RecompGuestTables.h
new file mode 100644
index 00000000..154e1908
--- /dev/null
+++ b/ModernGekko/vendor/dolphin/Source/Core/Core/RecompGuestTables.h
@@ -0,0 +1,692 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+// Guest rows in the US executable's per-character tables (tools/spawn/MAP.md, "Per-character tables").
+// The GC DOL keeps slots for characters 28 and 29 in each table and leaves them empty; the bytes that
+// fill them come from the player's own discs, through the manifest, never from this source.
+//
+// Every slot is checked against what this DOL ships before anything is written, and the writes are all
+// or nothing: another build of the game, or RAM someone else already changed, gets no writes at all.
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <vector>
+
+#include "RecompGuestCore.h"
+
+namespace RecompGuestTables
+{
+constexpr std::uint32_t kDescAddr = 0x80275A60, kDescStride = 0xF8;  // 0xF8-byte descriptor per ID
+constexpr std::uint32_t kCostumeAddr = 0x80279484;  // 6 bytes per ID, read by the check at 800A8E04
+constexpr std::uint32_t kRosterAddr = 0x80250958;   // 1 byte per ID
+constexpr std::uint32_t kBlockAddr = 0x80277A58;    // s16 per ID: first group-4 record of the block
+// His extra data lives in the all-zero descriptor rows of IDs 7 and 8, in bytes that are not pointer
+// slots. Row 28 and the shipped name strings of 28 and 29 stay untouched: ID 28 is Heihachi's.
+constexpr std::uint32_t kSpawnHome = kDescAddr + 7 * kDescStride;
+constexpr std::uint32_t kStringsAddr = kSpawnHome + 0xC0, kStringsSize = 0x38;
+// Link's model ID in his descriptor: 27 once the DOL is in RAM, before then the apploader's bytes.
+constexpr std::uint32_t kLinkIdField = kDescAddr + 27 * kDescStride + 0x86;
+constexpr std::uint32_t kSpawnId = 29, kHeihachiId = 28;
+// Select grid: 36-byte cell records, rows of 4 plus a -1 end marker (index = row * 5 + col), set up by
+// the code at 80149B60. Spawn's cell is the free 5th slot of Link's row, cell 4, drawn right of the frame;
+// Heihachi's is the free 5th slot of the next row, cell 9.
+constexpr std::uint32_t kCellAddr = 0x80250520, kCellStride = 36, kSpawnCell = 4, kHeihachiCell = 9;
+// Character pools: 255-terminated ID lists (opponent pools) in one block, reached through a table of
+// 43 pointers. GC lists carry Link (27) where the Xbox's carry Spawn; the manifest's block adds 29
+// beside 27 and its table follows the lists to their new places (tools/spawn/tables.py).
+constexpr std::uint32_t kPoolAddr = 0x8028B50C, kPoolSize = 0xF8;
+constexpr std::uint32_t kPoolTableAddr = 0x8028B604, kPoolTableSize = 43 * 4;
+// Endings, 8 bytes per ID: s16 illustration entry (group 2), s16 page count, u32 text index. GC ships
+// -1s for 29; the ending then asks the size of entry -1, gets the whole group's, and its next buffer
+// lands past the end of RAM (a crash after the final fight). His row is the Xbox's (tables.py).
+constexpr std::uint32_t kEndingAddr = 0x802A3748, kEndingStride = 8;
+// English voice, a byte per ID: when set and the voice language is English, 80098A04 moves a voice
+// slot from 30-32 to 34-36. GC ships 0 for 29 (the dummy), so he spoke Japanese; the Xbox has 1.
+constexpr std::uint32_t kVoiceAddr = 0x80277A9C;
+// Names, a pointer per ID to the kerned string the VS screen and HUD draw. GC 29 points at the dummy's
+// "Q.TAKAGI" (0x8028ED7C). His Xbox string goes in empty descriptor row 8 and pointer 29 moves to it.
+constexpr std::uint32_t kNameTableAddr = 0x8028E9D8, kNameOld = 0x8028ED7C;
+constexpr std::uint32_t kNameAt = kDescAddr + 8 * kDescStride + 0xC0;
+constexpr std::size_t kNameRoom = 36;
+// Weapon-select preview pose, per ID {u32 count, u32 pointer} to 28-byte bone records that 8017E998
+// applies to the preview model each frame. GC ships count 0 for 29, so the preview kept the matrices its
+// setup parks at y = 100 (800A3D98) and his weapon never showed. His Xbox record goes in 28 unused bytes
+// of empty descriptor row 7 (no pointer slots, clear of the string area at +0xC0).
+constexpr std::uint32_t kPreviewTable = 0x80251904, kPreviewHome = kSpawnHome + 0x64;
+constexpr std::size_t kPreviewRec = 28;
+
+using ReadFn = std::function<std::uint8_t(std::uint32_t)>;
+using WriteFn = std::function<void(std::uint32_t, std::uint8_t)>;
+
+struct SpawnPatch
+{
+  std::uint32_t addr;
+  std::vector<std::uint8_t> expect;  // what the shipped DOL holds there
+  std::vector<std::uint8_t> bytes;
+  const char* what;
+};
+
+inline std::vector<std::uint8_t> Be32(std::uint32_t v)
+{
+  return {static_cast<std::uint8_t>(v >> 24), static_cast<std::uint8_t>(v >> 16),
+          static_cast<std::uint8_t>(v >> 8), static_cast<std::uint8_t>(v)};
+}
+
+inline std::vector<std::uint8_t> CellEndMarker()
+{
+  std::vector<std::uint8_t> v(kCellStride, 0);
+  v[0] = v[1] = 0xff;
+  return v;
+}
+
+// Where each guest's rows go. ID 28 keeps his shipped name string and his own descriptor row, so his
+// other data goes in empty rows too: strings in row 9 from +0x64 (no pointer slots from there on), the
+// two preview records in the tail of row 10.
+constexpr std::uint32_t kHeihachiStrings = kDescAddr + 9 * kDescStride + 0x64;
+constexpr std::uint32_t kHeihachiStringsSize = 0x80;
+constexpr std::uint32_t kHeihachiPreview = kDescAddr + 10 * kDescStride + 0xC0;
+
+struct GuestSlot
+{
+  std::uint32_t id;
+  std::uint32_t cell;
+  std::uint32_t code;  // past the game's 24, see "Character codes" below
+  std::uint32_t strings_addr, strings_size;
+  std::uint32_t preview_addr;
+};
+inline constexpr GuestSlot kGuests[] = {
+    {kSpawnId, kSpawnCell, 24, kStringsAddr, kStringsSize, kPreviewHome},
+    {kHeihachiId, kHeihachiCell, 25, kHeihachiStrings, kHeihachiStringsSize, kHeihachiPreview},
+};
