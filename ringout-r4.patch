+    bank_x = put(b'', 0x20); w.extend(b'VXT.' + bytes(0x10) + bytes(0x24 * len(images)))
+    stamp_new = put(P[stamp:stamp + 0x28]); names_new = len(w); w.extend(P[stamp + 0x28:])
+    delta = names_new - (stamp + 0x28)
