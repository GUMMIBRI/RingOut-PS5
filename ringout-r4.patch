diff --git a/tools/gc_motion.py b/tools/gc_motion.py
new file mode 100644
index 00000000..9d9e83e7
--- /dev/null
+++ b/tools/gc_motion.py
@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Endian conversion for SC2 motion and one-frame pose banks.
+
+Adapted from C:/SC2/tools/guests/motion.py, SPDX GPL-3.0-or-later,
+which documents the GameCube/Xbox format and shared-character comparisons.
+Conversion is in memory only; the caller owns archive operations. Source byte
+order is explicit: 'big' (GameCube) or 'little' (Xbox).
+"""
+import struct
+
+
+def _order(source):
+    if source == 'big':
+        return '>'
+    if source == 'little':
+        return '<'
+    raise ValueError("source must be 'big' or 'little'")
+
+
+def motion_blocks(frames, flags):
+    if flags & 8:
+        frames = (frames + 3) // 4
+    elif flags & 4:
+        frames = (frames + 1) // 2
+    return (frames + 7) // 8
+
+
+def _swap(out, offset, width, count=1):
+    for p in range(offset, offset + width * count, width):
+        out[p:p + width] = out[p:p + width][::-1]
+
+
+def convert_motion(data, source):
+    """Convert a single motion to the opposite byte order, preserving padding."""
+    endian = _order(source)
+    data = bytes(data)
+    if len(data) < 0x1c:
+        raise ValueError('truncated motion header')
+    frames, channel_bytes, flags = struct.unpack_from(endian + 'HHI', data)
+    if channel_bytes % 2:
+        raise ValueError('odd channel byte count')
+    count = motion_blocks(frames, flags)
+    table_end = 0x1c + 2 * count
+    if table_end > len(data):
+        raise ValueError('truncated motion block table')
+    steps = struct.unpack_from(endian + str(count) + 'h', data, 0x1c)
+    positions = []
+    position = 0x1c
+    previous_end = table_end
+    for step in steps:
+        position += step
+        if position < previous_end or position + channel_bytes > len(data):
+            raise ValueError('motion block overlaps header/table or previous block, or is outside motion')
+        positions.append(position)
+        previous_end = position + channel_bytes
+    out = bytearray(data)
+    _swap(out, 0, 2, 2)
+    _swap(out, 4, 4)
+    _swap(out, 8, 8)
+    _swap(out, 0x10, 2)
+    _swap(out, 0x1c, 2, count)
+    for position in positions:
+        _swap(out, position, 2, channel_bytes // 2)
+    return bytes(out)
+
+
+def _bank_offsets(data, source):
+    endian = _order(source)
+    if len(data) < 8:
+        raise ValueError('truncated bank header')
+    count = struct.unpack_from(endian + 'I', data)[0]
+    if count > (len(data) - 8) // 4:
+        raise ValueError('bank count exceeds offset table')
+    table_end = 8 + 4 * count
+    offsets = list(struct.unpack_from(endian + str(count) + 'I', data, 8))
+    previous = table_end
+    for offset in offsets:
+        if offset < previous or offset > len(data):
+            raise ValueError('bank offsets are nonmonotone or outside bank')
+        previous = offset
+    return offsets + [len(data)]
+
+
+def convert_bank(data, source):
+    """Convert an entire bank to opposite order; empty entries are retained."""
+    data = bytes(data)
+    offsets = _bank_offsets(data, source)
+    out = bytearray(data)
+    _swap(out, 0, 4, len(offsets) + 1)
+    for a, b in zip(offsets, offsets[1:]):
+        if a != b:
+            out[a:b] = convert_motion(data[a:b], source)
+    return bytes(out)
+
+
+def convert_pose_bank(data, source):
+    """Convert a one-frame pose bank, adjusting the platform-specific +0x18 field.
+
+    The field is little-endian on both platforms, regardless of source order.
+    Only observed non-wrapping +0x20 values are accepted.
+    """
+    data = bytes(data)
+    endian = _order(source)
+    offsets = _bank_offsets(data, source)
+    adjustments = []
+    for a, b in zip(offsets, offsets[1:]):
+        if a == b:
+            continue
+        if b - a < 0x1c or struct.unpack_from(endian + 'H', data, a)[0] != 1:
+            raise ValueError('unrecognized pose: expected a one-frame motion')
+        value = struct.unpack_from('<H', data, a + 0x18)[0]
+        if source == 'little':
+            if value < 0x20:
+                raise ValueError('unrecognized Xbox pose field below 0x20')
+            value -= 0x20
+        else:
+            if value > 0xffff - 0x20:
+                raise ValueError('GameCube pose field would overflow')
+            value += 0x20
+        adjustments.append((a + 0x18, value))
+    out = bytearray(convert_bank(data, source))
+    for offset, value in adjustments:
+        struct.pack_into('<H', out, offset, value)
+    return bytes(out)
+
+
+def convert_moveset_tables(data, source):
+    """Convert the numbered table pack within moveset part 2.
+
+    Trailing incomplete records and camera words are padding and are retained.
+    """
+    data = bytes(data)
+    endian = _order(source)
+    if len(data) < 8:
+        raise ValueError('truncated moveset table header')
+    count = struct.unpack_from(endian + 'I', data)[0]
+    if count > (len(data) - 8) // 4:
+        raise ValueError('moveset table count exceeds offset table')
+    offsets = struct.unpack_from(endian + str(count + 1) + 'I', data, 4)
+    previous = 4 * (count + 2)
+    for offset in offsets:
+        if offset < previous or offset > len(data):
+            raise ValueError('moveset table offsets are nonmonotone or outside pack')
+        previous = offset
+    out = bytearray(data)
+    _swap(out, 0, 4, count + 2)
+    for part, (start, end) in enumerate(zip(offsets, offsets[1:])):
+        if part == 0:
+            for record in range(start, end - 59, 60):
+                _swap(out, record + 48, 2, 6)
+        elif part == 1:
+            if end - start < 8:
+                raise ValueError('moveset part 1 header is truncated')
+            _swap(out, start, 2, 2)
+            _swap(out, start + 4, 4)
+            for record in range(start + 8, end - 39, 40):
+                _swap(out, record + 16, 2, 12)
+        else:
+            if end - start < 8:
+                raise ValueError('camera track header is truncated')
+            _swap(out, start, 2, 4)
+            _swap(out, start + 8, 4, (end - start - 8) // 4)
+    return bytes(out)
+
+
+def convert_moveset(parts, source):
+    """Convert populated bank/table parts while preserving other pack entries."""
+    _order(source)
+    out = list(parts)
+    if len(out) > 1 and out[1]:
+        out[1] = convert_bank(out[1], source)
+    if len(out) > 2 and out[2]:
+        out[2] = convert_moveset_tables(out[2], source)
+    return out
+
+
+def convert_moveset_pack(data, source):
+    """Convert a numbered moveset pack in place within its original extents.
+
+    The returned bytes retain header padding, part boundaries, and bytes after
+    the final part. No target-loader alignment guarantees are implied.
+    """
+    endian = _order(source)
+    data = bytes(data)
+    if len(data) < 8:
+        raise ValueError('truncated moveset pack header')
+    count = struct.unpack_from(endian + 'I', data)[0]
+    if count == 0 or count > 4096 or count > (len(data) - 8) // 4:
+        raise ValueError('invalid moveset pack count or truncated offset table')
+    offsets = struct.unpack_from(endian + str(count + 1) + 'I', data, 4)
+    previous = 4 * (count + 2)
+    for offset in offsets:
+        if offset < previous or offset > len(data):
+            raise ValueError('moveset pack offsets are nonmonotone or outside pack')
+        previous = offset
+    parts = [data[a:b] for a, b in zip(offsets, offsets[1:])]
+    converted = convert_moveset(parts, source)
+    if len(converted) != count or any(len(x) != len(y) for x, y in zip(parts, converted)):
+        raise ValueError('moveset conversion changed part sizes')
+    out = bytearray(data)
+    _swap(out, 0, 4, count + 2)
+    for a, b, part in zip(offsets, offsets[1:], converted):
+        out[a:b] = part
+    return bytes(out)
+
+
+def gamecube_to_xbox_motion(data): return convert_motion(data, 'big')
+def xbox_to_gamecube_motion(data): return convert_motion(data, 'little')
+def gamecube_to_xbox_bank(data): return convert_bank(data, 'big')
+def xbox_to_gamecube_bank(data): return convert_bank(data, 'little')
+def gamecube_to_xbox_pose_bank(data): return convert_pose_bank(data, 'big')
+def xbox_to_gamecube_pose_bank(data): return convert_pose_bank(data, 'little')
+def gamecube_to_xbox_moveset_tables(data): return convert_moveset_tables(data, 'big')
+def xbox_to_gamecube_moveset_tables(data): return convert_moveset_tables(data, 'little')
+def gamecube_to_xbox_moveset(parts): return convert_moveset(parts, 'big')
+def xbox_to_gamecube_moveset(parts): return convert_moveset(parts, 'little')
+def gamecube_to_xbox_moveset_pack(data): return convert_moveset_pack(data, 'big')
+def xbox_to_gamecube_moveset_pack(data): return convert_moveset_pack(data, 'little')
diff --git a/tools/gc_texture.py b/tools/gc_texture.py
new file mode 100644
index 00000000..3e3a9161
--- /dev/null
+++ b/tools/gc_texture.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Single-image DXT1/CMPR conversion; layout informed by GPL-3.0-or-later
+C:/SC2/tools/guests/textures.py, cmpr_blocks and _reverse_pairs.
+
+DXT1 is row-major 4x4 blocks; CMPR stores four blocks per 8x8 tile in
+TL, TR, BL, BR order. Missing whole edge blocks are zero-filled; texels
+outside the image within a present block are preserved verbatim.
+"""
+
+
+def _sizes(width, height):
+    # GX TEX_IMAGE0 stores each dimension minus one in ten bits.
+    if any(type(v) is not int or not 1 <= v <= 1024 for v in (width, height)):
+        raise ValueError('width and height must be integers from 1 through 1024')
+    bw, bh = (width + 3) // 4, (height + 3) // 4
+    return bw, bh, bw * bh * 8, ((bw + 1) // 2) * ((bh + 1) // 2) * 32
+
+
+def _reverse_pairs(value):
+    return ((value & 3) << 6) | ((value & 12) << 2) | ((value & 48) >> 2) | ((value & 192) >> 6)
+
+
+def _convert_block(block):
+    # Endpoint byte swap and row index reversal are involutions.
+    return bytes((block[1], block[0], block[3], block[2],
+                  *(_reverse_pairs(x) for x in block[4:8])))
+
+
+def _convert(data, width, height, to_cmpr):
+    bw, bh, dxt_size, cmpr_size = _sizes(width, height)
+    if not isinstance(data, (bytes, bytearray, memoryview)):
+        raise TypeError('data must be bytes-like')
+    size = data.nbytes if isinstance(data, memoryview) else len(data)
+    if size != (dxt_size if to_cmpr else cmpr_size):
+        raise ValueError('incorrect image data length')
+    # Reject oversized input before copying; memoryviews can have non-byte
+    # elements, so their element count is not their encoded image size.
+    data = bytes(data)
+    out = bytearray(cmpr_size if to_cmpr else dxt_size)
+    tile_offset = 0
+    for ty in range(0, bh, 2):
+        for tx in range(0, bw, 2):
+            for sub in range(4):
+                bx, by = tx + (sub & 1), ty + (sub >> 1)
+                if bx < bw and by < bh:
+                    linear = (by * bw + bx) * 8
+                    source, dest = (linear, tile_offset) if to_cmpr else (tile_offset, linear)
+                    out[dest:dest + 8] = _convert_block(data[source:source + 8])
+                tile_offset += 8
+    return bytes(out)
+
+
+def dxt1_to_cmpr(data, width, height):
+    """Convert exactly one DXT1 image, filling absent tile blocks with zero."""
+    return _convert(data, width, height, True)
+
+
+def cmpr_to_dxt1(data, width, height):
+    """Convert exactly one CMPR image, ignoring whole tile padding blocks."""
+    return _convert(data, width, height, False)
diff --git a/tools/guests/build_guests.py b/tools/guests/build_guests.py
new file mode 100644
index 00000000..1dca0184
--- /dev/null
+++ b/tools/guests/build_guests.py
@@ -0,0 +1,102 @@
+"""Build root-guests.olk (the GC US root.olk plus every guest) and its manifest guests.json.
+
+Each guest's block is appended to group 4 in a fixed order (Spawn first when present), his home-stage
+scene goes in empty group 4 records, his ending art in empty record 2/(57 + ID), and his portraits and
+silhouettes are appended to the banks. The manifest is written last, after the archive is complete and
+renamed into place, so a build that stops part-way never leaves a manifest the runtime would trust."""
+import hashlib, json, os, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from olk import Olk
+import olkw, tables, ui
+
+GRSEAF_ROOT_SHA1 = '7ee2f6663e5b2386a2008d20428363763843677e'
+GC_FIRST_RECORD = 982   # group 4's first free record on GC
+BLOCK_RECORDS = 39
+ARCHIVE, MANIFEST = 'root-guests.olk', 'guests.json'
+_HERE = os.path.dirname(os.path.abspath(__file__))
+SOURCE_DIRS = tuple(os.path.join(_HERE, '..', d) for d in ('guests', 'spawn', 'heihachi'))
+
+
+def _sha1_file(path):
+    h = hashlib.sha1()
+    with open(path, 'rb') as f:
+        for c in iter(lambda: f.read(1 << 24), b''): h.update(c)
+    return h.hexdigest()
+
+
+def _converter_version(src_dir=None):
+    """sha1 over the converter's own sources (top-level *.py and *.c in each folder, sorted by name): what
+    an "already built" check compares. No git: a player's install has none."""
+    h = hashlib.sha1()
+    for d in ((src_dir,) if src_dir else SOURCE_DIRS):
+        if not os.path.isdir(d): continue
+        for n in sorted(os.listdir(d)):
+            p = os.path.join(d, n)
+            if n.endswith(('.py', '.c')) and os.path.isfile(p):
+                h.update(n.encode() + b'\0')
+                with open(p, 'rb') as f: h.update(f.read())
+    return h.hexdigest()
+
+
+def _rows(g, block, cell):
+    t = g.tables
+    m = {'id': g.id, 'block': block, 'roster': t['roster'], 'voice': t['voice'], 'costume': t['costume'].hex(),
+         'descriptor': t['descriptor'].hex(), 'strings': t['strings'].hex(), 'cell': cell.hex(),
+         'ending': t['ending'].hex(), 'ending_old': t['ending_old'].hex(), 'preview': t['preview'].hex(),
+         'source': g.sources}
+    if t.get('name'): m['name'] = t['name'].hex()
+    return m
+
+
+def build(guests, gc, out_dir, dol):
+    """Write out_dir/root-guests.olk and out_dir/guests.json; return the manifest dict. ValueError, with
+    nothing left behind, when a record a guest needs is taken or two guests want the same one."""
+    guests = sorted(guests, key=lambda g: -g.id)
+    if not guests: raise ValueError('no guests to build')
+    archive, stage, manifest = (os.path.join(out_dir, n) for n in (ARCHIVE, '.' + ARCHIVE + '.stage1', MANIFEST))
+    try:
+        g = Olk(gc)
+        if len(g.group(4)[1]) != GC_FIRST_RECORD:
+            raise ValueError('group 4 has %d records, expected %d' % (len(g.group(4)[1]), GC_FIRST_RECORD))
+        scenes = {}
+        for s in guests:
+            for r, e in s.scenes.items():
+                if r in scenes: raise ValueError('two guests want group 4 record %d' % r)
+                if g.entry(4, r): raise ValueError('group 4 record %d is not empty on this disc' % r)
+                scenes[r] = e
+        appended, faces, sils, camera, group2, rows = [], g.entry(*ui.FACE_ENTRY), g.entry(*ui.SILHOUETTE_ENTRY), \
+            g.entry(*ui.PROFILE_CAMERA), {}, []
+        faces, face_indices = ui.guest_face_bank(faces, [s.faces for s in guests])
+        for k, (s, indices) in enumerate(zip(guests, face_indices, strict=True)):
+            art_at = ui.ENDING_ART_BASE + s.id
+            if g.entry(2, art_at): raise ValueError('group 2 record %d is not empty on this disc' % art_at)
+            group2[art_at] = s.ending_art
+            sils, sfirst = ui.append_textures(sils, ui.SILHOUETTE_PART, s.silhouettes)
+            camera = s.camera(camera)
+            cell = tables.cell_with_faces(s.tables['cell'], indices)
+            cell = tables.cell_with_silhouettes(cell, range(sfirst, sfirst + len(s.silhouettes)), s.tables['xcell'])
+            appended += [s.block.get(i, b'') for i in range(BLOCK_RECORDS)]
+            rows.append(_rows(s, GC_FIRST_RECORD + k * BLOCK_RECORDS, cell))
+        pools = tables.pools(tables.Dol(dol), {s.id: s.pool_lists for s in guests})
+        group2.update({ui.FACE_ENTRY[1]: faces, ui.PROFILE_CAMERA[1]: camera, ui.SILHOUETTE_ENTRY[1]: sils})
+        olkw.write(gc, stage, 4, scenes, append=appended)
+        olkw.write(stage, archive, 2, group2)
+        os.remove(stage)
+        h = hashlib.sha1()
+        for d in appended + [scenes[r] for r in sorted(scenes)] + [group2[r] for r in sorted(group2)] + \
+                [pools['pool_block'], pools['pool_table']]: h.update(d)
+        for r in rows: h.update(json.dumps({k: v for k, v in r.items() if k != 'source'}, sort_keys=True).encode())
+        m = {'format': 2, 'disc': 'GRSEAF', 'converter': _converter_version(), 'gc_root_sha1': GRSEAF_ROOT_SHA1,
+             'sha1': _sha1_file(archive), 'size': os.path.getsize(archive), 'guests_sha1': h.hexdigest(),
+             'edits': [{'group': 4, 'append_first': GC_FIRST_RECORD, 'count': len(appended)},
+                       *({'group': 4, 'replace': r} for r in sorted(scenes)),
+                       *({'group': 2, 'replace': r} for r in sorted(group2))],
+             **{k: v.hex() for k, v in pools.items()}, 'guests': rows}
+        # newline: the same bytes on every host (Windows would write CRLF).
+        with open(manifest + '.tmp', 'w', newline='\n') as f: json.dump(m, f, indent=1)
+        os.replace(manifest + '.tmp', manifest)
+        return m
+    except BaseException:
+        for p in (stage, stage + '.tmp', archive, archive + '.tmp', manifest + '.tmp', manifest):
+            if os.path.exists(p): os.remove(p)
+        raise
diff --git a/tools/guests/dspenc.c b/tools/guests/dspenc.c
new file mode 100644
index 00000000..046872aa
--- /dev/null
+++ b/tools/guests/dspenc.c
@@ -0,0 +1,87 @@
+/* GameCube DSP-ADPCM encoder for the Spawn converter (tools/spawn/sndconv.py).
+ *
+ * Exhaustive search, exactly as the numpy encoder it replaces: every 14-sample frame is tried with each
+ * of the 8 coefficient pairs x 16 scales (128 lanes, lane = pair*16 + scale), each lane running its own
+ * decoder history from the previous frame's choice; the lane with the smallest sum of squared errors
+ * wins (the first one on a tie). Output must stay byte-identical to the numpy version: rounding is
+ * rint() (half to even, like numpy.round), all arithmetic in 64 bits.
+ *
+ * Protocol on stdin/stdout, little-endian: request = u32 n, 16 x s16 coefficients, n x s16 samples;
+ * reply = u32 frames, frames x 8 bytes. A request with n = 0 ends the program.
+ */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <fcntl.h>
+#include <io.h>
+#endif
+
+static int get(void* p, size_t n) { return fread(p, 1, n, stdin) == n; }
+static uint32_t le32(const unsigned char* b) { return b[0] | b[1] << 8 | b[2] << 16 | (uint32_t)b[3] << 24; }
+static int64_t asr11(int64_t v) { return v >= 0 ? v >> 11 : -((-v - 1) >> 11) - 1; } /* floor(v / 2048) */
+static int64_t clamp(int64_t v, int64_t lo, int64_t hi) { return v < lo ? lo : v > hi ? hi : v; }
+
+int main(void)
+{
+#ifdef _WIN32
+  /* Windows opens both pipes in text mode: a 0x1A sample byte ends the input and every 0x0A written
+   * gains a 0x0D. The protocol is binary. */
+  _setmode(_fileno(stdin), _O_BINARY);
+  _setmode(_fileno(stdout), _O_BINARY);
+#endif
+  for (;;)
+  {
+    unsigned char hdr[4 + 32];
+    if (!get(hdr, 4)) return 1;
+    uint32_t n = le32(hdr);
+    if (n == 0) return 0;
+    if (!get(hdr + 4, 32)) return 1;
+    int64_t c1[128], c2[128], sc[128];
+    for (int k = 0; k < 8; k++)
+    {
+      int16_t a, b;
+      memcpy(&a, hdr + 4 + 4 * k, 2);
+      memcpy(&b, hdr + 6 + 4 * k, 2);
+      for (int s = 0; s < 16; s++) { c1[k * 16 + s] = a; c2[k * 16 + s] = b; sc[k * 16 + s] = s; }
+    }
+    uint32_t frames = (n + 13) / 14;
+    int16_t* x = calloc((size_t)frames * 14, 2);
+    unsigned char* out = malloc((size_t)frames * 8 + 4);
+    if (!x || !out || !get(x, (size_t)n * 2)) return 1;
+    out[0] = frames; out[1] = frames >> 8; out[2] = frames >> 16; out[3] = frames >> 24;
+    int64_t h1 = 0, h2 = 0;
+    for (uint32_t f = 0; f < frames; f++)
+    {
+      const int16_t* blk = x + (size_t)f * 14;
+      int64_t H1[128], H2[128], err[128];
+      int8_t nibs[128][14];
+      for (int l = 0; l < 128; l++)
+      {
+        H1[l] = h1; H2[l] = h2; err[l] = 0;
+        for (int i = 0; i < 14; i++)
+        {
+          int64_t pred = asr11(c1[l] * H1[l] + c2[l] * H2[l] + 1024);
+          int64_t d = blk[i] - pred;
+          int64_t nib = clamp((int64_t)rint((double)d / (double)(1 << sc[l])), -8, 7);
+          int64_t v = clamp(asr11(nib * (1 << sc[l]) * 2048 + 1024 + c1[l] * H1[l] + c2[l] * H2[l]), -32768, 32767);
+          int64_t e = blk[i] - v;
+          err[l] += e * e;
+          nibs[l][i] = (int8_t)nib;
+          H2[l] = H1[l]; H1[l] = v;
+        }
+      }
+      int best = 0;
+      for (int l = 1; l < 128; l++) if (err[l] < err[best]) best = l;
+      unsigned char* o = out + 4 + (size_t)f * 8;
+      o[0] = (unsigned char)(((best / 16) << 4) | (best % 16));
+      for (int i = 0; i < 14; i += 2) o[1 + i / 2] = (unsigned char)((nibs[best][i] & 15) << 4 | (nibs[best][i + 1] & 15));
+      h1 = H1[best]; h2 = H2[best];
+    }
+    if (fwrite(out, 1, (size_t)frames * 8 + 4, stdout) != (size_t)frames * 8 + 4) return 1;
+    fflush(stdout);
+    free(x); free(out);
+  }
+}
