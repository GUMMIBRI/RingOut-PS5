+  ringout_native_value("RingOut PRX module info result u32 ", static_cast<uint32_t>(info_result));
+  if (info_result != 0)
+    return PRX_ERROR_MODULE_INFO;
+
+  uint32_t count = 0;
+  std::memcpy(&count, reinterpret_cast<const uint8_t*>(info) + 0x148, sizeof(count));
+  ringout_native_value("RingOut PRX module info size u32 ", static_cast<uint32_t>(info[0]));
+  ringout_native_value("RingOut PRX module info segment count ", count);
