+#ifdef MODERNGEKKO_PS5
+void ApplyPendingPS5Pad(PS5DefaultPadBinding &binding) {
+  {
+    const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+    if (!binding.pending_profile)
+      return;
+    auto *const config = Pad::GetConfig();
+    if (!config || config->GetControllerCount() == 0)
+      return;
+    auto devices = g_controller_interface.GetAllDeviceStrings();
+    for (const int port : binding.ports_with_saved_devices) {
+      const auto *other = config->GetController(port);
+      if (other)
+        std::erase(devices, other->GetDefaultDevice().ToString());
+    }
+    const auto device = std::ranges::find_if(
+        devices, [](const std::string &name) { return name.starts_with("SDL/"); });
+    if (device == devices.end())
+      return;
+    auto *const pad = config->GetController(0);
+    pad->LoadConfig(&*binding.pending_profile);
+    pad->SetDefaultDevice(*device);
+    pad->UpdateReferences(g_controller_interface);
+    unsigned mask = 0;
+    for (const auto& group : pad->groups) {
+      if (group->name != "Buttons")
+        continue;
+      for (const auto& control : group->controls) {
+        if (!control->control_ref->BoundCount())
+          continue;
+        if (control->name == "A") mask |= 1;
+        if (control->name == "Y") mask |= 2;
+        if (control->name == "Start") mask |= 4;
+      }
+    }
+    ringout_native_value("input: bound A/Y/Start mask ", mask);
+    binding.pending_profile.reset();
+  }
+  RuntimeStage("input: applied SDL profile to GameCube port 1\n");
+}
+
+void ConfigureDefaultPS5Pad(PS5DefaultPadBinding &binding) {
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  binding.pending_profile.reset();
+  binding.ports_with_saved_devices.clear();
+  auto *const config = Pad::GetConfig();
+  if (!config || config->GetControllerCount() == 0) {
+    RuntimeStage("input: GameCube port 1 unavailable\n");
+    return;
+  }
+  auto *const pad = config->GetController(0);
+  Common::IniFile saved;
+  if (saved.Load(File::GetUserPath(D_CONFIG_IDX) + "GCPadNew.ini") && saved.GetSection(pad->GetName())) {
+    RuntimeStage("input: using saved GameCube port 1 settings\n");
+    return;
+  }
+  auto& settings = SConfig::GetInstance();
+  if (settings.GetGameID() != "00000000" && settings.LoadGameIni().Exists("Controls", "PadProfile1")) {
+    RuntimeStage("input: using game-specific port 1 settings\n");
+    return;
+  }
+
+  Common::IniFile profile;
+  if (!profile.Load(s_ps5_gamepad_profile)) {
+    RuntimeStage("input: packaged SDL profile file unavailable\n");
+    return;
+  }
+  auto *section = profile.GetSection("Profile");
+  if (!section) {
+    RuntimeStage("input: packaged SDL profile has no Profile section\n");
+    return;
+  }
+
+  // Unconfigured ports may inherit the same default device with no bindings.
+  // Reserve only devices assigned to another port in the user's configuration.
+  for (int port = 1; port < config->GetControllerCount(); ++port) {
+    const auto *other = config->GetController(port);
+    const auto *settings = other ? saved.GetSection(other->GetName()) : nullptr;
+    std::string device;
+    if (settings && settings->Get("Device", &device) && !device.empty())
+      binding.ports_with_saved_devices.push_back(port);
+  }
+  binding.pending_profile = *section;
+  ApplyPendingPS5Pad(binding);
+  if (binding.pending_profile)
+    RuntimeStage("input: waiting for first SDL gamepad for GameCube port 1\n");
+}
+
+void InstallPS5PadDefaults(PS5DefaultPadBinding &binding) {
+  // Subscribe before the initial check. Boot reloads GCPadNew.ini after the
+  // frontend returns, and SDL can announce its device on either side of it.
+  binding.hotplug = g_controller_interface.RegisterDevicesChangedCallback(
+      [&binding] { ApplyPendingPS5Pad(binding); });
+  binding.reload = Pad::OnConfigLoaded([&binding] { ConfigureDefaultPS5Pad(binding); });
+  ConfigureDefaultPS5Pad(binding);
+}
