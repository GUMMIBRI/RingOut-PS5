+// Read the saved stack linkage directly from MEM1. Using the MMU here could
+// cause another data fault while handling the original access.
+static std::optional<u32> ReadAOTRamWord(const u8* ram, u32 ram_size, u32 address, u64 offset)
+{
+  constexpr u32 physical_mask = 0x1fffffff;
+  const u32 segment = address & ~physical_mask;
+  if (segment != 0x80000000 && segment != 0xc0000000)
+    return std::nullopt;
+  if (!ram || offset > ram_size)
+    return std::nullopt;
+  const u64 start = static_cast<u64>(address & physical_mask) + offset;
+  if ((start & 3) != 0 || start + sizeof(u32) > ram_size)
+    return std::nullopt;
+  return Common::swap32(ram + start);
+}
+
+// This probe only recognizes the two caller frames observed on the US
+// RingOut module. A non-matching frame falls back to the generic MMU report.
+static std::string DescribeMissionIndexSource(const u8* ram, u32 size,
+                                              const MMU::AOTFaultContext& context,
+                                              u32 caller_sp, u32 saved_return)
+{
+  if (context.block_pc != 0x800fb76c || caller_sp < context.sp ||
+      caller_sp - context.sp != 128 ||
+      (saved_return != 0x80103f2c && saved_return != 0x80103f94))
+    return {};
+
+  const u32 input_pc = saved_return == 0x80103f2c ? 0x80103f08 : 0x80103f88;
+  if (ReadAOTRamWord(ram, size, 0x800fb510, 0) != 0xbf010020u ||
+      ReadAOTRamWord(ram, size, input_pc, 0) != 0x88840012u)
+    return {};
