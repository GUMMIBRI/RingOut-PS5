+        self.assertEqual(tables.convert_ending_row(struct.pack('<hhI', 86, 11, 85)),
+                         struct.pack('>hhI', 86, 11, 85))
+
+    def test_short_row_refused(self):
+        with self.assertRaises(ValueError):
+            tables.convert_ending_row(b'\x00' * 6)
