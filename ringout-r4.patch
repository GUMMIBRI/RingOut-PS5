@@ -0,0 +1,88 @@
+"""ps2iso and ps2tables on the player's PS2 disc (RINGOUT_HEIHACHI_IMAGE, RINGOUT_SPAWN_DOL). The refusals run anywhere."""
+import os, struct, sys, tempfile, unittest
+HERE = os.path.dirname(__file__)
+for d in ('..', '../../guests', '../../spawn'): sys.path.insert(0, os.path.join(HERE, d))
+import ps2iso, ps2tables, tables
+
+IMAGE, DOL = os.environ.get('RINGOUT_HEIHACHI_IMAGE', ''), os.environ.get('RINGOUT_SPAWN_DOL', '')
+HAVE = os.path.isfile(IMAGE) and os.path.isfile(DOL)
+
+
+class Refusals(unittest.TestCase):
+    def test_truncated_file_refused(self):
+        with tempfile.NamedTemporaryFile() as f:
+            f.write(b'x' * 4096); f.flush()
+            with self.assertRaisesRegex(ps2iso.Refusal, 'not a PS2 disc image'):
+                ps2iso.identify(ps2iso.open_image(f.name))
+
+    def test_missing_file_refused(self):
+        with self.assertRaisesRegex(ps2iso.Refusal, 'cannot read'):
+            ps2iso.open_image('/nonexistent/x.iso')
+
+    def test_unknown_release_refused(self):
+        with self.assertRaisesRegex(ps2iso.Refusal, 'not a supported'):
+            ps2iso.check_release('0' * 40, '1' * 40, table=())
+
+
+@unittest.skipUnless(HAVE, 'needs RINGOUT_HEIHACHI_IMAGE and RINGOUT_SPAWN_DOL')
+class Rows(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.root, cls.elf = ps2iso.identify(ps2iso.open_image(IMAGE))
+        cls.t = ps2tables.heihachi_tables(cls.elf, DOL)
+        cls.e = ps2tables.Elf(cls.elf); cls.g = tables.Dol(DOL)
+
+    def test_rows_measured(self):
+        self.assertEqual(self.t['costume'], bytes([1, 1, 1, 1, 0, 0]))
+        self.assertEqual(self.t['roster'], 1)
+        self.assertEqual(struct.unpack('>hhI', self.t['ending']), (85, 12, 81))
+        self.assertEqual(self.t['ending_old'], b'\xff' * 8)
+        self.assertEqual(self.t['voice'], 1)
+        self.assertEqual(len(self.t['preview']), 56)
+        self.assertNotIn('name', self.t)
+
+    def test_descriptor_strings_resolve(self):
+        d, blob = self.t['descriptor'], self.t['strings']
+        def s(slot):
+            p = struct.unpack_from('>I', d, slot)[0] - ps2tables.STRINGS_ADDR
+            return blob[p:blob.index(b'\0', p)]
+        self.assertEqual((s(0x00), s(0x18), s(0x30), s(0x48), s(0x60)),
+                         (b'Heihachi Mishima', b'HEIHACHI', b'Iron Fist', b'Japan?', b'75'))
+        for o in (0x82, 0x86, 0x88):
+            self.assertEqual(struct.unpack_from('>H', d, o)[0], 28, hex(o))
+        self.assertLessEqual(len(blob), ps2tables.STRINGS_SIZE)
+
+    def test_cell(self):
+        self.assertEqual(self.t['cell'][:2], b'\x00\x1c')
+        self.assertEqual(self.t['xcell'][:4], struct.pack('<HH', 28, 2))
+        self.assertEqual(self.t['xcell'][8:10], bytes(ps2tables.PS2_FACES))
+        self.assertEqual(self.t['xcell'][16:18], bytes(ps2tables.PS2_SILHOUETTES))
+
+    def test_pool_lists_place_him_where_gc_has_link(self):
+        have = {tuple(l) for l in self.t['pool_lists']}
+        gc = [l for l in tables.pool_lists(self.g.read(tables.POOL_ADDR, tables.POOL_SIZE)) if tables.LINK_ID in l]
+        self.assertEqual(len(gc), 7)
+        for l in gc:
+            self.assertIn(tuple(28 if v == 27 else v for v in l), have)
+
+    def test_gc_slots_are_free(self):
+        for a, n in ((ps2tables.STRINGS_ADDR, ps2tables.STRINGS_SIZE), (ps2tables.PREVIEW_HOME, 56),
+                     (tables.DESC_ADDR + 28 * tables.DESC_STRIDE, tables.DESC_STRIDE)):
+            self.assertEqual(self.g.read(a, n), bytes(n), hex(a))
+        for a, n in ((tables.STRINGS_ADDR, tables.STRINGS_SIZE), (tables.PREVIEW_HOME, 28), (tables.NAME_AT, 36)):
+            self.assertFalse(a < ps2tables.STRINGS_ADDR + ps2tables.STRINGS_SIZE and ps2tables.STRINGS_ADDR < a + n)
+            self.assertFalse(a < ps2tables.PREVIEW_HOME + 56 and ps2tables.PREVIEW_HOME < a + n)
+
+    def test_weapon_rows_equal_gc(self):
+        # He keeps the GC's weapon rows and save slots; nothing is converted. A PS2 row differing would be news.
+        self.assertEqual(ps2tables.weapon_row_differences(self.e, self.g), [])
+
+    def test_home_scene_is_his(self):
+        self.assertEqual(ps2tables.home_scene(self.root), {18: 18, 34: 34})
+
+    def test_switch_case_is_as_id_24(self):
+        self.assertEqual(ps2tables.switch_as_id(self.e), 24)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tools/heihachi/tests/test_ps2ui.py b/tools/heihachi/tests/test_ps2ui.py
new file mode 100644
index 00000000..6a67ed7c
--- /dev/null
+++ b/tools/heihachi/tests/test_ps2ui.py
@@ -0,0 +1,80 @@
+"""ps2ui: the cast both discs share is the oracle for the PS2's select-screen art, endings and profile camera."""
+import math, os, struct, sys, tempfile, unittest
+HERE = os.path.dirname(__file__)
+for d in ('..', '../../guests', '../../spawn'): sys.path.insert(0, os.path.join(HERE, d))
+import ps2iso, ps2tables, ps2ui, tables, ui
+from olk import Olk, pack
+
+IMAGE, GC, DOL = (os.environ.get(k, '') for k in ('RINGOUT_HEIHACHI_IMAGE', 'RINGOUT_SPAWN_GC', 'RINGOUT_SPAWN_DOL'))
+HAVE = all(os.path.isfile(p) for p in (IMAGE, GC, DOL))
+
+
+def psnr(a, b):
+    se = sum((x - y) ** 2 for r, s in zip(a, b) for p, q in zip(r, s) for x, y in zip(p[:3], q[:3]))
+    return 99 if not se else 10 * math.log10(255 ** 2 * 3 * len(a) * len(a[0]) / se)
+
+
+@unittest.skipUnless(HAVE, 'needs RINGOUT_HEIHACHI_IMAGE, RINGOUT_SPAWN_GC and RINGOUT_SPAWN_DOL')
+class Oracles(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.root, elf = ps2iso.identify(ps2iso.open_image(IMAGE))
+        cls.p, cls.g, cls.e, cls.d = Olk(cls.root), Olk(GC), ps2tables.Elf(elf), tables.Dol(DOL)
+        cls.gcell = {}
+        for i in range(tables.CELL_COUNT if hasattr(tables, 'CELL_COUNT') else 32):
+            r = cls.d.read(tables.CELL_ADDR + i * tables.CELL_STRIDE, tables.CELL_STRIDE)
+            cls.gcell.setdefault(struct.unpack_from('>H', r, 0)[0], r)
+
+    def shared(self):
+        for cid in tables.SHARED_IDS:
+            if cid in self.gcell: yield cid, self.gcell[cid], ps2tables.ps2_cell(self.e, cid)
+
+    def test_faces_match(self):
+        pe, ge = self.p.entry(*ui.FACE_ENTRY), self.g.entry(*ui.FACE_ENTRY); n = 0
+        for cid, g, x in self.shared():
+            self.assertGreaterEqual(psnr(ps2ui.face_rows(pe, x[8]), ui.decode_face(ge, g[8])), 26, cid); n += 1
+        self.assertGreater(n, 15)
+
+    def test_silhouettes_exact(self):
+        pe, ge = self.p.entry(*ui.SILHOUETTE_ENTRY), self.g.entry(*ui.SILHOUETTE_ENTRY); n = 0
+        for cid, g, x in self.shared():
+            self.assertEqual(ps2ui.silhouette_indices(pe, x[16]), ui.decode_silhouette(ge, g[16]), cid); n += 1
+        self.assertGreater(n, 15)
+
+    def test_his_art_builds_in_the_gc_format(self):
+        ge = self.g.entry(*ui.FACE_ENTRY)
+        new, first = ui.append_textures(ge, ui.FACE_PART, ps2ui.faces(self.p.entry(*ui.FACE_ENTRY), ge))
+        self.assertEqual(first, 77)
+        self.assertGreaterEqual(psnr(ui.decode_face(new, 77), ps2ui.face_rows(self.p.entry(*ui.FACE_ENTRY), ps2ui.FACES[0])), 40)
+        gs_ = self.g.entry(*ui.SILHOUETTE_ENTRY)
+        new, first = ui.append_textures(gs_, ui.SILHOUETTE_PART, ps2ui.silhouettes(self.p.entry(*ui.SILHOUETTE_ENTRY), gs_))
+        self.assertEqual(ui.decode_silhouette(new, first), ps2ui.silhouette_indices(self.p.entry(*ui.SILHOUETTE_ENTRY), ps2ui.SILHOUETTES[0]))
+
+    def test_ending_art_matches(self):
+        for art in (79, 65):
+            ours = ps2ui.ending_art(self.p.entry(2, art), self.g.entry(2, art))
+            for page in (0, 1):
+                self.assertGreaterEqual(psnr(ui.decode_ending(ours, page), ui.decode_ending(self.g.entry(2, art), page)), 26, (art, page))
+
+    def test_his_ending_is_the_template_size(self):
+        t = self.g.entry(2, 79)
+        self.assertEqual(len(ps2ui.ending_art(self.p.entry(2, 85), t)), len(t))
+
+    def test_camera_slots(self):
+        x, g = pack(self.p.entry(*ui.PROFILE_CAMERA), False), pack(self.g.entry(*ui.PROFILE_CAMERA), True)
+        misses = {(21, 1): 2, (21, 2): 2}   # measured: the two discs disagree in two bytes of these
+        for cid in tables.SHARED_IDS:
+            for s in range(3):
+                k = cid + ui.PROFILE_SLOTS * s
+                if k < len(x) and (x[k] or g[k]):
+                    ours = ui._profile_part(x[k], s)
+                    self.assertEqual(len(ours), len(g[k]), (cid, s))
+                    self.assertEqual(sum(a != b for a, b in zip(ours, g[k])), misses.get((cid, s), 0), (cid, s))
+
+    def test_camera_fills_his_three_slots(self):
+        out = pack(ps2ui.camera(self.p.entry(*ui.PROFILE_CAMERA))(self.g.entry(*ui.PROFILE_CAMERA)), True)
+        for k in (28, 60, 92): self.assertTrue(out[k], k)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tools/heihachi/tests/test_vmp2vmg.py b/tools/heihachi/tests/test_vmp2vmg.py
new file mode 100644
index 00000000..428ec9fd
--- /dev/null
+++ b/tools/heihachi/tests/test_vmp2vmg.py
@@ -0,0 +1,230 @@
+"""Reflection pass and material values, on Talim: the PS2's chunks against the GC's own materials."""
+import os, struct, sys, unittest
+HERE = os.path.dirname(__file__)
+for d in ('..', '../../guests', '../../spawn'): sys.path.insert(0, os.path.join(HERE, d))
+import build_heihachi, gs, ps2iso, vmp, vmp2vmg
+from olk import Olk, pack
+
+IMAGE, GC = os.environ.get('RINGOUT_HEIHACHI_IMAGE', ''), os.environ.get('RINGOUT_SPAWN_GC', '')
+HAVE = os.path.isfile(IMAGE) and os.path.isfile(GC)
+TALIM, HEIHACHI = 46 + 39 * 14, 46 + 39 * 23
+
+
+def materials(x, end='<'):
+    """(word0 low bits, word1, amb, spec, power, has second texture) per material of a VMX (<) or VMG (>)."""
+    n = struct.unpack_from(end + 'H', x, 0x14)[0]; at = struct.unpack_from(end + 'I', x, 0x1c)[0]; out = []
+    for i in range(n):
+        w = struct.unpack_from(end + '8I', x, at + i * 0x50); f = struct.unpack_from(end + '12f', x, at + i * 0x50 + 0x20)
+        out.append((w[0] & 3, w[1], f[:3], f[8:11], f[11], bool(w[3]), w[6]))
+    return out
+
+
+def close(a, b):
+    return abs(a - b) <= max(abs(b) * 0.05, 1e-3)
+
+
+@unittest.skipUnless(HAVE, 'needs RINGOUT_HEIHACHI_IMAGE and RINGOUT_SPAWN_GC')
+class Talim(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        root, _ = ps2iso.identify(ps2iso.open_image(IMAGE))
+        cls.P = pack(Olk(root).entry(4, TALIM), False)[0]
+        cls.G = pack(Olk(GC).entry(4, TALIM), True)[0]
+        cls.geo = vmp2vmg.geometry(cls.P)
+        cls.vmx = vmp2vmg.synth_vmx(cls.geo)
+        cls.mine, cls.gc = materials(cls.vmx), materials(cls.G, '>')
+
+    def test_every_second_pass_chunk_gives_a_two_texture_material(self):
+        m = vmp.Model(self.P); limit = struct.unpack_from('<I', self.P, 0x10)[0]
+        n = sum(c['cnt'] == 9 for b in m.batches for _, a in b['lists'] for c in m.chunks(a, limit))
+        self.assertEqual(n, 10)
+        two = [k for k in self.mine if k[5]]
+        self.assertEqual(len(two), n)
+        for k in two:
+            self.assertEqual(k[1] & 0x20, 0x20)
+            self.assertEqual(struct.unpack_from('<H', self.vmx, k[6])[0], 5)   # the stage GC's reflection materials use
+
+    def test_second_pass_shares_its_packets(self):
+        m = vmp.Model(self.P); limit = struct.unpack_from('<I', self.P, 0x10)[0]
+        for b in m.batches:
+            for _, a in b['lists']:
+                cs = m.chunks(a, limit)
+                for i, c in enumerate(cs):
+                    if c['cnt'] == 9: self.assertEqual(m.packets_of(c), m.packets_of(cs[i - 1]))
+
+    def test_values_match_gc(self):
+        misses = []
+        for k in self.mine:
+            hit = [g for g in self.gc if g[:2] == k[:2] and g[5] == k[5] and close(k[4], g[4]) and
+                   all(close(a, b) for a, b in zip(k[2] + k[3], g[2] + g[3]))]
+            if not hit: misses.append(k[:6])
+        # One measured difference: an unlit chunk the GC draws with its reflection material; the PS2 has no second pass for it.
+        self.assertEqual({round(k[2][0], 3) for k in misses}, {0.064})
+
+    def test_no_placeholder_left(self):
+        self.assertFalse([k for k in self.mine if k[0] == 2 and k[4] == 10.0 and k[3] == (0.2, 0.2, 0.2)])
+
+    def test_power_mapping(self):
+        self.assertEqual([vmp2vmg.power(v) for v in (5.087, 7.279, 9.469)], [10.0, 15.0, 20.0])
+
+    def test_node_matrices_stay_identity(self):
+        # Not derived: the PS2 keeps no bind pose in this model, and rigid parts sit right in the driven runs (T9).
+        at = struct.unpack_from('<I', self.vmx, 0x24)[0]
+        self.assertEqual(struct.unpack_from('<16f', self.vmx, at + 0x10)[0], 1.0)
+
+
+@unittest.skipUnless(HAVE, 'needs RINGOUT_HEIHACHI_IMAGE and RINGOUT_SPAWN_GC')
+class TextureGroups(unittest.TestCase):
+    """Each draw list has its own upload group, all loaded at the same blocks: a list reads only its own group."""
+    @classmethod
+    def setUpClass(cls):
+        root, _ = ps2iso.identify(ps2iso.open_image(IMAGE))
+        o = Olk(root); cls.models = [pack(o.entry(4, e), False)[0] for e in (TALIM, HEIHACHI, HEIHACHI + 1)]
+
+    def test_every_chunk_reads_an_upload_of_its_own_list(self):
+        for P in self.models:
+            m = vmp.Model(P); limit, bank = struct.unpack_from('<II', P, 0x10)
+            groups = gs.upload_groups(P, bank)
+            for b in m.batches:
+                for kind, a in b['lists']:
+                    blocks = {u[0] for u in groups[kind]}
+                    for c in m.chunks(a, limit):
+                        t = gs.tex0(*struct.unpack_from('<II', P, c['tex'] + 0x20))
+                        self.assertIn(t['tbp'], blocks)
+                        if t['psm'] in (gs.PSMT8, gs.PSMT4): self.assertIn(t['cbp'], blocks)
+
+    def test_no_empty_picture(self):
+        for P in self.models:
+            for k, im in enumerate(vmp2vmg.geometry(P).images):
+                self.assertTrue(any(p[3] for r in im for p in r), 'picture %d is fully transparent' % k)
+
+    def test_blended_layer_of_his_gi_is_clean(self):
+        # The garbled patch on his back: 128x128 in list 1, read from list 0's memory. The real one is the tiger of his
+        # gi, on a transparent ground.
+        g = vmp2vmg.geometry(self.models[2])
+        im = next(g.images[m['tex']] for m in g.meshes if m['list'] and len(g.images[m['tex']]) == 128)
+        self.assertEqual([im[y][x][3] for y, x in ((0, 0), (0, 127), (127, 0), (127, 127))], [0, 0, 0, 0])
+        self.assertGreater(im[64][64][3], 200)
+
+
+@unittest.skipUnless(HAVE, 'needs RINGOUT_HEIHACHI_IMAGE and RINGOUT_SPAWN_GC')
+class RegionClamp(unittest.TestCase):
+    """A 128x256 texture with 192 rows uploaded: its chunk's CLAMP_1 is REGION_CLAMP with MAXV 191, so the GS repeats
+    row 191 below it. The rows past it are other textures' memory (the garbled lower back of his costume B)."""
+    def test_clamp_register(self):
+        self.assertEqual(gs.clamp(0x001fc009, 0x000002fc), dict(wms=1, wmt=2, minu=0, maxu=127, minv=0, maxv=191))
+
+    def test_rows_past_maxv_repeat_the_edge(self):
+        root, _ = ps2iso.identify(ps2iso.open_image(IMAGE))
+        for entry in (HEIHACHI + 1, TALIM):
+            g = vmp2vmg.geometry(pack(Olk(root).entry(4, entry), False)[0])
+            tall = [im for im in g.images if len(im) == 256 and len(im[0]) == 128]
+            self.assertTrue(tall)
+            for im in tall:
+                self.assertTrue(all(im[y] == im[191] for y in range(192, 256)))
+                self.assertNotEqual(im[190], im[191])
+
+    def test_uvs_span_the_region_not_the_texture(self):
+        """Under REGION_CLAMP his UVs run 0..1 over the region, not the whole texture: the 128x128 picture with a
+        96x96 region is black past it, and the 512x256 torso (MAXU 383) has his ear where u 0.70..0.79 of the region
+        lands. Read as the whole texture, the UVs past the region hit the clamped edge, smeared over his back."""
+        root, _ = ps2iso.identify(ps2iso.open_image(IMAGE))
+        for entry in (HEIHACHI, HEIHACHI + 1):
+            P = pack(Olk(root).entry(4, entry), False)[0]
+            g, seen = vmp2vmg.geometry(P), 0
+            for m in g.meshes:
+                c = m['chunk']
+                if P[c['tex'] + 0x38] != 8:
+                    continue
+                cl = gs.clamp(*struct.unpack_from('<II', P, c['tex'] + 0x30))
+                t = gs.tex0(*struct.unpack_from('<II', P, c['tex'] + 0x20))
+                uvs = [g.verts[i][1] for tri in m['tris'] for i in tri] if m['skin'] else [v['uv'] for v in m['vb']]
+                if cl['wms'] == 2:
+                    seen += 1
+                    self.assertLessEqual(max(u for u, _ in uvs), (cl['maxu'] + 1) / t['tw'] + 1e-6)
+                if cl['wmt'] == 2:
+                    seen += 1
+                    self.assertLessEqual(max(v for _, v in uvs), (cl['maxv'] + 1) / t['th'] + 1e-6)
+            self.assertGreater(seen, 0)
+
+
+@unittest.skipUnless(HAVE, 'needs RINGOUT_HEIHACHI_IMAGE and RINGOUT_SPAWN_GC')
+class Grip(unittest.TestCase):
+    """The GC runtime hangs a weapon half from its hand at a fixed grip G (rotation R, offset t), read from guest RAM in
+    the select pose and two fight frames. His gauntlet halves are built in the bare hand's frame, so each is placed by
+    G's inverse: hand-frame v becomes R^T (v - t), and the runtime's R v' + t puts it back on the forearm."""
+    @classmethod
+    def setUpClass(cls):
