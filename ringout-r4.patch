+    for k, m in enumerate(meshes):
+        w.extend(_material(m, stage_ptrs[k], env_ptrs[k]))
+    idx = []
+    for m in meshes:
+        ii = [remap[v] if m['skin'] else v for t in m['tris'] for v in t]
+        idx.append(put(struct.pack('<%dH' % len(ii), *ii) + b'\0\0', 2)); m['n'] = len(ii)
+    infl_at = put(b'', 0x10)
