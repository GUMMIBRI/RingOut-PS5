+    case kVK_DownArrow:
+      RecompMenu::OnKey(RecompMenu::Key::Down);
+      break;
+    case kVK_LeftArrow:
+      RecompMenu::OnKey(RecompMenu::Key::Left);
+      break;
+    case kVK_RightArrow:
+      RecompMenu::OnKey(RecompMenu::Key::Right);
+      break;
+    case kVK_Space:
+    case kVK_Return:
+    case kVK_ANSI_KeypadEnter:
