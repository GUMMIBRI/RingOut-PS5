@@ -0,0 +1,286 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check a private GRSEAF Link / Heihachi / Spawn package after CONTENT.json exists."""
+import argparse
+import hashlib
+import json
+import re
+import struct
+import subprocess
+import sys
+from contextlib import closing
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'tools/guests'))
+from olk import Olk
+
+
+# Exact private conversion and compiled game module qualified together in
+# GUEST-MODULE-RECEIPT.json. A different conversion or module needs its own review.
+MODULE_SHA256 = '34b9d99c1d4ba70686a677641f4d8e965ad99b5fd3764dba1d4cd08a58ff9e95'
+DATA_SHA256 = {
+    'game/files/root.olk': '2b19f3901dfc1c20596b3d921ee303973592208a2d65594d553cc0751dd57a34',
+    'game/guests/guests.json': '9ac55b42a14bec2e071883d3ac02ae6bdb41518e345762f05d54574fed5fe0e9',
+    'game/guests/root-guests.olk': 'e2059a71b7193f1693ce78f6b3dfb86c37f21e223d59d771b49288985f0ba843',
+}
+# These three linked members match in the gated host and the pad/HD host.
+# Other archive members legitimately differ between the two builds.
+CORE_MEMBERS = {
+    'StaticRecompCore.cpp.o': '7043c4e2defae2c1506bd9c363d37b4286b584d595a72e2a9fa1a13e2d6904a7',
+    'StaticRecompCore_Run.cpp.o': '61626b999c8a6dd1714a454291aaf5f893686ceff1384aee720f2a5878d9b45f',
+    'RecompGuest.cpp.o': 'ad0d007a70df3fca2f073f1d3773489998b27351f7ba6dc460c532b80e343703',
+}
+DISCIO_MEMBER = {'DirectoryBlob.cpp.o': '597b7d8d310300a37a4452ab4133a3613fe5bfdc17a5aff77fe7c92670e3dc4f'}
+INTRO_SHA256 = {
+    'intro-spawn.sfd': '265e35616e73cd27939726bc58828822dc7aaa791f77061dd4018a3be4578753',
+    'intro-heihachi.sfd': '9c2b67a2412b9ba582b33f90a4bdd86f7f2f6d28bd8c9b5ca6c28759c78c5cde',
+}
+GROUPS = 'staticrecomp_gate_groups'
+ARMED = 'dolrecomp_gate_armed'
+BYPASS = 'dolrecomp_gate_bypass'
+ATTACH = '_ZN11moderngekko12ModuleSource18AttachedDescriptorEPK21ModernGekkoModuleDescjPVjS5_'
+CREATE = '_ZN11moderngekko7Runtime6CreateENS_13RuntimeConfigE'
+RUN = '_ZN11moderngekko7Runtime3RunEv'
+GUEST_INIT = '_ZN11RecompGuest10InitializeERKNSt3__112basic_stringIcNS0_11char_traitsIcEENS0_9allocatorIcEEEES8_'
+FST_BUILD = '_ZN6DiscIOL31ConvertFSTEntriesToBuilderNodesERKN4File8FSTEntryE'
+EDGES = {
+    'main': ('staticrecomp_get_module', ATTACH, CREATE, RUN),
+    CREATE: ('_ZN11RecompGuest19SetModuleGateGroupsEj', GUEST_INIT,
+             '_ZN12JitInterface27SetStaticRecompModuleSourceE24StaticRecompModuleSource'),
+    RUN: ('_ZN11RecompGuest10SetSessionEb',),
+    GUEST_INIT: ('_ZN6DiscIO19SetHostFileResolverEPFNSt3__112basic_stringIcNS0_11char_traitsIcEENS0_9allocatorIcEEEERKS6_E',),
+    '_ZN4Core22FrameUpdateOnCPUThreadEv': ('_ZN11RecompGuest7OnFrameERN4Core6SystemE',),
+    FST_BUILD: ('_ZN4File7GetSizeERKNSt3__112basic_stringIcNS0_11char_traitsIcEENS0_9allocatorIcEEEE',),
+    '_ZN16StaticRecompCore3RunEv': ('_ZN11RecompGuest10SitesArmedEv',),
+}
+USB_ROOT = '/mnt/usb0/homebrew/PPSA99875'
+LLVM = Path('C:/.pe/ps5-native/gpu-platform-20261030/deps/llvm/bin')
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def read_json(path):
+    with path.open(encoding='utf-8') as stream:
+        return json.load(stream)
+
+
+def digest(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def record_at(path, rows):
+    matches = [r for r in rows if Path(r['path']) == path]
+    require(matches and all(r == matches[0] for r in matches), f'missing or conflicting receipt for {path}')
+    return matches[0]
+
+
+def verify(path, record, expected=None):
+    require(Path(record['path']) == path and path.is_file() and not path.is_symlink(),
+            f'file or receipt path mismatch: {path}')
+    require(path.stat().st_size == record['bytes'], f'size differs: {path}')
+    actual = digest(path)
+    require(actual == record['sha256'] and (expected is None or actual == expected),
+            f'SHA-256 differs: {path} ({actual})')
+    return actual
+
+
+def check_members(archive, expected, llvm):
+    ar = llvm / 'llvm-ar.exe'
+    names = subprocess.check_output([ar, 't', archive], text=True).splitlines()
+    for name, sha256 in expected.items():
+        require(names.count(name) == 1, f'expected exactly one {name} in {archive}')
+        obj = subprocess.check_output([ar, 'p', archive, name])
+        require(hashlib.sha256(obj).hexdigest() == sha256, f'guest host member differs: {name}')
+
+
+def linked_inputs(stage, final, llvm):
+    link = read_json(stage / 'link-args.json')
+    cmd_path = stage / 'commands.json'
+    verify(cmd_path, final['commands'])
+    commands = [c for c in read_json(cmd_path) if Path(c['argv'][0]).name == 'ld.lld.exe']
+    require(len(commands) == 1 and commands[0]['exit_code'] == 0 and commands[0]['argv'][1:] == link,
+            'actual successful linker command differs from link-args.json')
+    require(link.count('-o') == 1 and Path(link[link.index('-o') + 1]) == stage / 'ringout-native.elf',
+            'link output differs from the candidate ELF')
+    cwd = Path(commands[0]['cwd'])
+    archives = {}
+    for name in ('gGRSEAF_recomp.a', 'libcore.a', 'libmoderngekko.a', 'libdiscio.a'):
+        matches = {(cwd / arg).resolve() for arg in link if Path(arg).name == name}
+        require(len(matches) == 1, f'expected exactly one linked path for {name}')
+        path = matches.pop()
+        row = record_at(path, final['inputs'])
+        verify(path, row, MODULE_SHA256 if name == 'gGRSEAF_recomp.a' else None)
+        archives[name] = row
+    check_members(archives['libcore.a']['path'], CORE_MEMBERS, llvm)
+    check_members(archives['libdiscio.a']['path'], DISCIO_MEMBER, llvm)
+    return archives
+
+
+def control_symbols(elf, llvm):
+    readelf = llvm / 'llvm-readelf.exe'
+    sections = {}
+    for row in subprocess.check_output([readelf, '-SW', elf], text=True).splitlines():
+        match = re.match(r'\s*\[\s*(\d+)\]\s+(\.\S+)\s+(\S+)\s+([0-9a-fA-F]+)\s+'
+                         r'([0-9a-fA-F]+)\s+([0-9a-fA-F]+)\s+\S+\s+(\S+)', row)
+        if match:
+            index, name, kind, address, offset, size, flags = match.groups()
+            sections[index] = (name, kind, int(address, 16), int(offset, 16), int(size, 16), flags)
+    symbols = {}
+    with subprocess.Popen([readelf, '-Ws', elf], stdout=subprocess.PIPE, text=True) as proc:
+        for row in proc.stdout:
+            fields = row.split()
+            if not fields or fields[-1] not in (GROUPS, ARMED, BYPASS):
+                continue
+            _, raw_address, length, kind, binding, _, index, name = fields
+            require(name not in symbols and kind == 'OBJECT' and length == '4'
+                    and binding in ('LOCAL', 'GLOBAL') and index in sections, f'invalid gate symbol {name}')
+            section, section_type, start, offset, size, flags = sections[index]
+            address = int(raw_address, 16)
+            require(start <= address <= start + size - 4 and address % 4 == 0 and 'A' in flags,
+                    f'{name} is outside aligned, allocated storage')
+            if name == GROUPS:
+                require(section_type == 'PROGBITS' and 'W' not in flags, 'gate mask must be read-only data')
+                with elf.open('rb') as stream:
+                    stream.seek(offset + address - start)
+                    require(stream.read(4) == struct.pack('<I', 6), 'linked guest gate mask must be 0x6')
+            else:
+                require('W' in flags, f'gate control must be writable: {name}')
+            symbols[name] = {'address': address, 'section': section}
+        require(proc.wait() == 0, 'readelf failed')
+    require(set(symbols) == {GROUPS, ARMED, BYPASS}, 'linked native ELF lacks guest gates')
+    require(symbols[ARMED]['address'] != symbols[BYPASS]['address'], 'gate controls share storage')
+    return symbols
+
+
+def linked_calls(elf, llvm):
+    cmd = [llvm / 'llvm-objdump.exe', '--no-show-raw-insn',
+           '--disassemble-symbols=' + ','.join(EDGES), elf]
+    calls = {caller: set() for caller in EDGES}
+    main_controls = set()
+    caller = None
+    for row in subprocess.check_output(cmd, text=True).splitlines():
+        label = re.fullmatch(r'[0-9a-fA-F]+ <([^>]+)>:', row)
+        if label:
+            caller = label[1]
+        if caller in calls:
+            # Core's per-frame guest update is a tail call in these optimized builds.
+            target = re.search(r'\b(?:callq?|jmpq?)\s+0x[0-9a-fA-F]+ <([^>]+)>', row)
+            if target:
+                calls[caller].add(target[1])
+            if caller == 'main':
+                for symbol in (GROUPS, ARMED, BYPASS):
+                    if f'<{symbol}>' in row and '(%rip)' in row:
+                        main_controls.add(symbol)
+    for caller, targets in EDGES.items():
+        missing = set(targets) - calls[caller]
+        require(not missing, f'linked call missing from {caller}: {sorted(missing)}')
+    require(main_controls == {GROUPS, ARMED, BYPASS}, 'entry point does not reference all three guest gates')
+
+
+def records(archive, first, count):
+    base, entries = archive.group(4)
+    require(first + count <= len(entries), 'missing fighter bank records')
+    hashes = []
+    for offset, size, _, _ in entries[first:first + count]:
+        archive.f.seek(base + offset)
+        h = hashlib.sha256()
+        remaining = size
+        while remaining:
+            block = archive.f.read(min(remaining, 1024 * 1024))
+            require(block, 'short OLK record')
+            h.update(block)
+            remaining -= len(block)
+        hashes.append((size, h.digest()))
+    return hashes
+
+
+def fighter_banks(game):
+    stock = Olk(game / 'files/root.olk')
+    with closing(stock.f):
+        merged = Olk(game / 'guests/root-guests.olk')
+        with closing(merged.f):
+            require(len(stock.group(4)[1]) == 982 and len(merged.group(4)[1]) == 1060,
+                    'unexpected fighter bank layout')
+            result = {}
+            for name, first in (('Link', 943), ('Spawn', 982), ('Heihachi', 1021)):
+                rows = records(merged, first, 39)
+                if name == 'Link':
+                    require(rows == records(stock, first, 39), 'original Link records differ')
+                signature = b''.join(struct.pack('<I', size) + sha for size, sha in rows)
+                result[name] = {'first': first, 'records': len(rows), 'bytes': sum(n for n, _ in rows),
+                                'nonempty': sum(n > 0 for n, _ in rows),
+                                'lengths_and_record_digests_sha256': hashlib.sha256(signature).hexdigest()}
+    return result
+
+
+def check(stage, llvm):
+    final = read_json(stage / 'FINALIZATION.json')
+    archives = linked_inputs(stage, final, llvm)
+    elf = stage / 'ringout-native.elf'
+    native_sha = verify(elf, final['input_elf'])
+    symbols = control_symbols(elf, llvm)
+    linked_calls(elf, llvm)
+    converted_sha = verify(stage / 'eboot.elf', final['elf'])
+    layout = read_json(stage / 'layout.json')
+    require(layout['input_elf']['sha256'] == native_sha and layout['elf']['sha256'] == converted_sha and
+            layout['preflight_passed'] and layout['retained_passed'], 'ELF conversion receipt differs')
+    retained = {r['section'] for r in layout['retained_sections'] if r['preserved']}
+    require({'.text', *(v['section'] for v in symbols.values())} <= retained, 'guest sections not retained')
+    content = read_json(stage / 'CONTENT.json')
+    app = stage / 'app/PPSA99875'
+    require(Path(content['app_root']) == app and content['all_hashes_verified'], 'wrong app content receipt')
+    eboot = app / 'eboot.bin'
+    eboot_sha = verify(eboot, record_at(eboot, content['files']), final['eboot']['sha256'])
+    stage_eboot = stage / 'eboot.bin'
+    require(Path(final['eboot']['path']) == stage_eboot and final['eboot']['bytes'] == eboot.stat().st_size,
+            'EBOOT finalization record differs')
+    if not stage_eboot.samefile(eboot):
+        verify(stage_eboot, final['eboot'], eboot_sha)
+    payload = {}
+    guest_dir = app / 'game/guests'
+    names = {p.name for p in guest_dir.iterdir()}
+    require({'guests.json', 'root-guests.olk'} <= names <= {'guests.json', 'root-guests.olk'} | INTRO_SHA256.keys(),
+            'guest directory is incomplete or contains unregistered files')
+    for name in ('guests', *names):
+        require(not (app / 'game/files' / name).exists(), f'guest file appears inside virtual disc: {name}')
+    files = {**DATA_SHA256, **{'game/guests/' + n: INTRO_SHA256[n] for n in sorted(names & INTRO_SHA256.keys())}}
+    for relative, expected in files.items():
+        path = app / relative
+        row = record_at(path, content['files'])
+        sha = verify(path, row, expected)
+        payload[relative] = {'bytes': row['bytes'], 'sha256': sha}
+    manifest = read_json(guest_dir / 'guests.json')
+    require(manifest['format'] == 2 and manifest['disc'] == 'GRSEAF' and
+            sorted((g['id'], g['block']) for g in manifest['guests']) == [(28, 1021), (29, 982)],
+            'expected US Spawn and Heihachi in separate appended blocks')
+    return {'status': 'PASS', 'scope': 'Static package and guest asset verification; gameplay untested.',
+            'build_id': final['build_id'], 'usb_app_root': USB_ROOT, 'eboot_sha256': eboot_sha,
+            'converted_elf_sha256': converted_sha, 'native_elf_sha256': native_sha,
+            'archives': archives, 'core_members_sha256': CORE_MEMBERS, 'discio_member_sha256': DISCIO_MEMBER,
+            'gate_mask': '0x6',
+            'controls': symbols, 'required_calls': EDGES, 'payload': payload,
+            'group4': fighter_banks(app / 'game'), 'stock_link_records_equal': 39}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('stage', type=Path)
+    parser.add_argument('--llvm', type=Path, default=LLVM)
+    parser.add_argument('--output', type=Path, help='separate receipt for read-only reference candidates')
+    args = parser.parse_args()
+    stage = args.stage.resolve()
+    output = args.output or stage / 'GUEST-ROSTER-CHECK.json'
+    try:
+        result = check(stage, args.llvm)
+    except (ValueError, OSError, KeyError, TypeError, IndexError, AssertionError, struct.error, subprocess.SubprocessError) as err:
+        result = {'status': 'FAIL', 'stage': str(stage), 'error': str(err)}
+    output.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+    print(result['status'], result.get('error', output))
+    return int(result['status'] != 'PASS')
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/ModernGekko/ps5/check-vulkan-dispatch.py b/ModernGekko/ps5/check-vulkan-dispatch.py
new file mode 100644
index 00000000..a59365f6
--- /dev/null
+++ b/ModernGekko/ps5/check-vulkan-dispatch.py
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check linked RADV dispatch tables for Dolphin's required device functions.
+
+This is a static ELF check; it does not prove target driver lookup or gameplay.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--elf', required=True, type=Path)
+parser.add_argument('--entrypoints', required=True, type=Path)
+parser.add_argument('--nm', required=True)
+parser.add_argument('--readelf', required=True)
+parser.add_argument('--output', required=True, type=Path)
+args = parser.parse_args()
+source = args.entrypoints.read_text()
+required = re.findall(r'VULKAN_DEVICE_ENTRY_POINT\((vk\w+),\s*true\)', source)
+if not required or len(set(required)) != len(required):
+    raise SystemExit('missing or duplicate required device entrypoints')
+raw_symbols = subprocess.check_output([args.nm, '-S', '--defined-only', str(args.elf)], text=True)
+symbols = {}
+for line in raw_symbols.splitlines():
+    fields = line.split()
+    if len(fields) >= 4 and fields[-2] not in ('U', 'u', 'w', 'v'):
+        symbols[fields[-1]] = (int(fields[0], 16), int(fields[1], 16))
+raw_relocs = subprocess.check_output([args.readelf, '-r', str(args.elf)], text=True)
+relocations = []
+for line in raw_relocs.splitlines():
+    match = re.match(r'^\s*([0-9a-fA-F]+)\s+\S+\s+R_X86_64_RELATIVE\s+([0-9a-fA-F]+)\s*$', line)
+    if match: relocations.append((int(match.group(1), 16), int(match.group(2), 16)))
+tables = [(n, *symbols[n]) for n in ('radv_device_entrypoints', 'vk_common_device_entrypoints',
+                                      'wsi_device_entrypoints') if n in symbols]
+rows = []
+for function in required:
+    providers = [prefix + function[2:] for prefix in ('radv_', 'vk_common_', 'wsi_')
+                 if prefix + function[2:] in symbols]
+    hits = [{'provider': provider, 'table': table, 'relocation': hex(offset)}
+            for provider in providers for table, start, size in tables for offset, addend in relocations
+            if start <= offset < start + size and addend == symbols[provider][0]]
+    rows.append({'function': function, 'matches': hits})
+with args.elf.open('rb') as stream: digest = hashlib.file_digest(stream, 'sha256').hexdigest()
+missing = [row['function'] for row in rows if not row['matches']]
+result = {'status': 'FAIL' if missing else 'PASS', 'elf_sha256': digest, 'required_count': len(rows),
+          'missing': missing, 'functions': rows,
+          'scope': 'ELF dispatch-table relocations; target runtime lookup is not verified'}
+args.output.write_text(json.dumps(result, indent=2))
+print(json.dumps({k: result[k] for k in ('status', 'required_count', 'missing')}))
+raise SystemExit(bool(missing))
