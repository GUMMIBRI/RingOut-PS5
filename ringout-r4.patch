diff --git a/ModernGekko/ps5/native_startup_log.c b/ModernGekko/ps5/native_startup_log.c
new file mode 100644
index 00000000..0a93f5f8
--- /dev/null
+++ b/ModernGekko/ps5/native_startup_log.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Native entry logging cannot use libc, TLS, heap, errno, or constructors.
+// Six app-root slots, at most 64 KiB each, shared with the regular main logger.
+#include "native_startup.h"
+#include "startup_log.h"
+#include <stdint.h>
+
+extern int sceKernelOpen(const char*, int, unsigned);
+extern long sceKernelRead(int, void*, size_t);
+extern long sceKernelWrite(int, const void*, size_t);
+extern int sceKernelClose(int);
+extern int sceKernelFsync(int);
+
+enum { SlotCount = 6, ByteLimit = 64 * 1024 };
+static int descriptor = -1;
+static int attempted;
+static size_t remaining;
+/* Main and emulation threads share this early logger; avoid races without
+ * depending on libc or TLS before _init_env. */
+static int log_lock;
+static void lock_log(void)
+{
+    while (__atomic_exchange_n(&log_lock, 1, __ATOMIC_ACQUIRE))
+        __asm__ volatile("pause");
+}
+static void unlock_log(void) { __atomic_store_n(&log_lock, 0, __ATOMIC_RELEASE); }
+
+static void slot_path(char* path, unsigned slot)
+{
+    const char* prefix = RINGOUT_APP_ROOT "/startup-";
+    while (*prefix) *path++ = *prefix++;
+    *path++ = (char)('0' + slot);
+    const char* suffix = ".log";
+    while (*suffix) *path++ = *suffix++;
+    *path = 0;
+}
+
+static int generation(int fd, uint64_t* value)
+{
+    char header[32];
+    size_t count = 0;
+    // Handle short reads. An interrupted/invalid header is never a valid generation.
+    while (count < sizeof(header))
+    {
+        long n = sceKernelRead(fd, header + count, 1);
+        if (n != 1) return 0;
+        if (header[count++] == '\n') break;
+    }
+    if (count < 6 || header[0] != 'r' || header[1] != 'u' ||
+        header[2] != 'n' || header[3] != ' ' || header[count - 1] != '\n') return 0;
+    uint64_t result = 0;
+    for (size_t i = 4; i + 1 < count; ++i)
+    {
+        if (header[i] < '0' || header[i] > '9') return 0;
+        unsigned digit = (unsigned)(header[i] - '0');
+        if (result > (UINT64_MAX - digit) / 10) return 0;
+        result = result * 10 + digit;
+    }
+    *value = result;
+    return 1;
+}
+
+static int write_message(const char* message)
+{
+    if (descriptor < 0 || !message) return -1;
+    size_t length = 0;
+    while (length < remaining && message[length]) ++length;
+    while (length)
+    {
+        long n = sceKernelWrite(descriptor, message, length);
+        if (n <= 0 || (size_t)n > length) return -1;
+        remaining -= (size_t)n;
+        length -= (size_t)n;
+        message += n;
+    }
+    return sceKernelFsync(descriptor) < 0 ? -1 : 0;
+}
+
+static int write_value(const char* label, uint64_t value)
+{
+    char digits[22];
+    unsigned at = sizeof(digits) - 1;
+    digits[at] = 0;
+    digits[--at] = '\n';
+    do { digits[--at] = (char)('0' + value % 10); value /= 10; } while (value);
+    if (write_message(label) < 0) return -1;
+    return write_message(digits + at);
+}
+
+static int open_session(void)
+{
+    if (attempted) return descriptor;
+    attempted = 1;
+    char path[sizeof(RINGOUT_APP_ROOT) + 24];
+    uint64_t newest = 0;
+    uint64_t oldest = UINT64_MAX;
+    int next = -1;
+    int empty = -1;
+    for (unsigned slot = 0; slot < SlotCount; ++slot)
+    {
+        slot_path(path, slot);
+        int fd = sceKernelOpen(path, 0, 0); // SDK O_RDONLY
+        if (fd < 0)
+        {
+            // Only ENOENT establishes an unused slot. Preserve unreadable evidence.
+            if ((fd == -2 || (unsigned)fd == 0x80020002u) && empty < 0) empty = (int)slot;
+            continue;
+        }
+        uint64_t value = 0;
+        int valid = generation(fd, &value);
+        (void)sceKernelClose(fd);
+        if (!valid) continue;
+        if (value > newest) newest = value;
+        if (value < oldest) { oldest = value; next = (int)slot; }
+    }
+    if (newest == UINT64_MAX) return -1;
+    if (empty >= 0) next = empty;
+    if (next < 0) return -1;
+    slot_path(path, (unsigned)next);
+    // SDK O_WRONLY | O_CREAT | O_TRUNC. Only this project's bounded log slot is replaced.
+    descriptor = sceKernelOpen(path, 0x601, 0666);
+    if (descriptor >= 0)
+    {
+        remaining = ByteLimit;
+        if (write_value("run ", newest + 1) < 0 ||
+            write_message("RingOut " RINGOUT_BUILD_ID "\n") < 0)
+        {
+            (void)sceKernelClose(descriptor);
+            descriptor = -1;
+        }
+    }
+    return descriptor;
+}
+
+void ringout_native_stage(const char* message)
+{
+    lock_log();
+    if (open_session() >= 0) (void)write_message(message);
+    unlock_log();
+}
+
+void ringout_native_value(const char* label, unsigned long long value)
+{
+    lock_log();
+    if (open_session() >= 0) (void)write_value(label, value);
+    unlock_log();
+}
+
+void ringout_native_close(void)
+{
+    lock_log();
+    if (descriptor >= 0) (void)sceKernelClose(descriptor);
+    descriptor = -1;
+    unlock_log();
+}
+
+int ringout_log_open(RingOutStartupLog* log, const char* directory)
+{
+    // Native startup and main share one slot even before user-directory creation.
+    (void)directory;
+    log->file = NULL;
+    lock_log();
+    int fd = open_session();
+    log->remaining = remaining;
+    unlock_log();
+    return fd < 0 ? -1 : 0;
+}
+
+int ringout_log_write(RingOutStartupLog* log, const char* message)
+{
+    lock_log();
+    int result = write_message(message);
+    log->remaining = remaining;
+    unlock_log();
+    return result;
+}
+
+int ringout_log_close(RingOutStartupLog* log)
+{
+    // The CRT still records main's return and destructors; it closes the descriptor.
+    lock_log();
+    log->remaining = remaining;
+    int result = descriptor < 0 ? 0 : sceKernelFsync(descriptor);
+    unlock_log();
+    return result;
+}
diff --git a/ModernGekko/ps5/platform.cpp b/ModernGekko/ps5/platform.cpp
new file mode 100644
index 00000000..cf558b15
--- /dev/null
+++ b/ModernGekko/ps5/platform.cpp
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <chrono>
+#include <atomic>
+#include <memory>
+#include <thread>
+#include "menu_restart.h"
+
+#include "Core/Core.h"
+#include "Core/System.h"
+#include "DolphinNoGUI/Platform.h"
+#include "VideoCommon/RecompMenu.h"
+
+namespace
+{
+enum class ExitRequest
+{
+  None,
+  Quit,
+  Reset,
+};
+
+bool s_restart_requested = false;
+
+class PlatformPS5 final : public Platform
+{
+public:
+  PlatformPS5() { m_window_fullscreen = true; }
+
+  void MainLoop() override
+  {
+    auto& system = Core::System::GetInstance();
+    // QuitOnceResumed may invoke a copied callback on a detached worker after
+    // this loop exits. Keep its signal alive independently of the platform.
+    const auto menu_exit = std::make_shared<std::atomic<ExitRequest>>(ExitRequest::None);
+    const auto request = [menu_exit](ExitRequest action) {
+      ExitRequest expected = ExitRequest::None;
+      menu_exit->compare_exchange_strong(expected, action);
+    };
+    RecompMenu::SetQuitCallback([request] { request(ExitRequest::Quit); });
+    RecompMenu::SetResetCallback([request] { request(ExitRequest::Reset); });
+    bool handling_exit = false;
+    while (IsRunning())
+    {
+      const auto action = menu_exit->load();
+      if (!handling_exit && action != ExitRequest::None)
+      {
+        handling_exit = true;
+        s_restart_requested = action == ExitRequest::Reset;
+        if (s_restart_requested)
+          Stop();
+        else
+          RequestShutdown();
+      }
+      UpdateRunningFlag();
+      if (!IsRunning())
+        break;
+      Core::HostDispatchJobs(system);
+      RecompMenu::HostTick();
+      if (RecompMenu::IsOpen())
+        RecompMenu::PumpFrame();
+      std::this_thread::sleep_for(std::chrono::milliseconds(8));
+    }
+    RecompMenu::SetQuitCallback({});
+    RecompMenu::SetResetCallback({});
+  }
+
+  WindowSystemInfo GetWindowSystemInfo() const override
+  {
+    return {WindowSystemType::Display, nullptr, nullptr, nullptr};
+  }
+};
+}  // namespace
+
+bool ringout_take_menu_restart()
+{
+  const bool requested = s_restart_requested;
+  s_restart_requested = false;
+  return requested;
+}
+
+std::unique_ptr<Platform> Platform::CreatePS5Platform()
+{
+  return std::make_unique<PlatformPS5>();
+}
diff --git a/ModernGekko/ps5/posix_filesystem.c b/ModernGekko/ps5/posix_filesystem.c
new file mode 100644
index 00000000..64291193
--- /dev/null
+++ b/ModernGekko/ps5/posix_filesystem.c
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * PS5 native process/filesystem fallbacks. Unsupported operations fail explicitly.
+ * pathconf delegates to the kernel's descriptor variant; opening the path may
+ * require read permission, so this is narrower than POSIX pathconf semantics. */
+#include <errno.h>
+#include <fcntl.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <net/if_dl.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+extern long _fpathconf(int, int);
+extern int _fcntl(int, int, ...);
+
+/* The SDK's if_nametoindex first executes a raw socket syscall. Enumerate
+ * the system-provided interface list instead, preserving named IPv6 zones. */
+unsigned int if_nametoindex(const char *name)
+{
+    struct ifaddrs *addresses = NULL;
+    if (!name) { errno = EINVAL; return 0; }
+    if (getifaddrs(&addresses) != 0) return 0;
+    unsigned int index = 0;
+    for (const struct ifaddrs *p = addresses; p; p = p->ifa_next)
+        if (p->ifa_name && p->ifa_addr && p->ifa_addr->sa_family == AF_LINK &&
+            strcmp(p->ifa_name, name) == 0)
+        {
+            index = LLINDEX((const struct sockaddr_dl *)p->ifa_addr);
+            break;
+        }
+    freeifaddrs(addresses);
+    if (!index) errno = ENXIO;
+    return index;
+}
+
+/* Native titles have no terminal. This follows PSXS5's console_curl.c and
+ * PS5_PayloadSDK's libc/isatty.c: the WebKit POSIX export can be a null import
+ * in a native title. This is a platform stand-in, not a descriptor validator. */
+int ps5_isatty(int descriptor)
+{
+    (void)descriptor;
+    errno = ENOTTY;
+    return 0;
+}
+
+int ps5_dup(int fd)
+{
+    return _fcntl(fd, F_DUPFD, 0);
+}
+
+long ps5_pathconf(const char *path, int name)
+{
+    if (!path) { errno = EFAULT; return -1; }
+    int fd = open(path, O_RDONLY | O_NONBLOCK);
+    if (fd < 0) return -1;
+    long result = _fpathconf(fd, name);
+    int saved_errno = errno;
+    (void)close(fd);
+    errno = saved_errno;
+    return result;
+}
+
+pid_t ps5_fork(void) { errno = ENOSYS; return (pid_t)-1; }
+int ps5_link(const char *oldpath, const char *newpath)
+{ (void)oldpath; (void)newpath; errno = ENOSYS; return -1; }
+int ps5_symlink(const char *target, const char *linkpath)
+{ (void)target; (void)linkpath; errno = ENOSYS; return -1; }
+ssize_t ps5_readlink(const char *path, char *buf, size_t size)
+{ (void)path; (void)buf; (void)size; errno = ENOSYS; return -1; }
diff --git a/ModernGekko/ps5/prepare-native-package.py b/ModernGekko/ps5/prepare-native-package.py
new file mode 100644
index 00000000..10c2baa5
--- /dev/null
+++ b/ModernGekko/ps5/prepare-native-package.py
@@ -0,0 +1,87 @@
+import argparse, hashlib, importlib.util, json, os, pathlib, subprocess, shutil, sys
+from guest_package import guest_files
+parser=argparse.ArgumentParser()
+parser.add_argument('stage')
+parser.add_argument('--guest-dir')
+parser.add_argument('--asset-source')
+args=parser.parse_args()
+root = pathlib.Path(args.stage).absolute()
+workspace = pathlib.Path(__file__).resolve().parents[3]
+app = root / 'app/PPSA99875'
+app.mkdir(parents=True, exist_ok=True)
+def sha(p):
+    with pathlib.Path(p).open('rb') as f: return hashlib.file_digest(f, 'sha256').hexdigest()
+def art(p): return {'path': str(p), 'sha256': sha(p)}
+baseline = json.loads((workspace / 'aot-work/FIRST-BOOT-R1-COMPLETE-MANIFEST.json').read_text())
+if args.asset_source:
+    asset_source=pathlib.Path(args.asset_source).resolve()
+    if asset_source.name != 'PPSA99875' or asset_source.parent.name != 'app':
+        raise ValueError('asset source must be a qualified PPSA99875 app folder')
+    check=json.loads((asset_source.parents[1]/'PACKAGE-CHECK.json').read_text())
+    if check.get('status') != 'STATIC_PACKAGE_PASS':
+        raise ValueError('asset source has not passed package qualification')
+inventory=[]
+for item in baseline['files']:
+    relative=pathlib.PurePosixPath(item['path'])
+    assert not relative.is_absolute() and '..' not in relative.parts
+    if item['path'] in ['eboot.bin', 'sce_sys/param.json', 'README.txt']: continue
+    destination=app / relative
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    # An explicitly selected, already-qualified app can provide immutable
+    # baseline assets without another full copy. Never edit either linked file.
+    source=(pathlib.Path(args.asset_source).resolve()/relative) if args.asset_source else pathlib.Path(item['source'])
+    if source.is_symlink() or not source.is_file() or sha(source)!=item['sha256']:
+        raise ValueError('baseline asset mismatch: '+item['path'])
+    if not destination.exists():
+        if args.asset_source: os.link(source,destination)
+        else: shutil.copyfile(source,destination)
+    assert sha(destination)==item['sha256'], item['path']
+    inventory.append({**art(destination), 'bytes':destination.stat().st_size})
+eboot=app/'eboot.bin'
+if not eboot.exists(): os.link(root/'eboot.bin',eboot)
+param=app/'sce_sys/param.json'
+original=workspace/'aot-work/first-boot-r1/sce_sys/param.json'
+branding=pathlib.Path('C:/Users/gumbreezy/.codex/skills/ps5-build-package/scripts/brand_channel.py')
+if not param.exists(): subprocess.run(['python', str(branding), str(original),str(param),'--channel','dev'],check=True)
+(app/'user').mkdir(exist_ok=True)
+readme=app/'README.txt'
+readme.write_text('RingOut (dev), development, private local test candidate.\n'
+    'Contains owner-supplied GameCube disc data and a private runtime companion. Do not redistribute.\n'
+    'App folder contract: /mnt/usb0/homebrew/PPSA99875. Preserve existing user saves/settings.\n'
+    'Startup logs: startup-0.log through startup-5.log beside eboot.bin, bounded to 64 KiB each.\n'
+    'Absolute launch executable paths and absolute game/user arguments are supported; early logs use USB0.\n'
+    'Expected test: normal launcher entry, observe startup then real game title/select. No autonomous launch.\n'
+    'Boot, shell exit and relaunch unverified.\n'
+    + ('Spawn and Heihachi are included for testing; selection and gameplay are unverified.\n'
+       if args.guest_dir else 'Xbox/PS2 guest integration remains separate.\n') +
+    'POSIX subprocess/symlink/hardlink operations report ENOSYS. pathconf uses kernel descriptor query.\n'
+    'Private local assets; do not redistribute.\n')
+inventory.extend([{**art(p), 'bytes':p.stat().st_size} for p in [eboot,param,readme]])
+if args.guest_dir:
+    guest=pathlib.Path(args.guest_dir).resolve()
+    sources=guest_files(guest,app/'game/files/root.olk')
+    target=app/'game/guests'; target.mkdir(parents=True,exist_ok=False)
+    for src in sources:
+        dst=target/src.name
+        try: os.link(src,dst)
+        except OSError: shutil.copyfile(src,dst)
+        if sha(src)!=sha(dst):raise ValueError('guest file changed during packaging: '+src.name)
+        inventory.append({**art(dst),'bytes':dst.stat().st_size})
+    inventory=[{**art(p),'bytes':p.stat().st_size} if p==readme else item
+               for item in inventory for p in [pathlib.Path(item['path'])]]
+(root/'CONTENT.json').write_text(json.dumps({'app_root':str(app),'all_hashes_verified':True,
+    'private':True,'copied_immutable_assets':not bool(args.asset_source),
+    'asset_source':str(pathlib.Path(args.asset_source).resolve()) if args.asset_source else None,
+    'guest_source':str(guest) if args.guest_dir else None,
+    'files':inventory},indent=2))
+print('assembled',len(inventory),'files')
+finalizer=pathlib.Path('C:/SC2/tools/ps5_finalize_payload.py')
+spec=importlib.util.spec_from_file_location('finalizer',finalizer)
+module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+original_elf=module.preflight(root/'ringout-native.elf',pathlib.Path('C:/.pe/ps5-native/gpu-platform-20261030/deps/llvm/bin/llvm-nm.exe'))
+retained=module.retained(original_elf,root/'eboot.elf')
+(root/'layout.json').write_text(json.dumps({'script':art(finalizer),'input_elf':art(root/'ringout-native.elf'),
+    'elf':art(root/'eboot.elf'),'preflight_passed':True,'retained_passed':True,'retained_sections':retained},indent=2))
+print('layout/retention passed',len(retained),'sections')
+
+
