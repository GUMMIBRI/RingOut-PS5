+    if (!(display.supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR))
+      continue;
+
+    std::vector<VkDisplayModePropertiesKHR> modes;
+    if (!Enumerate(&modes, [&](uint32_t* count, VkDisplayModePropertiesKHR* values) {
+          return vkGetDisplayModePropertiesKHR(physical_device, display.display, count, values);
+        }))
+    {
+      continue;
+    }
+
+    for (uint32_t index = 0; index < planes.size(); ++index)
+    {
+      const auto& plane = planes[index];
+      if (plane.currentDisplay && plane.currentDisplay != display.display)
+        continue;
+
+      std::vector<VkDisplayKHR> supported;
+      if (!Enumerate(&supported, [&](uint32_t* count, VkDisplayKHR* values) {
+            return vkGetDisplayPlaneSupportedDisplaysKHR(physical_device, index, count, values);
+          }) ||
+          std::find(supported.begin(), supported.end(), display.display) == supported.end())
+      {
+        continue;
+      }
+
+      for (const auto& mode : modes)
