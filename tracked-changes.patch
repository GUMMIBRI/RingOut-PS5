+    ERROR_LOG_FMT(VIDEO, "Vulkan: VK_KHR_display entry points missing");
+    return VK_NULL_HANDLE;
+  }
+
+  auto Enumerate = [](auto* output, auto&& query) {
+    uint32_t count = 0;
+    if (query(&count, nullptr) != VK_SUCCESS || count == 0)
+      return false;
+    output->resize(count);
+    if (query(&count, output->data()) != VK_SUCCESS)
+      return false;
+    output->resize(count);
+    return count != 0;
+  };
+
+  std::vector<VkDisplayPropertiesKHR> displays;
+  std::vector<VkDisplayPlanePropertiesKHR> planes;
+  if (!Enumerate(&displays, [&](uint32_t* count, VkDisplayPropertiesKHR* values) {
+        return vkGetPhysicalDeviceDisplayPropertiesKHR(physical_device, count, values);
+      }) ||
+      !Enumerate(&planes, [&](uint32_t* count, VkDisplayPlanePropertiesKHR* values) {
+        return vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physical_device, count, values);
+      }))
+  {
+    ERROR_LOG_FMT(VIDEO, "Vulkan: No display or display plane available");
+    return VK_NULL_HANDLE;
+  }
+
+  for (const auto& display : displays)
