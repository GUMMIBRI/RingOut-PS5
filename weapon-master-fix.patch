+# The game carves 0xA0000 bytes for this common menu and mission pack before the
+# next arena. Its DVD loader rounds the read to a 0x800-byte sector.
+_COMMON_PACK_CAPACITY = 0xA0000
+_DVD_SECTOR_SIZE = 0x800
+
+
+def guest_face_bank(gc_entry, guest_faces):
+    """Return the shared face pack and the portrait index for every guest costume."""
+    if any(not faces for faces in guest_faces):
+        raise ValueError('every guest needs at least one portrait')
+
+    def build(primary_only):
+        items, indices = [], []
+        for faces in guest_faces:
+            index = len(items)
+            if primary_only:
+                items.append(faces[0])
+                indices.append([index] * len(faces))
+            else:
+                items.extend(faces)
+                indices.append(range(index, len(items)))
+        # The stock common pack aligns its inner parts to 0x80. The outer OLK
+        # writer supplies the separate DVD sector alignment.
+        entry, first = append_textures(gc_entry, FACE_PART, items, part_alignment=0x80)
+        return entry, [[first + index for index in row] for row in indices]
+
+    def fits(entry):
+        rounded = len(entry) + (-len(entry) % _DVD_SECTOR_SIZE)
+        return rounded <= _COMMON_PACK_CAPACITY - _DVD_SECTOR_SIZE
+
+    entry, indices = build(primary_only=False)
+    if not fits(entry):
+        entry, indices = build(primary_only=True)
+        if not fits(entry):
+            raise ValueError('guest portraits exceed the common game-data buffer')
+    return entry, indices
+
+
