@@ -13,6 +13,8 @@ namespace
 {
 constexpr std::uint64_t kHeaderSize = 2048;
 constexpr std::uint32_t kMagic = 0x6b6e6c6f;  // "olnk"
+constexpr std::uint32_t kIndexHeaderSize = 32;
+constexpr std::uint32_t kIndexRecordSize = 16;
 
 std::uint32_t ReadLE32(const unsigned char* p)
 {
@@ -53,6 +55,44 @@ std::vector<std::pair<std::uint32_t, std::uint32_t>> ReadIndex(std::ifstream& fi
 }
 }  // namespace
 
+Slot FindGroupEntry(const std::string& root_olk, std::uint64_t file_size,
+                    std::uint32_t group, std::uint32_t entry)
+{
+  std::ifstream file(root_olk, std::ios::binary);
+  if (!file)
+    return {};
+
+  const auto read_entry = [&file](std::uint64_t start, std::uint64_t size,
+                                  std::uint32_t index) -> Slot {
+    unsigned char header[kIndexHeaderSize];
+    if (size < sizeof(header))
+      return {};
+    file.seekg(static_cast<std::streamoff>(start));
+    file.read(reinterpret_cast<char*>(header), sizeof(header));
+    if (!file || ReadLE32(header + 4) != kMagic || index >= ReadLE32(header))
+      return {};
+
+    const std::uint32_t data = ReadLE32(header + 16);
+    const std::uint64_t record = sizeof(header) + std::uint64_t(index) * kIndexRecordSize;
+    if (data > size || record + kIndexRecordSize > data)
+      return {};
+
+    unsigned char fields[kIndexRecordSize];
+    file.seekg(static_cast<std::streamoff>(start + record));
+    file.read(reinterpret_cast<char*>(fields), sizeof(fields));
+    if (!file)
+      return {};
+    const std::uint64_t offset = std::uint64_t(data) + ReadLE32(fields);
+    const std::uint32_t length = ReadLE32(fields + 4);
+    if (offset > size || length > size - offset)
+      return {};
+    return {true, start + offset, length};
+  };
+
+  const Slot container = read_entry(0, file_size, group);
+  return container.found ? read_entry(container.offset, container.size, entry) : Slot{};
+}
