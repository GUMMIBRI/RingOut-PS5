[
  "-S",
  "$SOURCE\\ModernGekko",
  "-B",
  "$HOST_BUILD",
  "-G",
  "Ninja",
  "-DCMAKE_MAKE_PROGRAM=$NINJA",
  "-DCMAKE_SYSTEM_NAME=FreeBSD",
  "-DCMAKE_SYSTEM_PROCESSOR=x86_64",
  "-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY",
  "-DCMAKE_C_COMPILER=$PLATFORM/deps/llvm/bin/clang.exe",
  "-DCMAKE_CXX_COMPILER=$PLATFORM/deps/llvm/bin/clang++.exe",
  "-DCMAKE_C_COMPILER_TARGET=x86_64-unknown-freebsd12.0",
  "-DCMAKE_CXX_COMPILER_TARGET=x86_64-unknown-freebsd12.0",
  "-DCMAKE_C_FLAGS=-isystem $PLATFORM/deps/ps5-payload-sdk/target/include -isystem $PLATFORM/deps/ps5-payload-sdk/target/include_common -fPIC -femulated-tls -fno-stack-protector",
  "-DCMAKE_CXX_FLAGS=-isystem $PLATFORM/deps/ps5-payload-sdk/target/include/c++/v1 -isystem $PLATFORM/deps/ps5-payload-sdk/target/include -isystem $PLATFORM/deps/ps5-payload-sdk/target/include_common -fPIC -femulated-tls -fno-stack-protector -fexperimental-library",
  "-DCMAKE_AR=$PLATFORM/deps/llvm/bin/llvm-ar.exe",
  "-DCMAKE_RANLIB=$PLATFORM/deps/llvm/bin/llvm-ranlib.exe",
  "-DBUILD_TESTING=OFF",
  "-DMODERNGEKKO_PS5=ON",
  "-DRINGOUT_PS5_RADV_LIBRARIES=$PLATFORM/build-vulkan/radv-game.a",
  "-DENABLE_X11=OFF",
  "-DENABLE_SDL=ON",
  "-DUSE_SYSTEM_SDL3=ON",
  "-DSDL3_DIR=$PLATFORM/install-sdl/lib/cmake/SDL3",
  "-DCMAKE_EXE_LINKER_FLAGS=-fuse-ld=lld -nostdlib -Wl,-e,main -Wl,--no-dynamic-linker",
  "-DCMAKE_C_STANDARD_LIBRARIES=-L$PLATFORM/deps/ps5-payload-sdk/target/lib -lc -lSceLibcInternal -lSceNet -lkernel",
  "-DCMAKE_CXX_STANDARD_LIBRARIES=-L$PLATFORM/deps/ps5-payload-sdk/target/lib -lc++experimental -lc++ -lc++abi -lunwind -lpthread -lSceLibcInternal -lSceNet -lkernel -lc",
  "-U",
  "HAVE_SEND",
  "-U",
  "HAVE_RECV",
  "-U",
  "HAVE_SOCKET",
  "-U",
  "HAVE_POLL",
  "-U",
  "HAVE_SELECT",
  "-U",
  "HAVE_POLL_FINE",
  "-U",
  "HAVE_FCNTL",
  "-U",
  "HAVE_FCNTL_O_NONBLOCK",
  "-DCMAKE_REQUIRED_LIBRARIES=$PLATFORM/deps/ps5-payload-sdk/target/lib/libc.a;$PLATFORM/deps/ps5-payload-sdk/target/lib/libSceLibcInternal.so;$PLATFORM/deps/ps5-payload-sdk/target/lib/libSceNet.so;$PLATFORM/deps/ps5-payload-sdk/target/lib/libkernel.so",
  "-DCMAKE_BUILD_TYPE:STRING=Release",
  "-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=",
  "-DENABLE_CLI_TOOL:BOOL=OFF",
  "-DENABLE_CUBEB:BOOL=OFF",
  "-DENABLE_QT:BOOL=OFF",
  "-DENABLE_TESTS:BOOL=OFF",
  "-DENABLE_VULKAN:BOOL=ON",
  "-DENABLE_WAYLAND:BOOL=OFF",
  "-DRINGOUT_PS5_MODULE:FILEPATH=",
  "-DRINGOUT_PS5_EXTERNAL_MODULE:BOOL=ON",
  "-DMODERNGEKKO_ENABLE_DYNAMIC_MODULES:BOOL=ON"
]